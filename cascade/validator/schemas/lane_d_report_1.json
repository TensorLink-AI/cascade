{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TensorLink-AI/cascade/cascade/validator/schemas/lane_d_report_1.json",
  "title": "lane-d-report/1",
  "description": "The signed lane D settlement report (LANE_D_PLAN §1.5, §14.3). Every object is closed; the optional top-level `extensions` map is open and never consensus. `rows_sha256` is sha256 over json.dumps(rows, sort_keys=True, separators=(',', ':'), allow_nan=False). Numbers are finite.",
  "type": "object",
  "required": ["schema", "boundary", "signer", "signature", "scoring_method", "params", "seed",
               "pool", "house", "king_before", "king_after", "crowned", "prior_kings", "entries",
               "judged", "skipped", "cohorts", "windows", "verdicts", "rows", "rows_sha256", "pay"],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "lane-d-report/1"},
    "boundary": {"type": "integer", "minimum": 0},
    "signer": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "minLength": 1, "pattern": "^[0-9a-f]{128}$",
                  "description": "sr25519 (schnorrkel, substrate signing context) signature of `signer` over the canonical body: the report minus `signature`, json.dumps(sort_keys=True, separators=(',', ':'), ensure_ascii=True, allow_nan=False) as UTF-8, no domain prefix. The 64 bytes as lower-case hex, no 0x, no whitespace. The scheme is versioned by `schema`."},
    "scoring_method": {"type": "string", "const": "quantile_head"},
    "params": {"$ref": "#/$defs/params"},
    "seed": {"type": "string", "minLength": 1},
    "pool": {"$ref": "#/$defs/pool"},
    "house": {"$ref": "#/$defs/king"},
    "king_before": {"$ref": "#/$defs/king"},
    "king_after": {"$ref": "#/$defs/king"},
    "crowned": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "prior_kings": {"type": "array", "items": {"$ref": "#/$defs/king"}},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "judged": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "skipped": {"type": "array", "items": {"$ref": "#/$defs/skip"}},
    "cohorts": {"type": "array", "items": {"$ref": "#/$defs/cohort"}},
    "windows": {"type": "array", "items": {"$ref": "#/$defs/window"}},
    "verdicts": {"type": "array", "items": {"$ref": "#/$defs/verdict"}},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "rows_sha256": {"$ref": "#/$defs/digest"},
    "pay": {"$ref": "#/$defs/pay"},
    "extensions": {
      "type": "object",
      "description": "Open and never consensus: satellites must not read verdict, eligibility or weight inputs from it."
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "integer", "minimum": 0},
    "entry_status": {"type": "string",
                     "enum": ["pending", "hold", "confirm_pending", "crowned", "lost", "closed"]},
    "skip_reason": {"type": "string",
                    "enum": ["pending_floor", "coldkey_cap_settlement", "coldkey_unresolved",
                             "coldkey_changed", "king_unscored", "bench_hold", "deregistered",
                             "ready_expired", "reveal_delay_exceeded", "duplicate_digest",
                             "hotkey_has_open_entry", "context_not_armed", "checkpoint_fault",
                             "mirror_lag_exceeded"]},
    "entry_reason": {"type": "string",
                     "enum": ["pending_floor", "coldkey_cap_settlement", "coldkey_unresolved",
                              "coldkey_changed", "king_unscored", "bench_hold", "deregistered",
                              "ready_expired", "reveal_delay_exceeded", "duplicate_digest",
                              "hotkey_has_open_entry", "context_not_armed", "checkpoint_fault",
                              "mirror_lag_exceeded", "confirm_pending", "lost_duel",
                              "lost_confirmation", "lowfreq_regression", "crowned"]},
    "burn_reason": {"type": "string", "enum": ["house_king", "deregistered"]},
    "window_refusal_reason": {"type": "string",
                              "enum": ["missing_clock", "forecast_product", "over_lag",
                                       "before_margin", "publish_ahead", "late_mirror",
                                       "absent_from_s0", "backfill"]},
    "confirmation_stage": {"type": "string", "enum": ["first", "confirm"]},
    "confirm_rule": {"type": "string", "enum": ["restart", "original"]},
    "lowfreq_result": {"type": "string", "enum": ["pass", "fail", "no_windows", "not_candidate"]},
    "verdict_outcome": {"type": "string",
                        "enum": ["lost", "confirm_pending", "confirmed", "crowned"]},
    "params": {
      "type": "object",
      "description": "§14.3 item 2: every [lane_d] value a satellite needs, as parsed.",
      "required": ["share", "takes_from", "remainder", "horizon", "horizons", "contexts",
                   "forward_margin_hours", "max_mirror_lag_hours", "min_windows", "min_clusters",
                   "d_margin", "alpha", "bootstrap_B", "king_decay", "reward_prior_kings",
                   "confirm_on_king_change", "max_entries_per_settlement",
                   "max_judged_per_coldkey_per_settlement", "scoring_levels", "gate_suites",
                   "tau_public", "lowfreq_freqs"],
      "additionalProperties": false,
      "properties": {
        "share": {"type": "number", "minimum": 0},
        "takes_from": {"type": "string", "minLength": 1},
        "remainder": {"type": "string", "minLength": 1},
        "horizon": {"type": "integer", "minimum": 1},
        "horizons": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "contexts": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "forward_margin_hours": {"type": "number", "minimum": 0},
        "max_mirror_lag_hours": {"type": "number", "minimum": 0},
        "min_windows": {"type": "integer", "minimum": 0},
        "min_clusters": {"type": "integer", "minimum": 0},
        "d_margin": {"type": "number"},
        "alpha": {"type": "number", "minimum": 0},
        "bootstrap_B": {"type": "integer", "minimum": 1},
        "king_decay": {"type": "number", "minimum": 0},
        "reward_prior_kings": {"type": "integer", "minimum": 0},
        "confirm_on_king_change": {"$ref": "#/$defs/confirm_rule"},
        "max_entries_per_settlement": {"type": "integer", "minimum": 0},
        "max_judged_per_coldkey_per_settlement": {"type": "integer", "minimum": 0},
        "scoring_levels": {"type": "array", "items": {"type": "number"}},
        "gate_suites": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "tau_public": {"type": "number", "minimum": 0},
        "lowfreq_freqs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "pool": {
      "type": "object",
      "required": ["snapshot", "sha256", "horizon", "first_seen_roots"],
      "additionalProperties": false,
      "properties": {
        "snapshot": {"type": "string"},
        "sha256": {"$ref": "#/$defs/digest"},
        "horizon": {"type": "integer", "minimum": 1},
        "first_seen_roots": {"type": "array", "items": {"$ref": "#/$defs/digest"},
                             "description": "B12 daily first-seen Merkle roots the snapshot relies on, sorted."}
      }
    },
    "king": {
      "type": "object",
      "required": ["digest", "hotkey", "house", "reveal_ts"],
      "additionalProperties": false,
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "hotkey": {"type": ["string", "null"]},
        "house": {"type": "boolean"},
        "reveal_ts": {"$ref": "#/$defs/timestamp"}
      }
    },
    "entry": {
      "type": "object",
      "required": ["digest", "hotkey", "coldkey", "context", "ready_block", "reveal_block",
                   "reveal_ts", "status", "reason"],
      "additionalProperties": false,
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "hotkey": {"type": "string", "minLength": 1},
        "coldkey": {"type": ["string", "null"], "minLength": 1,
                    "description": "A8: the coldkey recorded at ready; null when unresolved."},
        "context": {"type": "integer", "minimum": 1},
        "ready_block": {"type": "integer", "minimum": 0},
        "reveal_block": {"type": "integer", "minimum": 0},
        "reveal_ts": {"$ref": "#/$defs/timestamp"},
        "status": {"$ref": "#/$defs/entry_status"},
        "reason": {"$ref": "#/$defs/entry_reason"}
      }
    },
    "skip": {
      "type": "object",
      "required": ["digest", "reason"],
      "additionalProperties": false,
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "reason": {"$ref": "#/$defs/skip_reason"}
      }
    },
    "cohort": {
      "type": "object",
      "required": ["index", "king_digest", "king_reveal_ts", "stage", "members", "t_max",
                   "window_ids", "set_sha256", "first_seen_roots", "refused"],
      "additionalProperties": false,
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "king_digest": {"$ref": "#/$defs/digest"},
        "king_reveal_ts": {"$ref": "#/$defs/timestamp"},
        "stage": {"$ref": "#/$defs/confirmation_stage"},
        "members": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
        "t_max": {"$ref": "#/$defs/timestamp"},
        "window_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "set_sha256": {"$ref": "#/$defs/digest"},
        "first_seen_roots": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
        "refused": {
          "type": "object",
          "description": "{reason: count} of pool windows refused by the §1.3 eligibility rule.",
          "propertyNames": {"$ref": "#/$defs/window_refusal_reason"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    },
    "window": {
      "type": "object",
      "required": ["window_id", "source", "feed", "min_target_ts", "min_first_seen_ts",
                   "mirror_lag_hours"],
      "additionalProperties": false,
      "properties": {
        "window_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "feed": {"type": "string", "minLength": 1},
        "min_target_ts": {"$ref": "#/$defs/timestamp"},
        "min_first_seen_ts": {"$ref": "#/$defs/timestamp"},
        "mirror_lag_hours": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "confirmation": {
      "type": "object",
      "required": ["stage", "rule", "first_set_sha256", "first_king_digest"],
      "additionalProperties": false,
      "properties": {
        "stage": {"$ref": "#/$defs/confirmation_stage"},
        "rule": {"$ref": "#/$defs/confirm_rule"},
        "first_set_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "first_king_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "lowfreq": {
      "type": "object",
      "required": ["result", "freqs", "n_windows", "tau_public"],
      "additionalProperties": false,
      "properties": {
        "result": {"$ref": "#/$defs/lowfreq_result"},
        "freqs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "n_windows": {"type": "integer", "minimum": 0},
        "tau_public": {"type": "number", "minimum": 0}
      }
    },
    "verdict": {
      "type": "object",
      "required": ["digest", "king_digest", "stage", "cohort", "lcb", "gain", "cleared",
                   "outcome", "confirmation", "lowfreq"],
      "additionalProperties": false,
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "king_digest": {"$ref": "#/$defs/digest"},
        "stage": {"$ref": "#/$defs/confirmation_stage"},
        "cohort": {"type": "integer", "minimum": 0},
        "lcb": {"type": "number"},
        "gain": {"type": "number"},
        "cleared": {"type": "boolean"},
        "outcome": {"$ref": "#/$defs/verdict_outcome"},
        "confirmation": {"$ref": "#/$defs/confirmation"},
        "lowfreq": {"$ref": "#/$defs/lowfreq"}
      }
    },
    "row": {
      "type": "object",
      "required": ["window_id", "digest", "cohort", "crps", "mase"],
      "additionalProperties": false,
      "properties": {
        "window_id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "cohort": {"type": "integer", "minimum": 0},
        "crps": {"type": "number"},
        "mase": {"type": "number"}
      }
    },
    "court_slot": {
      "type": "object",
      "description": "D21/B8: burn_reason is null iff uid is an integer.",
      "required": ["digest", "hotkey", "uid", "burn_reason"],
      "additionalProperties": false,
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "hotkey": {"type": ["string", "null"]},
        "uid": {"type": ["integer", "null"], "minimum": 0},
        "burn_reason": {"enum": ["house_king", "deregistered", null]}
      },
      "if": {"properties": {"uid": {"type": "integer"}}},
      "then": {"properties": {"burn_reason": {"type": "null"}}},
      "else": {"properties": {"burn_reason": {"$ref": "#/$defs/burn_reason"}}}
    },
    "pay": {
      "type": "object",
      "required": ["share", "court"],
      "additionalProperties": false,
      "properties": {
        "share": {"type": "number", "minimum": 0},
        "court": {"type": "array", "items": {"$ref": "#/$defs/court_slot"}}
      }
    }
  }
}
