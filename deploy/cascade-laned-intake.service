# cascade-laned-intake: the lane D intake (POST /v1/lane-d/submit|ready,
# GET /v1/lane-d/queue), loopback only behind Caddy
# (deploy/caddy/lane-d-intake.caddy). Install it for boot and recovery; the
# S5 restart (deploy/laned/restart_intake_laned.sh) keeps launching the
# intake in a systemd scope, so stop this unit before a scripted restart and
# never run both.
#
# Code-path guard (PR #431): PYTHONPATH declares the release, the module form
# runs with python -P, and a shadowed release exits 78, which stays down.
# Vault credentials (HIPPIUS_S3_ACCESS_KEY / HIPPIUS_S3_SECRET_KEY) come only
# from the mode-600 EnvironmentFile; the intake signs nothing.

[Unit]
Description=cascade lane D intake (cascade-laned-intake)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/
Environment=PYTHONPATH=/root/cascade
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/cascade-laned-intake.env
ExecStart=/root/cascade/.venv/bin/python -P -m cascade.lane_d --host 127.0.0.1 --port 8791 --state-dir /root/cascade-state/lane-d-intake --chain-toml /root/cascade/chain.toml
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
MemoryMax=512M
OOMScoreAdjust=-500
NoNewPrivileges=true
StandardOutput=append:/root/cascade/intake-laned.log
StandardError=append:/root/cascade/intake-laned.log

[Install]
WantedBy=multi-user.target
