# Publish each settlement's judged eval set once it is RETIRED (owner
# 2026-11-28: "publish the eval dataset for lane D after it occurs, and lane C:
# not 30 days") and keep the signed lane B / lane C manifests and lane D
# reports public-read: cascade.pool.settlement_evals run.
#
# - lane D: lane-d/evals/<boundary>/{windows.npz,README.md,manifest.json} +
#   lane-d/evals/index.json. A settlement's windows are retired when every
#   judged target point was first seen (and lies) at or before
#   min(now, state mtime, open reveals) - 6 h - [lane_d] embargo_hours (>= 48 h):
#   at most ~54 h after the settlement. windows.npz is BUILT ON THE LANE D EVAL
#   HOST (cascade.eval.settlement_eval_build, nice/ionice, its own pinned pool
#   copies, W-OFFBOX) and streamed back to --stage; the box loads no pool.
# - MarketCast: marketcast/evals/<round>/{windows.json,README.md,manifest.json}
#   + marketcast/evals/index.json, once the round's snapshot ends 30 d (+72 h
#   slack) before the earliest open dispatch (the embargo draw re-uses bars
#   for embargo_eval_days: ~33 days by design).
# - ACL: public-read on lane_b/round-*, lane_c/round-*, lane-d/reports/*
#   (per-object; --stage/acl_done.txt keeps each run to the new keys).
#
# Idempotent (a set whose manifest.json exists is skipped; the indexes are only
# rewritten when they change). No torch, no chain, no keys. Credentials:
# HIPPIUS_S3_ACCESS_KEY / HIPPIUS_S3_SECRET_KEY (write on cascade-manifests)
# from the EnvironmentFile, by name only; never printed. The eval host is
# reached with the validator's lane D inputs file (eval_hosts / eval_host_name
# / eval_pool_root) and needs this release synced (its workdir).
# Ships in --dry-run (prints the plan and every file it would upload, uploads
# nothing; lane D still builds on the host to verify). Going live is a drop-in
# repeating ExecStart without --dry-run.
# PYTHONPATH / the venv: point both at the live release (as the pin-sync job).
[Unit]
Description=cascade settlement eval-set publish + public-read ACLs (idempotent; dry-run template)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/
Environment=PYTHONPATH=/root/cascade
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/cascade-laned-intake.env
ExecStart=/root/cascade/.venv/bin/python -P -m cascade.pool.settlement_evals run --chain-toml /root/cascade/chain.validator.toml --stage /root/cascade-state/settlement-evals-stage --laned-state /root/cascade/lane_d_state.json --laned-inputs /root/cascade-state/lane-d/lane_d_inputs.toml --lane-c-state /root/cascade/validator_state.db.lane_c.json --acl --dry-run
Nice=19
IOSchedulingClass=idle
MemoryMax=1G
TimeoutStartSec=2h
NoNewPrivileges=true
StandardOutput=append:/root/cascade/settlement-evals.log
StandardError=append:/root/cascade/settlement-evals.log
