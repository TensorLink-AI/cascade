# TEMPLATE: daily at 04:30 UTC (the TTL is counted in eras, the archive window
# in days; daily is ample). The sweep restarts no service, so the restart quiet
# windows do not apply to it.

[Unit]
Description=cascade lane D vault TTL sweep, daily

[Timer]
OnCalendar=*-*-* 04:30:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
