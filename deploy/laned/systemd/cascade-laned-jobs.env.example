# /etc/cascade-laned-jobs.env (mode 600, owner-filled) for the lane D recurring
# job TEMPLATES in deploy/laned/systemd/. Names and paths only: no password, no
# key material, no credential belongs here. The validator hotkey is opened by
# name from the wallet directory by the house-pointer job; the coldkey is never
# read. Copy to /etc/cascade-laned-jobs.env and fill on the host that runs the
# job (the box or testnet-ctl; the readiness measure runs on the builder VM).

# The release and venv are literal in each unit (PYTHONPATH=/root/cascade,
# /root/cascade/.venv/bin/python -P: the code-path guard); edit them there.
LANED_CHAIN_TOML=/root/cascade/chain.toml
LANED_LOG=/root/cascade/laned-jobs.log

# The pinned signer of the house pointer, the lane D reports and the index
# ([manifest] validator_hotkey; the --lane-d-inputs TOML house_signer_ss58).
LANED_SIGNER_SS58=
LANED_WALLET_NAME=
LANED_WALLET_HOTKEY=

# house-pointer: the lane A king source (the validator's JSON state, read only),
# the pointer the --lane-d-inputs TOML names, and the owner-prepared house
# source for the current king (laned_house_source/1).
LANED_KING_SOURCE=/root/cascade/validator_state.db
LANED_KING_FIELD=king_pointer
LANED_HOUSE_POINTER=/root/cascade-state/lane-d/house_pointer.json
LANED_HOUSE_SOURCE=/root/cascade-state/lane-d/house_source.json

# Lane D validator state (lane_d_state.json; its reports sit beside it).
LANED_STATE=/root/cascade-state/lane-d/lane_d_state.json

# published-weights: the intake state dir, the signed index and a local copy of
# one public mirror (lane-d-kings/<digest>/).
LANED_INTAKE_STATE=/root/cascade-state/lane-d-intake
LANED_INDEX=/root/cascade-state/lane-d/champions/lane_d/index.json
LANED_MIRROR_DIR=/root/cascade-state/lane-d/mirror

# evidence: the staged new documents and the pinned paths the inputs TOML names.
LANED_EVIDENCE_STAGE=/root/cascade-state/lane-d/evidence-stage
LANED_PINNED_READINESS=/root/cascade-state/lane-d/laned_readiness.json
LANED_PINNED_T7=/root/cascade-state/lane-d/t7.json

# readiness measure (builder VM only): the synced forge mirror.
LANED_FORGE_DIR=/srv/forge-mirror

# vault sweep: fs mode roots (testnet) and the action-log dir.
LANED_VAULT_DIR=/root/cascade-state/lane-d/vault
LANED_ARCHIVE_DIR=/root/cascade-state/lane-d/archive
LANED_LEDGER=/root/cascade-state/lane-d/laned_vault_ledger.json
LANED_SWEEP_LOG_DIR=/root/cascade-state/lane-d/sweeps
