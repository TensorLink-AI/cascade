# docker compose reads this file as .env (never commit the real one).
# Comments stay on their own lines: an inline comment can become part of a value.

# judge: rents pods and funds submissions
LIUM_API_KEY=
# optional: higher HF rate limits for reveal downloads
HF_TOKEN=

# worker: Claude Code's provider (whichever [workers] llm_provider names)
CHUTES_API_KEY=
SAYGM_API_KEY=
ENGY_API_KEY=
ANTHROPIC_API_KEY=

# operator: Hermes on an OpenAI-compatible endpoint; the key is written to
# model.api_key inside the operator container only
HERMES_BASE_URL=https://llm.chutes.ai/v1
HERMES_MODEL=
HERMES_API_KEY=
OPERATOR_INTERVAL_SECONDS=7200

# updater: this directory's absolute path (the updater drives compose from it)
STACK_DIR=
UPDATE_INTERVAL_SECONDS=21600
# pin images instead of following the floating tags, e.g. …:sha-abc1234-harness
JUDGE_IMAGE=
WORKER_IMAGE=
OPERATOR_IMAGE=
# worker containers; match [search] proposals_per_cycle
WORKER_REPLICAS=4
