SELFTEST_PLAN = """# selftest plan

## 3. Implementation

| WP | What | Depends | Runs in | Accept |
|---|---|---|---|---|
| X1 | External probe | — | owner | `scripts/laned/accept X1 --evidence evidence/x1.json` |
| C1 | ci-only tool | — | ci | `scripts/laned/accept C1` |
"""

# X1's own verifier: the evidence must carry a request id (a field the bare
# {"wp", "passed"} shape lacks).
SELFTEST_VERIFIER = """import json, os

def test_inv2_evidence_has_request_id():
    path = os.environ.get("LANED_EVIDENCE")
    assert path, "accept did not export LANED_EVIDENCE"
    data = json.load(open(path))
    assert isinstance(data.get("request_id"), str) and data["request_id"]
"""

SELFTEST_HELPER = '''PLANTED = "def test_inv9_share_zero():\\n    assert True\\n"
FIXTURE = """
def test_inv1_unarmed():
    assert True
"""

def test_inv4_in_a_helper_module():
    pass
'''


def cmd_selftest() -> int:
    failures: list[str] = []
    # the fixture repo's `(#N)` subjects must never meet the real repo's PR
    # labels (the workflow exports LANED_PR_LABELS)
    os.environ.pop("LANED_PR_LABELS", None)

    def expect(cond: bool, what: str) -> None:
        if not cond:
            failures.append(what)

    # (1) the invariant counter counts AST test defs in test_*.py only.
    got = invariants_in({
        "tests/accept/x1/helpers.py": SELFTEST_HELPER,
        "tests/accept/x1/test_strings.py": ("S = 'def test_inv9_x(): pass'\n"
                                            "T = '''\ndef test_inv1_unarmed():\n    assert True\n'''\n"),
        "tests/accept/x1/test_real.py": ("def test_inv10_pairing():\n    assert 1\n"
                                         "class TestX:\n    def test_inv11_method(self):\n        assert 1\n"
                                         "def outer():\n    def test_inv12_nested():\n        pass\n"),
    })
    expect(9 not in got, "a planted 'def test_inv9_' string literal counted as invariant 9")
    expect(1 not in got, "a 'def test_inv1_' string in a fixture counted as invariant 1")
    expect(4 not in got, "a test_inv4_ def in a non-test (helper) module counted")
    expect(12 not in got, "a nested test_inv12_ function counted")
    expect(got == {10, 11}, f"invariants {sorted(got)}, want [10, 11]")

    accept = Path(__file__).resolve().parent / "accept"
    with tempfile.TemporaryDirectory(prefix="laned-status-selftest-") as tmp:
        root = Path(tmp) / "repo"
        root.mkdir()
        ident = ("-c", "user.name=t", "-c", "user.email=t@t", "-c", "commit.gpgsign=false")

        def put(rel: str, text: str) -> None:
            (root / rel).parent.mkdir(parents=True, exist_ok=True)
            (root / rel).write_text(text)

        def commit(msg: str) -> str:
            lanedlib.git(root, "add", "-A")
            lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
            return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

        lanedlib.git(root, "init", "-q")
        put(PLAN, SELFTEST_PLAN)
        commit("plan")
        put("tests/accept/x1/PATHS", "x1/\n")
        put("tests/accept/x1/test_x1.py", SELFTEST_VERIFIER)
        put("tests/accept/c1/PATHS", "c1/\n")
        put("tests/accept/c1/test_c1.py", "def test_c1():\n    assert True\n")
        commit("tests")
        put("x1/probe.py", "VALUE = 1\n")
        commit("x1 impl")
        put("c1/tool.py", "VALUE = 1\n")
        impl = commit("c1 impl")

        env = dict(os.environ, LANED_PYTEST_CMD=f"{sys.executable} -m pytest -p no:cacheprovider")

        def run_accept(ev: str) -> bool:
            proc = subprocess.run([sys.executable, str(accept), "X1", "--evidence", ev, "--root", str(root)],
                                  capture_output=True, text=True, env=env)
            return proc.returncode == 0

        def level(runs: list[dict], wp: str) -> tuple[str, dict]:
            tree = RefTree(root, "HEAD")
            data = compute(tree, parse_plan(tree.show(PLAN) or ""), runs, None)
            return data["wps"][wp]["level"], data

        def run(sha: str, wp: str, ok: bool, **extra: str) -> dict:
            return {"workflow": "laned-accept", "event": "push", "mode": "accept", "wp": wp,
                    "head_sha": sha, "conclusion": "success" if ok else "failure",
                    "created_at": "2026-01-01T00:00:00Z", **extra}

        xf = [{"workflow": "laned-accept", "event": "pull_request", "mode": "expect-fail", "wp": w,
               "head_sha": impl, "conclusion": "success"} for w in ("X1", "C1")]

        # (2) a bare {"wp", "passed": true} fails X1's own verifier, so the push
        # run is red and X1 never reaches L4.
        put("evidence/x1.json", json.dumps({"wp": "X1", "passed": True}))
        bare = commit("bare evidence")
        bare_blob = lanedlib.git(root, "rev-parse", f"{bare}:evidence/x1.json").stdout.strip()
        ok = run_accept("evidence/x1.json")
        expect(not ok, "accept X1 --evidence passed on a bare {wp, passed} file")
        lv, _ = level(xf + [run(bare, "X1", ok, evidence_sha=bare_blob)], "X1")
        expect(lv != "L4", f"bare evidence reached {lv}")
        # ... and a green run that never saw the evidence does not give L4 either.
        lv, _ = level(xf + [run(bare, "X1", True, evidence_sha="0" * 40)], "X1")
        expect(lv == "L3", f"a run that verified another blob gave {lv}, want L3")

        # Full evidence passes the verifier; L4 follows only from that green run.
        put("evidence/x1.json", json.dumps({"wp": "X1", "passed": True, "request_id": "req-1"}))
        full = commit("full evidence")
        full_blob = lanedlib.git(root, "rev-parse", f"{full}:evidence/x1.json").stdout.strip()
        ok = run_accept("evidence/x1.json")
        expect(ok, "accept X1 --evidence failed on evidence its verifier accepts")
        lv, data = level(xf + [run(full, "X1", ok, evidence_sha=full_blob), run(full, "C1", True)], "X1")
        expect(lv == "L4", f"verified evidence gave {lv}, want L4")
        expect(data["wps"]["C1"]["evidence_verified"] is True, "ci-only C1 did not pass L4's evidence rule")
        expect(data["wps"]["C1"]["level"] == "L4",
               f"accepted, unreviewed ci-only C1 gave {data['wps']['C1']['level']}, want L4 (§17.1)")

        # A later edit to the evidence that no green run verified loses L4.
        put("evidence/x1.json", json.dumps({"wp": "X1", "passed": True, "request_id": "req-2"}))
        commit("unverified evidence edit")
        lv, _ = level(xf + [run(full, "X1", True, evidence_sha=full_blob)], "X1")
        expect(lv == "L3", f"evidence edited after the verifying run gave {lv}, want L3")

        # (3) a verification WP: V1's PATHS name a file C1 already built. Its
        # tests-only PR runs `accept --verification` (MODE verification) and is
        # squash-merged; the merge commit is its L1 and L2 commit, the push run
        # on it gives L3. A failing verification run never gives L2.
        put(PLAN, SELFTEST_PLAN + "| V1 | Verification of C1 | C1 | ci | `scripts/laned/accept V1` |\n")
        put(".gitignore", "__pycache__/\n")
        put(lanedlib.VERIFICATION_WPS_PATH, "# verification WPs\nV1  # checks C1\n")
        commit("plan V1")
        pre = lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()
        lanedlib.git(root, "checkout", "-q", "-b", "pr-v1")
        put("tests/accept/v1/PATHS", "c1/tool.py\n")
        put("tests/accept/v1/test_v1.py", "def test_v1():\n    assert True\n")
        pr_head = commit("v1 tests (PR head)")
        proc = subprocess.run([sys.executable, str(accept), "V1", "--verification", "--base", pre,
                               "--head", pr_head, "--root", str(root)], capture_output=True, text=True, env=env)
        expect(proc.returncode == 0 and "MODE verification\n" in proc.stdout,
               f"accept V1 --verification did not print MODE verification: {proc.stdout[-1500:]}")
        m = re.search(r"^TESTS-TREE (\S+)$", proc.stdout, re.M)
        tests_tree = m.group(1) if m else ""
        lanedlib.git(root, "checkout", "-q", "-")
        lanedlib.git(root, "merge", "-q", "--squash", "pr-v1")
        squash = commit("v1 tests (#1)")
        vrun = {"workflow": "laned-accept", "event": "pull_request", "mode": "verification", "wp": "V1",
                "head_sha": pr_head, "conclusion": "success", "tests_tree": tests_tree}
        lv, data = level([vrun], "V1")
        expect(lv == "L2", f"a merged verification PR gave {lv}, want L2")
        expect(data["wps"]["V1"].get("l2_commit") == squash and data["wps"]["V1"].get("l2_via") == "verification",
               f"verification L2 commit {data['wps']['V1'].get('l2_commit')}, want the squash merge {squash}")
        lv, _ = level([vrun, run(squash, "V1", True)], "V1")
        expect(lv == "L4", f"verification WP with a green push run gave {lv}, want L4 (ci-only)")
        lv, _ = level([dict(vrun, conclusion="failure")], "V1")
        expect(lv == "L0", f"a failed verification run gave {lv}, want L0")
        lv, _ = level([dict(vrun, tests_tree="0" * 40, head_sha="0" * 40)], "V1")
        expect(lv == "L0", f"a verification run for another test tree gave {lv}, want L0")
        # an ordinary expect-fail run (tests-only flow unchanged): L1, no L2
        lv, _ = level([{"workflow": "laned-accept", "event": "pull_request", "mode": "expect-fail",
                        "wp": "V1", "head_sha": pr_head, "conclusion": "success"}], "V1")
        expect(lv == "L1", f"an expect-fail run on a verification WP gave {lv}, want L1")
        # (4) RV5: the same green verification run for a WP that REF's
        # scripts/laned/verification_wps does not list counts for nothing.
        put(lanedlib.VERIFICATION_WPS_PATH, "# verification WPs\nW0b\n")
        commit("V1 not declared")
        lv, data = level([vrun, run(squash, "V1", True)], "V1")
        expect(lv == "L0" and data["wps"]["V1"].get("l2_via") is None
               and data["wps"]["V1"].get("verification_refused"),
               f"an undeclared WP's verification run gave {lv} ({data['wps']['V1']}), want L0, refused")

        # (5) BATCH (plan rev6.2 (h)): one tests-only PR for B1, B2, B3, each
        # checked and run on its own (accept --check-pr --pr-wps, then
        # --verification -> expect-fail with its own TESTS-TREE), squash-merged:
        # the merge commit is L1 for all three, L2 for none.
        put(PLAN, SELFTEST_PLAN + "| V1 | Verification of C1 | C1 | ci | `scripts/laned/accept V1` |\n"
            + "".join(f"| {w} | batch {w} | — | ci | `scripts/laned/accept {w}` |\n"
                      for w in ("B1", "B2", "B3", "B4", "V2")))
        put(lanedlib.VERIFICATION_WPS_PATH, "# verification WPs\nV2  # checks C1\n")
        commit("plan batch")

        def batch_pr(name: str, files: dict[str, str], labels: list[str]) -> tuple[str, dict[str, dict]]:
            """Branch ``name`` off HEAD with ``files``, run the PR job's per-WP
            steps, squash-merge it; (squash sha, {WP: ledger entry})."""
            start = lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()
            branch = lanedlib.git(root, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
            lanedlib.git(root, "checkout", "-q", "-b", name)
            for rel, text in files.items():
                put(rel, text)
            head = commit(f"{name} (PR head)")
            entries: dict[str, dict] = {}
            for wp in labels:
                proc = subprocess.run([sys.executable, str(accept), wp, "--check-pr", "--base", start,
                                       "--head", head, "--pr-wps", ",".join(labels), "--root", str(root)],
                                      capture_output=True, text=True, env=env)
                expect(proc.returncode == 0 and "MODE tests-only\n" in proc.stdout,
                       f"batch {name}: {wp} check-pr did not print MODE tests-only: {proc.stdout[-1500:]}")
                proc = subprocess.run([sys.executable, str(accept), wp, "--verification", "--base", start,
                                       "--head", head, "--root", str(root)], capture_output=True, text=True, env=env)
                mode = re.findall(r"^LEDGER-MODE (\S+)$", proc.stdout, re.M)
                tree_m = re.findall(r"^TESTS-TREE (\S+)$", proc.stdout, re.M)
                expect(proc.returncode == 0 and mode and tree_m
                       and tree_m[-1] == lanedlib.wp_tree_at(root, head, wp),
                       f"batch {name}: {wp} --verification failed or printed no TESTS-TREE: {proc.stdout[-1500:]}")
                entries[wp] = {"workflow": "laned-accept", "event": "pull_request",
                               "mode": mode[-1] if mode else "expect-fail", "wp": wp, "head_sha": head,
                               "conclusion": "success" if proc.returncode == 0 else "failure",
                               "tests_tree": tree_m[-1] if tree_m else ""}
            lanedlib.git(root, "checkout", "-q", branch)
            lanedlib.git(root, "merge", "-q", "--squash", name)
            return commit(f"{name} (#2)"), entries

        three = {}
        for n in (1, 2, 3):
            three[f"tests/accept/b{n}/PATHS"] = f"b{n}/\n"
            three[f"tests/accept/b{n}/test_b{n}.py"] = (f"import b{n}.mod\n\n\ndef test_b{n}():\n"
                                                        f"    assert b{n}.mod.VALUE\n")
        squash, entries = batch_pr("pr-batch", three, ["B1", "B2", "B3"])
        _, data = level(list(entries.values()), "B1")
        for wp in ("B1", "B2", "B3"):
            det = data["wps"][wp]
            expect(entries[wp]["mode"] == "expect-fail", f"batch {wp} ledger mode {entries[wp]['mode']}")
            expect(det["level"] == "L1" and det.get("l1_commit") == squash and "l2_commit" not in det,
                   f"batch {wp}: {det['level']} l1_commit={det.get('l1_commit')} l2={det.get('l2_commit')}, "
                   f"want L1 at the squash merge {squash}, no L2")
        trees = {entries[w]["tests_tree"] for w in entries}
        expect(len(trees) == 3, f"batch WPs share a tests tree: {trees}")
        # a run whose tests_tree is not on REF's first-parent line gives no L1;
        # neither does another WP's tree
        lv, _ = level([dict(entries["B1"], tests_tree="0" * 40)], "B1")
        expect(lv == "L0", f"an expect-fail run for an unmerged tests tree gave {lv}, want L0")
        lv, _ = level([dict(entries["B1"], tests_tree=entries["B2"]["tests_tree"])], "B1")
        expect(lv == "L0", f"B1 took L1 from B2's tests tree: {lv}")
        # a run without tests_tree (dispatch bootstrap) still gives L1 as before
        lv, _ = level([{k: v for k, v in entries["B1"].items() if k != "tests_tree"}], "B1")
        expect(lv == "L1", f"an expect-fail run without tests_tree gave {lv}, want L1")
        # a batch with a declared verification WP: V2 (over C1's built file)
        # takes L1 and L2 from the batch squash commit, B4 only L1
        squash2, entries2 = batch_pr("pr-batch2", {
            "tests/accept/b4/PATHS": "b4/\n",
            "tests/accept/b4/test_b4.py": "import b4.mod\n\n\ndef test_b4():\n    assert b4.mod.VALUE\n",
            "tests/accept/v2/PATHS": "c1/tool.py\n",
            "tests/accept/v2/test_v2.py": "def test_v2():\n    assert True\n"}, ["B4", "V2"])
        _, data = level(list(entries.values()) + list(entries2.values()), "V2")
        v2, b4 = data["wps"]["V2"], data["wps"]["B4"]
        expect(entries2["V2"]["mode"] == "verification" and v2["level"] == "L2"
               and v2.get("l2_commit") == squash2 and v2.get("l2_via") == "verification",
               f"batch V2: mode {entries2['V2']['mode']}, {v2}, want L2 via verification at {squash2}")
        expect(b4["level"] == "L1" and b4.get("l1_commit") == squash2 and "l2_commit" not in b4,
               f"batch B4: {b4}, want L1 at {squash2}")
        expect(all(data["wps"][w]["level"] == "L1" for w in ("B1", "B2", "B3")),
               "a later batch changed B1-B3's level")

        # (6) BATCH IMPLEMENTATION (plan rev6.3 (b)): one squash merge
        # implementing B1 and B2 (disjoint PATHS b1/, b2/) is the L2 commit of
        # both; a merge with a file in no WP's PATHS is L2 for none (B3).
        put("b1/mod.py", "VALUE = 1\n")
        put("b2/mod.py", "VALUE = 1\n")
        impl12 = commit("feat: B1 B2 (#3)")
        put("b3/mod.py", "VALUE = 1\n")
        put("README.md", "edited with B3\n")
        commit("feat: B3 + a stray file (#4)")
        _, data = level(list(entries.values()), "B1")
        for wp in ("B1", "B2"):
            det = data["wps"][wp]
            expect(det["level"] == "L2" and det.get("l2_commit") == impl12
                   and det.get("l2_via") == "implementation",
                   f"batch impl {wp}: {det}, want L2 at {impl12}")
        expect(data["wps"]["B3"]["level"] == "L1",
               f"a merge with a stray file gave B3 {data['wps']['B3']['level']}, want L1")

        # (7) FEATURE / LABELLED rules (rev6.17): one squash merge (#7)
        # labelled F1 F2 carries F1's new tests, PATHS and code plus F2's code
        # (overlapping PATHS fc/): F1's green `combined` row makes it F1's L1
        # and L2, F2's label + f2/ change its L2. F3 (PATHS fc/ f3/, not
        # labelled) gets nothing from #7 nor from #8, a merge labelled F1 that
        # only changes fc/core.py (all inside F3's PATHS: the git-only rule
        # would have said L2, the #817 / W5i case); #9, labelled F3 but
        # changing only F3's tests, is no L2 either.
        put(PLAN, (root / PLAN).read_text() + "".join(
            f"| {w} | feature {w} | — | ci | `scripts/laned/accept {w}` |\n" for w in ("F1", "F2", "F3")))
        put("tests/accept/f2/PATHS", "fc/\nf2/\n")
        put("tests/accept/f2/test_f2.py", "def test_f2():\n    assert True\n")
        put("tests/accept/f3/PATHS", "fc/\nf3/\n")
        put("tests/accept/f3/test_f3.py", "def test_f3():\n    assert True\n")
        f_tests = commit("tests F2 F3 (#6)")
        put("tests/accept/f1/PATHS", "fc/\nf1/\n")
        put("tests/accept/f1/test_f1.py", "def test_f1():\n    assert True\n")
        put("fc/core.py", "VALUE = 1\n")
        put("f1/mod.py", "VALUE = 1\n")
        put("f2/mod.py", "VALUE = 1\n")
        feat = commit("feat(laned): F1 F2 core (#7)")
        put("fc/core.py", "VALUE = 2\n")
        only_core = commit("fix(laned): F1 core (#8)")
        put("tests/accept/f3/test_f3_more.py", "def test_more():\n    assert True\n")
        commit("tests(laned): F3 more (#9)")

        def pr_row(w: str, m: str, pr: int) -> dict:
            return {"workflow": "laned-accept", "event": "pull_request", "wp": w, "mode": m, "pr": pr,
                    "head_sha": "0" * 40, "conclusion": "success", "created_at": "2026-11-23T01:00:00Z"}

        f_runs = [pr_row("F1", "combined", 7), pr_row("F2", "accept", 7), pr_row("F1", "accept", 8),
                  pr_row("F3", "tests-correction", 9)]
        f_runs += [{"workflow": "laned-accept", "event": "pull_request", "mode": "expect-fail", "wp": w,
                    "head_sha": f_tests, "conclusion": "success"} for w in ("F2", "F3")]
        _, data = level(f_runs, "F1")
        f1, f2, f3 = (data["wps"][w] for w in ("F1", "F2", "F3"))
        expect(f1["level"] == "L2" and f1.get("l1_commit") == feat and f1.get("l2_commit") == feat,
               f"feature F1: {f1}, want L1 + L2 at {feat}")
        expect(f2["level"] == "L2" and f2.get("l2_commit") == feat, f"feature F2: {f2}, want L2 at {feat}")
        expect(f3["level"] == "L1" and "l2_commit" not in f3,
               f"F3 (never labelled on a code merge): {f3}, want L1")
        # without any label knowledge the git-only rule takes #8 as F3's L2
        # (the old behaviour); a labels file saying #8 carried only laned:F1
        # restores the LABELLED rule
        legacy = [r for r in f_runs if "pr" not in r]
        _, data = level(legacy, "F1")
        expect(data["wps"]["F3"].get("l2_commit") == only_core,
               f"legacy git-only rule: F3 {data['wps']['F3']}, want L2 at {only_core}")
        labels_file = Path(tmp) / "pr_labels.json"
        labels_file.write_text(json.dumps([{"number": n, "labels": [{"name": f"laned:{w}"} for w in ws]}
                                           for n, ws in ((7, ("F1", "F2")), (8, ("F1",)), (9, ("F3",)))]))
        saved_labels = os.environ.get("LANED_PR_LABELS")
        os.environ["LANED_PR_LABELS"] = str(labels_file)
        try:
            _, data = level(legacy, "F1")
        finally:
            if saved_labels is None:
                os.environ.pop("LANED_PR_LABELS", None)
            else:
                os.environ["LANED_PR_LABELS"] = saved_labels
        expect(data["wps"]["F3"]["level"] == "L1" and data["wps"]["F2"].get("l2_commit") == feat,
               f"labels file: F3 {data['wps']['F3']}, F2 {data['wps']['F2']}")
    for f in failures:
        print(f"status selftest: FAIL {f}", file=sys.stderr)
    if failures:
        return 1
    print("status selftest: ok")
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["selftest"]:
        return cmd_selftest()
    ap = argparse.ArgumentParser(prog="status", description=__doc__.split("\n\n")[0])
    ap.add_argument("--root", default=".")
    ap.add_argument("--ref", default="origin/main")
    ap.add_argument("--ci-results", required=True)
    ap.add_argument("--out", required=True)
    ap.add_argument("--release-tag-glob")
    ap.add_argument("--push", metavar="REMOTE")
    ap.add_argument("--include", action="append", default=[], metavar="SRC:DEST",
                    help="extra file committed to laned/build-state with --push")
    args = ap.parse_args(argv)
    root = Path(args.root).resolve()
    tree = RefTree(root, args.ref)
    plan_text = tree.show(PLAN)
    if plan_text is None:
        print(f"status: {PLAN} not found at {args.ref}", file=sys.stderr)
        return 1
    ci_path = lanedlib.resolve(root, args.ci_results)
    runs = json.loads(ci_path.read_text()).get("runs", []) if ci_path.is_file() else []
    data = compute(tree, parse_plan(plan_text), runs, args.release_tag_glob)
    out = lanedlib.resolve(root, args.out)
    md_path = out / "docs" / "plans" / "STATUS.md"
    json_path = out / "status" / "laned_build.json"
    md_path.parent.mkdir(parents=True, exist_ok=True)
    json_path.parent.mkdir(parents=True, exist_ok=True)
    json_path.write_text(json.dumps(data, indent=2, sort_keys=False) + "\n")
    md_path.write_text(render_md(data))
    summary = ", ".join(f"{wp} {v['level']}" for wp, v in data["wps"].items())
    print(f"status: {len(data['wps'])} WP(s) at {tree.commit[:12]}: {summary}")
    if args.push:
        files = {"docs/plans/STATUS.md": md_path, "status/laned_build.json": json_path}
        for spec in args.include:
            src, _, dest = spec.partition(":")
            if not dest:
                ap.error(f"--include needs SRC:DEST, got {spec!r}")
            files[dest] = lanedlib.resolve(root, src)
        commit = push(root, args.push, files, tree.commit)
        print(f"status: pushed {commit[:12]} to {args.push} {BUILD_STATE}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
