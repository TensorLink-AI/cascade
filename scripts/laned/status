import lanedlib  # noqa: E402

PLAN = "docs/plans/LANE_D_PLAN.md"
BUILD_STATE = "laned/build-state"
EXTERNAL_WORDS = ("builder", "pod", "testnet", "owner")
CLOSED_DECISION = ("decided", "withdrawn", "deferred-to-stage")
N_INVARIANTS = 12
STAGE_ORDER = ("S0", "S0a", "S0b", "S0c", "S1", "S2", "S2b", "S3", "S4", "S5", "S6",
               "SB0", "SB1", "SB2", "SB3", "SB4", "SB5", "S7", "S8")
# §5 row 12c: the SB1 build set and the SB0 decision set.
SB1_WPS = ("WB10", "WB11", "WB12", "WB13", "WB14", "WB15", "WB16", "WB17", "WB18",
           "WB22", "WB23", "W-S1", "W-S2")
SB0_DECISIONS = ("D35", "D36", "D37", "D38", "D39", "D40", "D41", "D42", "D42b")
T_ROW = re.compile(r"^T\d+[a-z]?$")


def clean(cell: str) -> str:
    return cell.replace("**", "").replace("`", "").strip()


def split_row(line: str) -> list[str]:
    body = line.strip()
    if body.startswith("|"):
        body = body[1:]
    if body.endswith("|"):
        body = body[:-1]
    return [c.strip() for c in body.split("|")]


def lvl(n: int) -> str:
    return f"L{n}"


