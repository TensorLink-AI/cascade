class Board:
    def __init__(self, tree: RefTree, plan: dict, runs: list[dict], tag_glob: str | None):
        self.tree = tree
        self.plan = plan
        self.runs = [r for r in runs if r.get("workflow", "laned-accept") == "laned-accept"]
        self.tags: list[str] = []
        if tag_glob:
            out = lanedlib.git(tree.root, "tag", "--list", tag_glob).stdout
            self.tags = [t for t in out.split("\n") if t]
        self.levels: dict[str, int] = {}
        self.detail: dict[str, dict] = {}
        self.verification_wps = lanedlib.parse_verification_wps(tree.show(lanedlib.VERIFICATION_WPS_PATH))
        self._paths_sets: dict[str, list[str]] | None = None
        self._subjects: dict[str, str] | None = None
        self._pr_labels: dict[int, set[str]] | None = None
        self.pr_labels_extra: dict[int, set[str]] = lanedlib.pr_labels_file()

    # -- per-level conditions ------------------------------------------------
    def subjects(self) -> dict[str, str]:
        if self._subjects is None:
            self._subjects = lanedlib.first_parent_subjects(self.tree.root, self.tree.commit)
        return self._subjects

    def l2_commit(self, wp: str, paths: list[str]) -> int | None:
        # shared with `accept --check-pr` (tests-only vs tests-correction);
        # with every other WP's PATHS a batch implementation squash merge
        # (plan rev6.3 (b)) is the L2 commit of each of its WPs
        # (and a declared coupled-set merge, scripts/laned/coupled_batches,
        # the L2 commit of each member)
        if self._paths_sets is None:
            self._paths_sets = lanedlib.paths_sets_at(self.tree.root, self.tree.commit)
            self._coupled = lanedlib.parse_coupled_batches(
                self.tree.show(lanedlib.COUPLED_BATCHES_PATH))
        if self._pr_labels is None:
            # LABELLED rule (rev6.17): known PR labels from --pr-labels /
            # $LANED_PR_LABELS (gh pr list) and the ledger's PR rows
            self._pr_labels = lanedlib.merge_pr_labels(self.pr_labels_extra,
                                                       lanedlib.pr_labels_from_runs(self.runs))
        return lanedlib.impl_commit_index(self.tree.history, wp, paths,
                                          lanedlib.other_paths(self._paths_sets, wp),
                                          lanedlib.coupled_paths(self._coupled, self._paths_sets, wp),
                                          self.subjects(), self._pr_labels)

    def verification_commit(self, wp: str, runs: list[dict]) -> int | None:
        """First-parent index of the merge of a green ``verification`` PR run:
        the first tests-only commit touching tests/accept/<wp>/ whose test dir tree
        is a run's ``tests_tree`` (or whose sha is a run's ``head_sha``)."""
        if not runs:
            return None
        trees = {r["tests_tree"] for r in runs if isinstance(r.get("tests_tree"), str)}
        shas = {r["head_sha"] for r in runs if isinstance(r.get("head_sha"), str)}
        return lanedlib.verification_commit_index(self.tree.root, self.tree.history, wp, trees, shas)

    def evidence_ok(self, wp: str, run: dict) -> tuple[bool, str]:
        """L4 for an external WP: the evidence file at REF passes the field check
        **and** ``run`` (the green push/accept run that gave L3) verified that
        exact blob, i.e. the WP's own tests ran against it via ``--evidence``
        (``LANED_EVIDENCE``). Field presence alone never gives L4 (RV1)."""
        info = self.plan["wps"][wp]
        if not info["external"]:
            return True, "ci-only"
        path = evidence_path(info, wp)
        ok, why = lanedlib.check_evidence(self.tree.show(path), path, wp)
        if not ok:
            return False, f"{path}: {why}"
        ok, why = run_verified_blob(self.tree, run, path, self.tree.blob(path))
        return ok, f"{path}: {why}"

    def reviewed(self, wp: str) -> str | None:
        for path in sorted(self.tree.files):
            if not re.match(r"^evidence/rv\d+\.md$", path):
                continue
            text = self.tree.show(path) or ""
            covers = re.search(r"^Covers:(.*)$", text, re.M)
            if not covers or not lanedlib.has_token(covers.group(1), wp):
                continue
            if any(lanedlib.has_token(item, wp) for item in lanedlib.open_blocking_items(text)):
                continue
            return path
        return None

    def released(self, sha: str) -> str | None:
        for tag in self.tags:
            proc = lanedlib.git(self.tree.root, "merge-base", "--is-ancestor", sha, f"refs/tags/{tag}",
                                check=False)
            if proc.returncode == 0:
                return tag
        return None

    def live(self, wp: str) -> bool:
        text = self.tree.show(f"evidence/l7/{lanedlib.wp_dir(wp)}.json")
        if text is None:
            return False
        try:
            data = json.loads(text)
        except json.JSONDecodeError:
            return False
        if not isinstance(data, dict):
            return False
        block = data.get("activation_block")
        era = data.get("era_range")
        return (isinstance(block, int) and not isinstance(block, bool)
                and data.get("monitor") == "green"
                and isinstance(era, list) and len(era) == 2
                and all(isinstance(e, int) and not isinstance(e, bool) for e in era)
                and era[1] >= era[0])

    def level(self, wp: str) -> int:
        d = lanedlib.wp_dir(wp)
        det: dict = {}
        self.detail[wp] = det
        paths_text = self.tree.show(f"tests/accept/{d}/PATHS")
        xf_runs = [r for r in self.runs if r.get("wp") == wp and r.get("mode") == "expect-fail"
                   and r.get("conclusion") == "success"]
        # BATCH (plan rev6.2 (h)): a run that records the WP's tests_tree gives
        # L1 only through the commit on REF's first-parent line it attributes
        # to (tests_commit_index: a tests-only commit, batch squash merges
        # included, whose tests/accept/<wp>/ tree is that tests_tree). A run
        # without the field (dispatch bootstrap, older ledger entries) counts
        # as before.
        xf_trees = {r["tests_tree"] for r in xf_runs if isinstance(r.get("tests_tree"), str)}
        l1 = lanedlib.tests_commit_index(self.tree.root, self.tree.history, wp, xf_trees, set()) \
            if xf_trees and paths_text is not None else None
        if l1 is not None:
            det["l1_commit"] = self.tree.history[l1][0]
        expect_fail_ok = l1 is not None or any("tests_tree" not in r for r in xf_runs)
        verified = [r for r in self.runs if r.get("wp") == wp and r.get("mode") == "verification"
                    and r.get("conclusion") == "success"]
        if verified and wp not in self.verification_wps:
            # RV5: only a declared verification WP (scripts/laned/verification_wps
            # at REF) may take L1/L2 from a verification run; for any other WP
            # such a run counts for nothing (expect-fail semantics: L1 needs a
            # green expect-fail run, L2 an implementation commit).
            det["verification_refused"] = f"{wp} not in {lanedlib.VERIFICATION_WPS_PATH}"
            verified = []
        det["paths"] = paths_text is not None
        det["expect_fail_success"] = expect_fail_ok
        if verified:
            det["verification_success"] = True
        if paths_text is None:
            return 0
        # Verification WP (accept --help, MODE verification): the merge of a
        # green verification PR is both its L1 and its L2 commit.
        vf = self.verification_commit(wp, verified)
        paths = lanedlib.parse_paths(paths_text)
        impl = self.l2_commit(wp, paths)
        # FEATURE rule (rev6.17): L2 of a labelled squash merge (#N) comes
        # from impl (LABELLED rule: the PR carried laned:<WP> and changed a
        # non-test path in the WP's PATHS); a green `combined` row (tests +
        # code) makes the merge that changes tests/accept/<wp>/ its L1 too.
        comb = lanedlib.pr_merge_index(self.tree.history, self.subjects(), wp, paths,
                                       lanedlib.green_pr_numbers(self.runs, wp, ("combined",)),
                                       need_tests=True)
        if comb is not None:
            det["combined_commit"] = self.tree.history[comb][0]
            det.setdefault("l1_commit", self.tree.history[comb][0])
            det["expect_fail_success"] = True
        if not expect_fail_ok and vf is None and comb is None:
            return 0
        if impl is None and vf is None:
            return 1
        l2 = min(i for i in (impl, vf) if i is not None)
        l2_sha = self.tree.history[l2][0]
        det["l2_commit"] = l2_sha
        det["l2_via"] = "implementation" if l2 == impl else "verification"
        relevant = [r for r in self.runs
                    if r.get("wp") == wp and r.get("event") == "push" and r.get("mode") == "accept"
                    and self.tree.position.get(r.get("head_sha", ""), -1) >= l2]
        relevant.sort(key=lambda r: (self.tree.position[r["head_sha"]], r.get("created_at", "")))
        if not relevant:
            return 2
        last = relevant[-1]
        det["last_main_run"] = {"head_sha": last["head_sha"], "conclusion": last.get("conclusion")}
        if last.get("conclusion") != "success":
            return 2
        ok, why = self.evidence_ok(wp, last)
        det["evidence"] = why
        det["evidence_verified"] = ok
        if not ok:
            return 3
        review = self.reviewed(wp)
        det["review"] = review
        if review is None:
            # §17.1: L4 is "n/a for ci-only WPs, which pass L4 automatically".
            # evidence_ok() returns True for a ci-only WP, so an accepted,
            # unreviewed WP is L4 whether it is external (evidence verified)
            # or ci-only (RV1 item 3; pinned by the W0c fixture tests).
            return 4
        tag = self.released(l2_sha)
        det["release_tag"] = tag
        if tag is None:
            return 5
        if not self.live(wp):
            return 6
        return 7

    # -- side states ---------------------------------------------------------
    def side_state(self, wp: str) -> str | None:
        info = self.plan["wps"][wp]
        if info["parked"]:
            return "parked"
        blocked = self.tree.show(f"evidence/blocked/{lanedlib.wp_dir(wp)}.md")
        if blocked is not None:
            first = blocked.strip().split("\n", 1)[0] if blocked.strip() else ""
            m = re.match(r"^Reason:\s*([A-Za-z0-9_-]+)", first)
            return f"blocked:{m.group(1) if m else 'unspecified'}"
        for did, dec in self.plan["decisions"].items():
            if decision_blocking(dec) and lanedlib.has_token(info["depends"], did):
                return f"blocked:{did}"
        for oa in self.plan["owner_inputs"].values():
            if (oa["status"].lower().startswith("open") and lanedlib.has_token(oa["unblocks"], wp)
                    and (not oa["evidence"] or self.tree.show(oa["evidence"]) is None)):
                return "blocked:owner"
        if self.levels[wp] < 2:
            for dep in self.plan["wps"]:
                if dep != wp and lanedlib.has_token(info["depends"], dep) and self.levels[dep] < 2:
                    return "blocked:dependency"
        return None


def gate_ok(tree: RefTree, runs: list[dict], stage: str, path: str) -> tuple[bool, str]:
    """§17.2 gate file: the --gate check at REF and the latest push ``gate`` run
    (``accept --gate <stage>`` in the push-to-main job) green on this blob.

    The push-to-main job runs the gate check for every gate file present and
    records it before the board is computed, so on main the run always exists.
    A ledger with no gate run at all for the stage (fixture ledgers, runs from
    before the gate step existed) falls back to the --gate check alone, and the
    detail says so.
    """
    ok, why = lanedlib.check_gate(tree.show(path), stage)
    if not ok:
        return False, why
    gate_runs = [r for r in runs if r.get("wp") == stage and r.get("mode") == "gate"
                 and r.get("event") == "push" and r.get("head_sha") in tree.position]
    if not gate_runs:
        return True, "ok (--gate check at REF; no gate run recorded)"
    gate_runs.sort(key=lambda r: (tree.position[r["head_sha"]], r.get("created_at", "")))
    return run_verified_blob(tree, gate_runs[-1], path, tree.blob(path))


def decision_closed(dec: dict) -> bool:
    return dec["status"].lower().startswith(CLOSED_DECISION)


def decision_blocking(dec: dict) -> bool:
    return dec["status"].lower().startswith("open") and dec["class"].startswith("S")


# ---------------------------------------------------------------------------
# Stages, milestones, counters
# ---------------------------------------------------------------------------

def compute(tree: RefTree, plan: dict, runs: list[dict], tag_glob: str | None) -> dict:
    board = Board(tree, plan, runs, tag_glob)
    wps = plan["wps"]
    for wp in wps:
        board.levels[wp] = board.level(wp)
    sides = {wp: board.side_state(wp) for wp in wps}
    levels = board.levels

    def at(names, n: int) -> tuple[bool, str]:
        names = list(names)
        low = [w for w in names if levels.get(w, -1) < n]
        return (bool(names) and not low,
                f"{', '.join(names) if len(names) <= 6 else str(len(names)) + ' WPs'} at >= L{n}"
                + (f" (below: {', '.join(low)})" if low else ""))

    group = lambda g: [w for w, i in wps.items() if i["group"] == g and not i["parked"]]  # noqa: E731
    build = group("build") + group("laned_core")
    exec_for = {}
    for w, i in wps.items():
        m = re.search(r"\b(S[0-9B]\w*)\b", i["stage"]) if i["group"] == "execution" else None
        if m and m.group(1) not in exec_for:
            exec_for[m.group(1)] = w

    t_total = plan["t_rows"]
    matrix_text = tree.show("evidence/s3_matrix.json")
    passed_rows: set[str] = set()
    if matrix_text:
        try:
            rows = json.loads(matrix_text).get("rows", {})
            passed_rows = {t for t, v in rows.items() if isinstance(v, dict) and v.get("passed") is True}
        except (json.JSONDecodeError, AttributeError):
            passed_rows = set()
    t_passed = [t for t in t_total if t in passed_rows]

    decs = plan["decisions"]
    all_closed = all(decision_closed(d) for d in decs.values())
    sb0_closed = all(d in decs and decision_closed(decs[d]) for d in SB0_DECISIONS)

    reqs: dict[str, list[tuple[bool, str]]] = {
        "S0": [(all_closed, "every decision decided, withdrawn or deferred-to-stage"), at(["W0"], 3)],
        "S0a": [at(["R6x"], 4)],
        "S0b": [at(["R2x"], 4)],
        "S0c": [at(["R7t", "R7m"], 4)],
        "S1": [at(["W1", "W0b", "W3a", "R16"], 4)],
        "S2": [at(build, 5)],
        "S2b": [at(["R9"], 4)],
        "S3": [at(["X3"], 4), (bool(t_total) and len(t_passed) == len(t_total), "every T-row passed")],
        "S4": [at(["X4"], 4), at(build, 6)],
        "S5": [at(["X5"], 4), at(build, 6)],
        "S6": [at(["X6a"], 4), at(group("laned_core"), 7)],
        "SB0": [(sb0_closed, "D35-D42 and D42b decided")],
        "SB1": [at(SB1_WPS, 5)],
        "SB2": [at(["WB19"], 4)],
        "SB3": [],
        "SB4": [],
        "SB5": [at(group("laneb"), 7)],
        "S7": [at(["X7"], 4)],
        "S8": [at(["W6-S8"], 4)],
    }
    stages: dict[str, dict] = {}
    for stage in STAGE_ORDER:
        if stage in exec_for:
            # The execution WP's evidence counts only as verified by its green
            # push/accept --evidence run (the same rule as L4), never by fields.
            w = exec_for[stage]
            path = evidence_path(wps[w], w)
            det = board.detail.get(w, {})
            g_ok = bool(det.get("evidence_verified"))
            g_why = det.get("evidence") or f"{w} has no green push/accept run (below L3)"
        else:
            path = lanedlib.gate_path(stage)
            g_ok, g_why = gate_ok(tree, board.runs, stage, path)
        checks = [{"check": why, "passed": ok} for ok, why in reqs[stage]]
        if stage == "SB4":
            checks.append({"check": "S5 complete (shared release)",
                           "passed": stages["S5"]["state"] == "complete"})
        complete = all(c["passed"] for c in checks) and g_ok
        stages[stage] = {"state": "complete" if complete else "incomplete", "requirements": checks,
                         "gate": {"evidence": path, "passed": g_ok, "detail": g_why}}

    done = lambda *ss: all(stages[s]["state"] == "complete" for s in ss)  # noqa: E731
    milestones = {
        "Build-complete": done("S2"),
        "Launch-ready": done("S0", "S0a", "S0b", "S0c", "S1", "S2", "S2b", "S3", "S4", "S5"),
        "Live": done("S6", "SB5"),
        "Done": done("S7"),
    }
    milestones = {k: "complete" if v else "incomplete" for k, v in milestones.items()}

    covered: set[int] = set()
    for wp in wps:
        if levels[wp] < 3:
            continue
        prefix = f"tests/accept/{lanedlib.wp_dir(wp)}/"
        covered |= invariants_in({p: tree.show(p) or "" for p in sorted(tree.files)
                                  if p.startswith(prefix) and is_test_module(p)})

    orphans = []
    for t in t_total:
        owners = plan["t_owners"].get(t)
        if owners is None or not any(lanedlib.has_token(owners, w) for w in wps):
            orphans.append(t)

    blocked: dict[str, list[str]] = {}
    for wp in wps:
        s = sides[wp]
        if s and s.startswith("blocked:"):
            blocked.setdefault(s.split(":", 1)[1], []).append(wp)

    oa_out = {}
    for oa, info in plan["owner_inputs"].items():
        ev = info["evidence"]
        oa_out[oa] = {"status": info["status"], "unblocks": info["unblocks"], "evidence": ev,
                      "present": bool(ev) and tree.show(ev) is not None}

    return {
        "schema": "laned_build/1",
        "ref": tree.ref,
        "commit": tree.commit,
        "generated_at": datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "wps": {wp: {"level": lvl(levels[wp]), "side_state": sides[wp],
                     "runs_in": wps[wp]["runs_in"], "external": wps[wp]["external"],
                     "evidence_file": evidence_path(wps[wp], wp) if wps[wp]["external"] else None,
                     "group": wps[wp]["group"], **board.detail.get(wp, {})} for wp in wps},
        "stages": stages,
        "milestones": milestones,
        "decisions": {d: {**info, "blocking": decision_blocking(info)} for d, info in decs.items()},
        "owner_inputs": oa_out,
        "counters": {
            "t_rows": {"passed": len(t_passed), "total": len(t_total)},
            "invariants": {"covered": sorted(covered), "total": N_INVARIANTS},
            "orphans": orphans,
            "blocked": [{"reason": r, "count": len(ws), "wps": sorted(ws)} for r, ws in blocked.items()],
        },
    }


def render_md(data: dict) -> str:
    c = data["counters"]
    out = [
        "# Lane D build status",
        "",
        f"Generated by `scripts/laned/status` at {data['generated_at']} from `{data['ref']}` "
        f"(`{data['commit'][:12]}`). Do not edit by hand (plan §17).",
        "",
        "## Counters",
        "",
        f"- T-rows passed: {c['t_rows']['passed']}/{c['t_rows']['total']}",
        f"- Invariants covered at L3+: {len(c['invariants']['covered'])}/{c['invariants']['total']} "
        f"({', '.join(map(str, c['invariants']['covered'])) or 'none'})",
        f"- Orphan T-rows: {', '.join(c['orphans']) or 'none'}",
        "- Blocked: " + ("; ".join(f"{b['reason']} {b['count']} ({', '.join(b['wps'])})"
                                   for b in c["blocked"]) or "none"),
        "",
        "## Milestones",
        "",
        "| Milestone | State |",
        "|---|---|",
        *[f"| {k} | {v} |" for k, v in data["milestones"].items()],
        "",
        "## Stages",
        "",
        "| Stage | State | Gate evidence |",
        "|---|---|---|",
        *[f"| {s} | {v['state']} | `{v['gate']['evidence']}`: {v['gate']['detail']} |"
          for s, v in data["stages"].items()],
        "",
        "## Work packages",
        "",
        "| WP | Level | State |",
        "|---|---|---|",
        *[f"| {wp} | {v['level']} | {v['side_state'] or '-'} |" for wp, v in data["wps"].items()],
        "",
        "## Open decisions and owner inputs",
        "",
    ]
    open_d = [f"- {d}: {v['status']} (class {v['class']}{', blocking' if v['blocking'] else ''})"
              for d, v in data["decisions"].items() if not v["status"].lower().startswith(CLOSED_DECISION)]
    open_oa = [f"- {oa}: {v['status']}; evidence `{v['evidence']}` {'present' if v['present'] else 'absent'}"
               for oa, v in data["owner_inputs"].items() if v["status"].lower().startswith("open")]
    out.extend(open_d + open_oa or ["- none"])
    out.append("")
    return "\n".join(out)


# ---------------------------------------------------------------------------
# Publishing to laned/build-state
# ---------------------------------------------------------------------------

def push(root: Path, remote: str, files: dict[str, Path], ref_commit: str) -> str:
    branch = f"refs/heads/{BUILD_STATE}"
    remote_head = lanedlib.git(root, "ls-remote", remote, branch).stdout.split()
    parent = None
    if remote_head:
        lanedlib.git(root, "fetch", "--no-tags", "-q", remote, branch)
        parent = lanedlib.git(root, "rev-parse", "FETCH_HEAD").stdout.strip()
        if parent != remote_head[0]:
            raise RuntimeError(f"fetched {parent} but {remote} has {remote_head[0]}")
    with tempfile.TemporaryDirectory(prefix="laned-status-") as tmp:
        env = dict(os.environ, GIT_INDEX_FILE=str(Path(tmp) / "index"))

        def g(*args: str) -> str:
            return lanedlib.git(root, *args, env=env).stdout.strip()

        if parent:
            g("read-tree", parent)
        else:
            g("read-tree", "--empty")
        for dest, src in files.items():
            blob = g("hash-object", "-w", str(src))
            g("update-index", "--add", "--cacheinfo", f"100644,{blob},{dest}")
        tree = g("write-tree")
        args = ["commit-tree", tree, "-m", f"status: laned build board for {ref_commit[:12]}"]
        if parent:
            args[2:2] = ["-p", parent]
        commit = g(*args)
    lanedlib.git(root, "push", "-q", remote, f"{commit}:{branch}")
    return commit


