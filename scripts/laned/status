# Inputs at REF
# ---------------------------------------------------------------------------

class RefTree:
    def __init__(self, root: Path, ref: str):
        self.root = root
        self.ref = ref
        self.commit = lanedlib.git(root, "rev-parse", f"{ref}^{{commit}}").stdout.strip()
        self.files = set(lanedlib.git(root, "ls-tree", "-r", "--name-only", self.commit).stdout.split("\n"))
        self.files.discard("")
        self._cache: dict[str, str | None] = {}
        self.history = lanedlib.first_parent_history(root, self.commit)
        self.position = {sha: i for i, (sha, _) in enumerate(self.history)}

    def show(self, path: str) -> str | None:
        if path not in self._cache:
            if path in self.files:
                self._cache[path] = lanedlib.git(self.root, "show", f"{self.commit}:{path}").stdout
            else:
                self._cache[path] = None
        return self._cache[path]

    def blob(self, path: str, commit: str | None = None) -> str | None:
        """Blob sha of ``path`` at ``commit`` (default REF), None when absent."""
        commit = commit or self.commit
        if commit == self.commit and path not in self.files:
            return None
        if not re.fullmatch(r"[0-9a-f]{7,64}", commit):
            return None
        proc = lanedlib.git(self.root, "rev-parse", "-q", "--verify", f"{commit}:{path}", check=False)
        return proc.stdout.strip() if proc.returncode == 0 else None


def evidence_path(info: dict, wp: str) -> str:
    """The WP's evidence file: ``--evidence <file>`` in its Accept cell, else evidence/<wp>.json."""
    return info["evidence"] or f"evidence/{lanedlib.wp_dir(wp)}.json"


def run_verified_blob(tree: RefTree, run: dict, path: str, blob: str | None) -> tuple[bool, str]:
    """Did the green ``run`` verify ``path`` with content ``blob``?

    The push-to-main job runs ``accept <WP> --evidence <file>`` whenever the
    evidence file exists at the pushed commit and records the file's blob sha
    as ``evidence_sha``. A run that records ``evidence_sha`` verified exactly
    that blob. A ledger entry without the field (fixtures; runs from before
    the field existed) counts only when the file had the same blob at the
    run's own commit, i.e. that push job ran with ``--evidence`` on it.
    """
    if blob is None:
        return False, "evidence file missing"
    if run.get("conclusion") != "success":
        return False, "no green verifying run"
    if "evidence_sha" in run:
        if run.get("evidence_sha") == blob:
            return True, f"ok (verified by the run at {str(run.get('head_sha'))[:12]})"
        return False, (f"the latest green run verified {str(run.get('evidence_sha'))[:12]}, "
                       f"not the current blob {blob[:12]}")
    at_run = tree.blob(path, str(run.get("head_sha", "")))
    if at_run == blob:
        return True, f"ok (verified by the run at {str(run.get('head_sha'))[:12]})"
    return False, f"no green run verified the current blob {blob[:12]}"


INV_NAME = re.compile(r"^test_inv(\d+)_")


def collected_tests(source: str) -> list[str]:
    """Names of the test functions pytest collects from a test module, by AST.

    Module-level ``def``s and methods of module-level ``Test*`` classes only.
    String literals, nested functions and anything else never count (RV1).
    """
    try:
        mod = ast.parse(source)
    except (SyntaxError, ValueError):
        return []
    names: list[str] = []
    for node in mod.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            names.append(node.name)
        elif isinstance(node, ast.ClassDef) and node.name.startswith("Test"):
            names.extend(n.name for n in node.body if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)))
    return names


def is_test_module(path: str) -> bool:
    return path.endswith(".py") and posixpath.basename(path).startswith("test_")


def invariants_in(sources: dict[str, str]) -> set[int]:
    """§17.3: invariants n with a real ``test_inv<n>_*`` test in a test_*.py module."""
    found: set[int] = set()
    for path, text in sources.items():
        if not is_test_module(path):
            continue
        for name in collected_tests(text):
            m = INV_NAME.match(name)
            if m and 1 <= int(m.group(1)) <= N_INVARIANTS:
                found.add(int(m.group(1)))
    return found


def parse_plan(text: str) -> dict:
    wps: dict[str, dict] = {}
    decisions: dict[str, dict] = {}
    owner_inputs: dict[str, dict] = {}
    t_rows: list[str] = []
    t_owners: dict[str, str] = {}
    lines = text.splitlines()
    heading = ""
    group_label = ""
    i = 0
    while i < len(lines):
        line = lines[i]
        if line.startswith("## "):
            heading, group_label = line, ""
        elif line.startswith("**") and not line.startswith("|"):
            group_label = line
        if not line.lstrip().startswith("|"):
            i += 1
            continue
        block = []
        while i < len(lines) and lines[i].lstrip().startswith("|"):
            block.append(lines[i])
            i += 1
        header = [clean(c) for c in split_row(block[0])]
        rows = [split_row(r) for r in block[2:]] if len(block) > 2 else []
        col = {name: k for k, name in enumerate(header)}

        def cell(row: list[str], name: str, col: dict[str, int] = col) -> str:
            k = col.get(name)
            return row[k] if k is not None and k < len(row) else ""

        if header and header[0] == "WP" and "Runs in" in col:
            if "Stage" in col:
                group = "execution"
            elif "lane b" in group_label.lower():
                group = "laneb"
            elif "lane d core" in group_label.lower():
                group = "laned_core"
            else:
                group = "build"
            parked = "parked" in heading.lower()
            for row in rows:
                wp = clean(row[0])
                if not wp or wp in wps:
                    continue
                accept = cell(row, "Accept")
                m = re.search(r"--evidence\s+([^\s`)]+)", accept)
                runs_in = clean(cell(row, "Runs in"))
                wps[wp] = {
                    "depends": clean(cell(row, "Depends")),
                    "runs_in": runs_in,
                    "external": any(re.search(rf"\b{w}\b", runs_in) for w in EXTERNAL_WORDS),
                    "evidence": m.group(1) if m else None,
                    "group": group,
                    "parked": parked,
                    "stage": clean(cell(row, "Stage")),
                }
        elif header[:5] == ["D", "Status", "Option chosen", "Class", "Decided"]:
            for row in rows:
                d = clean(row[0])
                if d:
                    decisions[d] = {"status": clean(cell(row, "Status")),
                                    "option": clean(cell(row, "Option chosen")),
                                    "class": clean(cell(row, "Class")),
                                    "decided": clean(cell(row, "Decided"))}
        elif header[:4] == ["OA", "Status", "Unblocks", "Evidence file"]:
            for row in rows:
                oa = clean(row[0])
                if not oa:
                    continue
                ev_cell = cell(row, "Evidence file")
                m = re.search(r"`([^`]+)`", ev_cell) or re.search(r"(evidence/\S+)", ev_cell)
                owner_inputs[oa] = {"status": clean(cell(row, "Status")),
                                    "unblocks": clean(cell(row, "Unblocks")),
                                    "evidence": m.group(1) if m else None}
        elif header[:3] == ["#", "Case", "Expected"]:
            for row in rows:
                t = clean(row[0])
                if T_ROW.match(t) and t not in t_rows:
                    t_rows.append(t)
        elif header[:2] == ["Row", "WPs"]:
            for row in rows:
                t = clean(row[0])
                if t:
                    t_owners[t] = clean(cell(row, "WPs"))
    return {"wps": wps, "decisions": decisions, "owner_inputs": owner_inputs,
            "t_rows": t_rows, "t_owners": t_owners}


