           "WB22", "WB23", "W-S1", "W-S2")
SB0_DECISIONS = ("D35", "D36", "D37", "D38", "D39", "D40", "D41", "D42", "D42b")
T_ROW = re.compile(r"^T\d+[a-z]?$")


def clean(cell: str) -> str:
    return cell.replace("**", "").replace("`", "").strip()


def split_row(line: str) -> list[str]:
    body = line.strip()
    if body.startswith("|"):
        body = body[1:]
    if body.endswith("|"):
        body = body[:-1]
    return [c.strip() for c in body.split("|")]


def lvl(n: int) -> str:
    return f"L{n}"


