# ---------------------------------------------------------------------------

# A change to one of these can break any WP's tests: every built WP runs.
CROSS_GLOBAL = frozenset({"pyproject.toml", "uv.lock", "conftest.py", "tests/conftest.py",
                          "tests/__init__.py", "tests/accept/__init__.py", "pytest.ini",
                          "setup.cfg", "tox.ini"})
# absolute imports in a test or repo module also resolve against these
# (pytest's rootdir-less prepend puts tests/accept or tests first on sys.path)
CROSS_BASES = ("tests/accept", "tests")


def wp_ids_at(root: Path, ref: str) -> dict[str, str]:
    """``{tests/accept dir name: WP id}`` from the §3.0 tables of the plan at ``ref``."""
    text = plan_at(root, ref)
    out: dict[str, str] = {}
    for wp in lanedlib.plan_wp_ids(text) if text else []:
        out.setdefault(lanedlib.wp_dir(wp), wp)
    return out


def built_wps_at(root: Path, ref: str) -> list[tuple[str, list[str]]]:
    """``[(WP, PATHS at ref)]`` for every WP with an L2 commit on ``ref``'s
    first-parent line (lanedlib.impl_commit_index, the status board's L2
    rule). The board's L1 precondition (a green expect-fail run in the
    ledger) is not re-checked here: without the ledger, include the WP."""
    out = lanedlib.git(root, "ls-tree", "--name-only", f"{ref}:tests/accept", check=False).stdout.split()
    ids = wp_ids_at(root, ref)
    history = lanedlib.first_parent_history(root, ref)
    built: list[tuple[str, list[str]]] = []
    for d in sorted(out):
        proc = lanedlib.git(root, "show", f"{ref}:tests/accept/{d}/PATHS", check=False)
        if proc.returncode != 0:
            continue
        wp = ids.get(d, d)
        paths = lanedlib.parse_paths(proc.stdout)
        if lanedlib.impl_commit_index(history, wp, paths) is not None:
            built.append((wp, paths))
    return built


# (rel path, text) -> _module_refs: one AST parse per file content per run
_REFS_CACHE: dict[tuple[str, str], tuple[list[str], set[str]]] = {}


def import_closure(root: Path, start: list[str]) -> tuple[set[str], set[str]]:
    """Static import closure (AST, transitive, any repo file) of ``start``:
    (repo-relative module files reached, string constants of the ``start``
    files). Package ``__init__.py`` files of every imported module count."""
    seen: set[str] = set()
    strings: set[str] = set()
    firsts = set(start)
    todo = list(start)
    while todo:
        rel = posixpath.normpath(todo.pop())
        if rel in seen or rel.startswith("..") or not rel.endswith(".py"):
            continue
        path = root / rel
        if not path.is_file():
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        key = (rel, text)
        if key not in _REFS_CACHE:
            _REFS_CACHE[key] = _module_refs(rel, text, "", CROSS_BASES)
        seen.add(rel)
        cands, consts = _REFS_CACHE[key]
        if rel in firsts:
            strings |= consts
        todo += [c for c in cands if c not in seen]
    return seen, strings


def _string_names(s: str, changed: str) -> bool:
    """Does the test-dir string constant ``s`` name the changed path?"""
    s = s.strip()
    if not s or "\n" in s or len(s) > 300:
        return False
    s = s.strip("/")
    if not s or s == ".":
        return False
    if s == changed or changed.startswith(s + "/") and "/" in s:
        return True
    if "/" in s and changed.endswith("/" + s):
        return True
    # a bare file name (chain.toml) for a non-module file
    return not changed.endswith(".py") and "." in s and s == posixpath.basename(changed)


def cross_reasons(root: Path, wp: str, paths: list[str], diff: list[str]) -> list[str]:
    """Why ``wp``'s tests depend on the changed paths (empty: they don't)."""
    d = f"tests/accept/{lanedlib.wp_dir(wp)}/"
    why: list[str] = []
    glob = sorted(p for p in diff if p in CROSS_GLOBAL)
    if glob:
        why.append("global input " + " ".join(glob))
    own = sorted(p for p in diff if p.startswith(d))
    if own:
        why.append("its tests " + " ".join(own))
    overlap = sorted(p for p in diff if lanedlib.path_matches(p, paths))
    if overlap:
        why.append("PATHS overlap " + " ".join(overlap))
    tdir = root / d
    start = sorted(p.relative_to(root).as_posix() for p in tdir.rglob("*.py")
                   if "__pycache__" not in p.parts) if tdir.is_dir() else []
    mods, strings = import_closure(root, start)
    imported = sorted(p for p in diff if p in mods and not p.startswith(d))
    if imported:
        why.append("imports " + " ".join(imported))
    named = sorted(p for p in diff if p not in mods and not p.startswith(d)
                   and any(_string_names(s, p) for s in strings))
    if named:
        why.append("names " + " ".join(named))
    return why


def cross_select(root: Path, base: str, head: str,
                 pr_wps: list[str]) -> list[tuple[str, list[str], list[str]]]:
    """``[(WP, PATHS, reasons)]``: every WP other than the PR's own that is
    built on BASE and whose tests depend on the PR's changed paths."""
    diff = lanedlib.git(root, "diff", "--name-only", f"{base}...{head}").stdout.split()
    own = {lanedlib.wp_dir(w) for w in pr_wps}
    out = []
    for wp, paths in built_wps_at(root, base):
        if lanedlib.wp_dir(wp) in own:
            continue  # the PR's own WP: its main step already ran it
        why = cross_reasons(root, wp, paths, diff)
        if why:
            out.append((wp, paths, why))
    return out


def _collision_groups(root: Path, wps: list[str]) -> list[list[str]]:
    """Split WPs so one pytest run never imports two same-named top-level
    modules (test dirs without ``__init__.py`` import by basename)."""
    groups: list[tuple[list[str], set[str]]] = []
    for wp in wps:
        d = test_dir(root, wp)
        names = set() if (d / "__init__.py").is_file() else {
            p.name for p in d.rglob("*.py") if "__pycache__" not in p.parts}
        for members, used in groups:
            if not names & used:
                members.append(wp)
                used |= names
                break
        else:
            groups.append(([wp], set(names)))
    return [m for m, _ in groups]


def _owner(case: ET.Element, prefixes: dict[str, str]) -> str | None:
    for field in (case.get("classname") or "", case.get("name") or ""):
        for wp, pre in prefixes.items():
            if field == pre or field.startswith(pre + "."):
                return wp
    return None


def cross_pytest(root: Path, wps: list[str]) -> dict[str, str]:
    """One pytest run per collision group over the WPs' test dirs;
    ``{WP: "" when green, else why}``. Fails closed: a failure that cannot be
    attributed to one WP fails every WP of its run."""
    res: dict[str, str] = {}
    for group in _collision_groups(root, wps):
        prefixes = {wp: f"tests.accept.{lanedlib.wp_dir(wp)}" for wp in group}
        with tempfile.TemporaryDirectory(prefix="laned-cross-") as tmp:
            junit = Path(tmp) / "junit.xml"
            proc = run_pytest(root, group[0], [f"--rootdir={root}", f"--junitxml={junit}",
                                               "--continue-on-collection-errors"],
                              env=evidence_env(root, None),
                              targets=[f"tests/accept/{lanedlib.wp_dir(w)}/" for w in group])
            sys.stdout.write(proc.stdout[-20000:])
            sys.stderr.write(proc.stderr[-5000:])
            cases = list(ET.parse(junit).iter("testcase")) if junit.is_file() else None
        if cases is None:
            for wp in group:
                res[wp] = f"pytest wrote no report (exit {proc.returncode})"
            continue
        counts = {wp: [0, 0] for wp in group}  # [collected, failed]
        stray = 0
        for case in cases:
            bad = any(child.tag in ("failure", "error") for child in case)
            wp = _owner(case, prefixes)
            if wp is None:
                stray += bad
                continue
            counts[wp][0] += 1
            counts[wp][1] += bad
        for wp in group:
            collected, failed = counts[wp]
            if failed:
                res[wp] = f"{failed} of {collected} test(s) failed"
            elif stray:
                res[wp] = f"{stray} unattributed failure(s) in the shared run"
            elif not collected:
                res[wp] = "no tests collected"
            elif proc.returncode != 0 and not any(c[1] for c in counts.values()):
                res[wp] = f"pytest exit {proc.returncode}"
            else:
                res[wp] = ""
    return res


def cmd_cross(root: Path, pr_wps: list[str], base: str, head: str) -> int:
    """For every other WP at >= L2 on BASE whose tests depend on the PR's
    changes (module docstring): invariant 10, its pytest (shared runs) and
    stub_scan over its PATHS; no e2e (the main step ran it). Prints
    ``CROSS <WP> PASS|FAIL``; exit 1 when any FAIL."""
    selected = cross_select(root, base, head, pr_wps)
    if not selected:
        print("CROSS none (no other built WP depends on the changed paths)")
        return 0
    for wp, _, why in selected:
        print(f"cross {wp}: " + "; ".join(why))
    verdict: dict[str, str] = {}
    runnable = []
    for wp, _, _ in selected:
        if not test_dir(root, wp).is_dir():
            verdict[wp] = f"no tests at tests/accept/{lanedlib.wp_dir(wp)}/"
        elif unpaired_tests(root, wp):
            verdict[wp] = "invariant10: unpaired unarmed test(s)"
        else:
            runnable.append(wp)
    for wp, why in cross_pytest(root, runnable).items():
        verdict[wp] = f"pytest: {why}" if why else ""
    for wp, paths, _ in selected:
        if verdict.get(wp):
            continue
        lines, _ = stub_scan.scan(root, paths)
        for line in lines:
            print(line)
        if lines:
            verdict[wp] = f"stub_scan: {len(lines)} finding(s)"
    failed = 0
    for wp, _, _ in selected:
        why = verdict.get(wp, "")
        failed += bool(why)
        print(f"CROSS {wp} {'FAIL' if why else 'PASS'}" + (f" ({why})" if why else ""))
    return 1 if failed else 0


