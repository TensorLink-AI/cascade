def selftest_tests_correction(ident: tuple[str, ...]) -> list[str]:
    """The MODE rules for tests-only PRs, on real git repos and real pytest
    (sys.executable -m pytest; LANED_PYTEST_CMD is overridden for the run)."""
    failures: list[str] = []
    saved = os.environ.get("LANED_PYTEST_CMD")
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-tc-") as tmp:
            n = 0

            def repo(built: bool, layout: str):
                nonlocal n
                n += 1
                root = Path(tmp) / f"repo{n}"
                root.mkdir()

                def put_commit(files: dict[str, str], msg: str) -> str:
                    for rel, text in files.items():
                        (root / rel).parent.mkdir(parents=True, exist_ok=True)
                        (root / rel).write_text(text)
                    lanedlib.git(root, "add", "-A")
                    lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
                    return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

                lanedlib.git(root, "init", "-q")
                put_commit({"README.md": "x\n", "pkg_w9.py": "VALUE = 1\n"}, "seed")
                base = put_commit({"tests/accept/w9/PATHS": "pkg_w9.py\n", **SELFTEST_LAYOUTS[layout]},
                                  "tests-only")
                if built:
                    base = put_commit({"pkg_w9.py": "VALUE = 9\n"}, "implementation")
                return root, base, put_commit

            def case(name: str, built: bool, files: dict[str, str], want_mode: str, want_ok: bool,
                     layout: str = "flat") -> None:
                root, base, put_commit = repo(built, layout)
                head = put_commit(files, name)
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_check_pr(root, "W9", base, head)
                out = buf.getvalue()
                if rc != 0 or f"MODE {want_mode}\n" not in out:
                    failures.append(f"{name}: check-pr rc={rc}, want MODE {want_mode}: {out.strip()}")
                    return
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    if want_mode == "tests-only":
                        # the workflow's tests-only run; here it must stay expect-fail
                        rc = cmd_verification(root, "W9", base, head)
                    else:
                        rc = cmd_tests_correction(root, "W9", base, head)
                out = buf.getvalue()
                ok = rc == 0 and (("LEDGER-MODE expect-fail\n" in out and "MODE verification\n" not in out)
                                  if want_mode == "tests-only" else "MODE tests-correction PASS" in out)
                if ok != want_ok:
                    failures.append(f"{name}: {want_mode} {'passed' if ok else 'failed'}, "
                                    f"want {'pass' if want_ok else 'fail'}: {out.strip()[-2000:]}")

            # new WP, tests-only PR -> classic expect-fail (unchanged)
            case("new-wp-tests-only", False, {"tests/accept/w9/test_w9_more.py": SELFTEST_IMPL_FAIL},
                 "tests-only", True)
            # built WP + new passing tests -> pass
            case("built-new-passing", True, {"tests/accept/w9/test_w9_more.py": SELFTEST_PASSING},
                 "tests-correction", True)
            # built WP + new tests failing for a right reason -> pass (pending impl fix)
            case("built-new-failing-right", True, {"tests/accept/w9/test_w9_more.py": SELFTEST_IMPL_FAIL},
                 "tests-correction", True)
            # built WP + a corrected (edited) existing test failing for a right reason -> pass
            case("built-edited-failing-right", True,
                 {"tests/accept/w9/test_w9_value.py": SELFTEST_IMPL_FAIL}, "tests-correction", True)
            # built WP + a changed helper widens the fixture of an unedited test
            # that imports it (the R5 helpers.py shape): that test counts as
            # changed, fails for a right reason -> pass (pending the impl fix)
            case("built-helper-widens-unedited-test", True,
                 {"tests/accept/w9/w9_helper.py": "EXPECTED = 10\n",
                  "tests/accept/w9/test_w9_more.py": SELFTEST_IMPL_PASS}, "tests-correction", True)
            # the same through a package: `from .helpers import` -> helpers.py
            # -> `from ._base import` (transitive) -> pass
            case("built-pkg-transitive-helper", True, {"tests/accept/w9/_base.py": "EXPECTED = 10\n"},
                 "tests-correction", True, layout="pkg")
            # ... and a fixture data file an unedited test reads -> pass
            case("built-fixture-file-widens-unedited-test", True,
                 {"tests/accept/w9/fixtures/expected.txt": "10\n"}, "tests-correction", True)
            # built WP + a helper change reaching an unedited test only through a
            # dynamic import (outside the static closure): that test stays
            # "unchanged", it now fails -> FAIL
            case("built-unchanged-test-now-failing", True, {"tests/accept/w9/w9_dyn.py": "FLAG = False\n"},
                 "tests-correction", False)
            # a pkg helper change with a wrong-reason failure in the dependent test -> FAIL
            case("built-pkg-helper-wrong-reason", True,
                 {"tests/accept/w9/_base.py": "import laned_no_such_dep\nEXPECTED = 9\n"},
                 "tests-correction", False, layout="pkg")
            # built WP + a changed test failing for a wrong reason -> FAIL
            case("built-new-failing-wrong", True,
                 {"tests/accept/w9/test_w9_more.py": "import laned_no_such_dep\n\n\ndef test_x():\n"
                                                     "    assert laned_no_such_dep\n"},
                 "tests-correction", False)
    finally:
        if saved is None:
            os.environ.pop("LANED_PYTEST_CMD", None)
        else:
            os.environ["LANED_PYTEST_CMD"] = saved
    return failures


SELFTEST_VERIFY_PASS = "import pkg_w9\n\n\ndef test_built_value():\n    assert pkg_w9.VALUE == 9\n"


def selftest_verification(ident: tuple[str, ...]) -> list[str]:
    """MODE verification of the tests-only run: a repo where another WP already
    built ``pkg_w9.py`` (VALUE = 9) and a PR adds tests/accept/w9/ only."""
    failures: list[str] = []
    saved = os.environ.get("LANED_PYTEST_CMD")
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-vf-") as tmp:
            n = 0

            def case(name: str, base_files: dict[str, str], pr_files: dict[str, str],
                     want_rc: int, want_verification: bool, listed: bool = True) -> None:
                nonlocal n
                n += 1
                root = Path(tmp) / f"repo{n}"
                root.mkdir()

                def put_commit(files: dict[str, str], msg: str) -> str:
                    for rel, text in files.items():
                        (root / rel).parent.mkdir(parents=True, exist_ok=True)
                        (root / rel).write_text(text)
                    lanedlib.git(root, "add", "-A")
                    lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
                    return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

                lanedlib.git(root, "init", "-q")
                # W9 is a declared verification WP on BASE unless ``listed`` is False
                decl = {lanedlib.VERIFICATION_WPS_PATH: "# verification WPs\nW9  # checks pkg_w9\n"} if listed \
                    else {lanedlib.VERIFICATION_WPS_PATH: "# verification WPs\nW8\n"}
                base = put_commit({".gitignore": "__pycache__/\n", "pkg_w9.py": "VALUE = 9\n", **decl,
                                   **base_files}, "built by another WP")
                head = put_commit(pr_files, name)
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_check_pr(root, "W9", base, head)
                out = buf.getvalue()
                if rc != 0 or "MODE tests-only\n" not in out:
                    failures.append(f"verification {name}: check-pr rc={rc}, want MODE tests-only: {out.strip()}")
                    return
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_verification(root, "W9", base, head)
                out = buf.getvalue()
                got_v = "MODE verification\n" in out and "LEDGER-MODE verification\n" in out
                if rc != want_rc or got_v != want_verification:
                    failures.append(f"verification {name}: rc={rc} verification={got_v}, want rc={want_rc} "
                                    f"verification={want_verification}: {out.strip()[-2000:]}")
                    return
                if not want_verification and rc == 0 and "LEDGER-MODE expect-fail\n" not in out:
                    failures.append(f"verification {name}: fallback not recorded as expect-fail: {out.strip()}")
                if not listed and ("not a declared verification WP" not in out
                                   or (rc != 0 and "FAIL expect-fail" not in out)):
                    failures.append(f"verification {name}: an unlisted WP did not run expect-fail: {out.strip()}")
                if want_verification:
                    tree = lanedlib.wp_tree_at(root, head, "W9")
                    if f"TESTS-TREE {tree}\n" not in out:
                        failures.append(f"verification {name}: TESTS-TREE {tree} not printed: {out.strip()}")

            paths = {"tests/accept/w9/PATHS": "pkg_w9.py\n"}
            # every PATHS file exists on BASE and every test passes -> MODE verification
            case("verify-pass", {}, {**paths, "tests/accept/w9/test_w9.py": SELFTEST_VERIFY_PASS}, 0, True)
            # one test fails for a right reason -> expect-fail semantics (passes, not verification)
            case("verify-one-failing", {},
                 {**paths, "tests/accept/w9/test_w9.py": SELFTEST_VERIFY_PASS,
                  "tests/accept/w9/test_w9_more.py": SELFTEST_IMPL_FAIL}, 0, False)
            # a failure for a wrong reason in the fallback -> FAIL
            case("verify-wrong-reason", {},
                 {**paths, "tests/accept/w9/test_w9.py": "import laned_no_such_dep\n\n\ndef test_x():\n"
                                                         "    assert laned_no_such_dep\n"}, 1, False)
            # a PATHS file missing on BASE -> never verification, even with all
            # tests passing (expect-fail then fails: nothing fails for a right reason)
            case("verify-missing-paths-file", {},
                 {"tests/accept/w9/PATHS": "pkg_w9.py\npkg_w9_new.py\n",
                  "tests/accept/w9/test_w9.py": SELFTEST_VERIFY_PASS}, 1, False)
            # a missing dir/ or glob entry counts as missing too
            case("verify-missing-dir-entry", {},
                 {"tests/accept/w9/PATHS": "pkg_w9.py\npkg_w9_data/\npkg_w9_*.json\n",
                  "tests/accept/w9/test_w9.py": SELFTEST_VERIFY_PASS}, 1, False)
            # present dir/ and glob entries -> verification
            case("verify-dir-and-glob-present", {"pkg_w9_data/t.json": "{}\n", "pkg_w9_a.json": "{}\n"},
                 {"tests/accept/w9/PATHS": "pkg_w9.py\npkg_w9_data/\npkg_w9_*.json\n",
                  "tests/accept/w9/test_w9.py": SELFTEST_VERIFY_PASS}, 0, True)
            # RV5: W9 not listed in scripts/laned/verification_wps on BASE (another
            # WP is), every test passes on BASE -> never verification: expect-fail
            # semantics, which FAIL (no test fails for a right reason)
            case("verify-unlisted-wp", {}, {**paths, "tests/accept/w9/test_w9.py": SELFTEST_VERIFY_PASS},
                 1, False, listed=False)
            # (a tests-only PR cannot list itself: rule 1 refuses tests/accept/
            # with scripts/laned/, and the list is read at BASE anyway)
            # tests pass but stub_scan over PATHS fails -> not verification, FAIL
            case("verify-stub-scan", {"pkg_w9.py": "VALUE = 9  # " + "TO" + "DO\n"},
                 {**paths, "tests/accept/w9/test_w9.py": SELFTEST_VERIFY_PASS}, 1, False)
            # the classic tests-only flow for a new module (unchanged): right-reason
            # ModuleNotFoundError -> expect-fail passes
            case("classic-new-module", {},
                 {"tests/accept/w9/PATHS": "pkg_w9_new.py\n",
                  "tests/accept/w9/test_w9.py": "import pkg_w9_new\n\n\ndef test_new():\n"
                                                "    assert pkg_w9_new.VALUE == 1\n"}, 0, False)
    finally:
        if saved is None:
            os.environ.pop("LANED_PYTEST_CMD", None)
        else:
            os.environ["LANED_PYTEST_CMD"] = saved
    return failures


