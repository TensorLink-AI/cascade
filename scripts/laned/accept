def paths_at(root: Path, ref: str, wp: str) -> list[str] | None:
    rel = f"tests/accept/{lanedlib.wp_dir(wp)}/PATHS"
    proc = lanedlib.git(root, "show", f"{ref}:{rel}", check=False)
    if proc.returncode == 0:
        return lanedlib.parse_paths(proc.stdout)
    return read_paths(root, wp)


REVIEW_WP = re.compile(r"^RV(\d+)$")


def cmd_check_pr_review(root: Path, wp: str, n: str, base: str, head: str) -> int:
    """A review PR (label laned:RV<n>) adds or edits exactly evidence/rv<n>.md."""
    want = f"evidence/rv{n}.md"
    out = lanedlib.git(root, "diff", "--no-renames", "--name-status", f"{base}...{head}").stdout
    changes = [tuple(line.split("\t", 1)) for line in out.splitlines() if line.strip()]
    if not changes:
        return fail("review", "the PR changes nothing")
    bad = [f"{s} {p}" for s, p in changes if p != want or s not in ("A", "M")]
    if bad:
        return fail("review", f"a {wp} PR may only add or modify {want}; it also has: " + " ".join(bad))
    print("MODE review")
    return 0


def plan_at(root: Path, ref: str) -> str | None:
    """The plan at ``ref`` (the PR cannot edit it: PROTECTED), else the working tree's."""
    proc = lanedlib.git(root, "show", f"{ref}:{lanedlib.PLAN_PATH}", check=False)
    if proc.returncode == 0:
        return proc.stdout
    p = root / lanedlib.PLAN_PATH
    return p.read_text(encoding="utf-8") if p.is_file() else None


def declared_evidence(root: Path, ref: str, wp: str) -> list[str]:
    """The evidence files named by ``--evidence`` in the WP's §3.0 Accept cell at ``ref``."""
    text = plan_at(root, ref)
    return lanedlib.accept_evidence_files(text, wp) if text else []


def cmd_check_pr_evidence(root: Path, wp: str, base: str, head: str,
                          diff: list[str]) -> int | None:
    """MODE evidence (module docstring), or None when the PR is not an evidence PR.

    An evidence PR adds or modifies only evidence files named in the WP's
    Accept cell (plan at BASE). Touching one of them together with anything
    else, deleting one, or an evidence/-only diff naming a file the Accept cell
    does not declare (and the WP's PATHS do not cover) fails ``FAIL evidence``."""
    declared = declared_evidence(root, base, wp)
    out = lanedlib.git(root, "diff", "--no-renames", "--name-status", f"{base}...{head}").stdout
    changes = [tuple(line.split("\t", 1)) for line in out.splitlines() if "\t" in line]
    touched = [p for _, p in changes if p in declared]
    if touched:
        bad = [f"{s} {p}" for s, p in changes if p not in declared or s not in ("A", "M")]
        if bad:
            return fail("evidence", f"an evidence PR for {wp} may only add or modify "
                        + " ".join(declared) + "; it also has: " + " ".join(bad))
        print("MODE evidence")
        for p in touched:
            print(f"EVIDENCE {p}")
        return 0
    if diff and all(p.startswith("evidence/") for p in diff):
        paths = paths_at(root, base, wp) or paths_at(root, head, wp) or []
        if not all(lanedlib.path_matches(p, paths) for p in diff):
            named = " ".join(declared) if declared else "none"
            return fail("evidence", f"not an evidence file named in {wp}'s Accept cell "
                        f"(declared: {named}): " + " ".join(sorted(diff)))
    return None


def cmd_check_pr(root: Path, wp: str, base: str, head: str) -> int:
    m = REVIEW_WP.match(wp)
    if m:
        return cmd_check_pr_review(root, wp, m.group(1), base, head)
    diff = lanedlib.git(root, "diff", "--name-only", f"{base}...{head}").stdout.split()
    if not diff:
        return fail("paths", "the PR changes nothing")
    rc = cmd_check_pr_evidence(root, wp, base, head, diff)
    if rc is not None:
        return rc
    tests = [p for p in diff if p.startswith("tests/accept/")]
    others = [p for p in diff if not p.startswith("tests/accept/")]
    if tests and others:
        return fail("rule1", "tests/accept/ edited together with: " + " ".join(others))
    if tests:
        own = f"tests/accept/{lanedlib.wp_dir(wp)}/"
        foreign = [p for p in tests if not p.startswith(own)]
        if foreign:
            return fail("rule1", f"tests-only PR for {wp} touches another WP's tests: " + " ".join(foreign))
        # MODE rules (module docstring): a WP already built on BASE gets a
        # tests-correction run, an unbuilt one the classic expect-fail run.
        print("MODE tests-correction" if built_on(root, base, wp) else "MODE tests-only")
        return 0
    paths = paths_at(root, base, wp) or paths_at(root, head, wp)
    if not paths:
        return fail("paths", f"no tests/accept/{lanedlib.wp_dir(wp)}/PATHS")
    outside = [p for p in diff if not lanedlib.path_matches(p, paths)]
    if wp != TOOLING_WP:
        outside += [p for p in diff if p.startswith("scripts/laned/") and p not in outside]
    outside += [p for p in diff if p in PROTECTED and p not in outside]
    if outside:
        return fail("paths", "outside the WP's PATHS: " + " ".join(sorted(outside)))
    print("MODE implementation")
    return 0


# ---------------------------------------------------------------------------
# tests-correction (a tests-only PR for a WP already built on BASE)
# ---------------------------------------------------------------------------

def built_on(root: Path, ref: str, wp: str) -> bool:
    """True when ``ref`` carries the WP's implementation: its first-parent
    line has the L2 commit (the status board's rule, lanedlib.impl_commit_index)
    for the PATHS file at ``ref``. No PATHS at ``ref`` means a new WP."""
    rel = f"tests/accept/{lanedlib.wp_dir(wp)}/PATHS"
    proc = lanedlib.git(root, "show", f"{ref}:{rel}", check=False)
    if proc.returncode != 0:
        return False
    history = lanedlib.first_parent_history(root, ref)
    return lanedlib.impl_commit_index(history, wp, lanedlib.parse_paths(proc.stdout)) is not None


def is_test_file(rel: str) -> bool:
    name = rel.rsplit("/", 1)[-1]
    return name.endswith(".py") and (name.startswith("test_") or name.endswith("_test.py"))


def wp_test_files(root: Path, wp: str) -> list[str]:
    d = test_dir(root, wp)
    return sorted(p.relative_to(root).as_posix() for p in d.rglob("*.py")
                  if is_test_file(p.name) and "__pycache__" not in p.parts)


def _module_files(base: str, dotted: str) -> list[str]:
    """Candidate files for module ``a.b`` under dir ``base``: every prefix as
    ``.py`` or a package ``__init__.py`` (importing ``a.b`` runs ``a`` too)."""
    parts = [p for p in dotted.split(".") if p]
    out: list[str] = []
    for i in range(1, len(parts) + 1):
        stem = posixpath.normpath(posixpath.join(base or ".", *parts[:i]))
        out += [stem + ".py", stem + "/__init__.py"]
    return out


def _module_refs(rel: str, text: str, own_dir: str) -> tuple[list[str], set[str]]:
    """(candidate module files ``rel`` imports, its string constants) by AST."""
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return [], set()
    here = posixpath.dirname(rel)
    # absolute imports resolve against the repo root (package mode), the
    # module's own dir (pytest rootdir-less prepend) and the WP dir
    bases = ("", here, own_dir.rstrip("/"))
    cands: list[str] = []
    strings: set[str] = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                for b in bases:
                    cands += _module_files(b, alias.name)
        elif isinstance(node, ast.ImportFrom):
            mod = node.module or ""
            if node.level:
                base = here
                for _ in range(node.level - 1):
                    base = posixpath.dirname(base)
                roots: tuple[str, ...] = (base,)
                cands.append(posixpath.normpath(posixpath.join(base or ".", "__init__.py")))
            else:
                roots = bases
            for b in roots:
                if mod:
                    cands += _module_files(b, mod)
                for alias in node.names:
                    cands += _module_files(b, f"{mod}.{alias.name}" if mod else alias.name)
        elif isinstance(node, ast.Constant) and isinstance(node.value, str):
            strings.add(node.value)
    return cands, strings


def _data_referenced(f: str, own_dir: str, strings: set[str]) -> bool:
    """Is the (non-.py) WP-dir file ``f`` named by one of the string constants?
    A constant matches the file's basename, its path relative to the WP dir or
    the repo, or a directory containing it (``"fixtures"``)."""
    rel = f[len(own_dir):]
    base = posixpath.basename(f)
    for s in strings:
        s = s.strip().strip("/")
        if not s or s == "." or "\n" in s:
            continue
        if s in (base, rel, f) or rel.startswith(s + "/") or f.startswith(s + "/") \
                or rel.endswith("/" + s):
            return True
    return False


def module_closure(root: Path, test_rel: str, own_dir: str,
                      changed: set[str]) -> tuple[set[str], set[str]]:
    """Static closure of one test module inside the WP dir ``own_dir``:
    (module files it depends on, string constants in them). Ancestor
    ``conftest.py`` / ``__init__.py`` files inside the WP dir count too."""
    seen: set[str] = set()
    strings: set[str] = set()
    todo = [test_rel]
    d = posixpath.dirname(test_rel)
    while d.startswith(own_dir.rstrip("/")):
        todo += [f"{d}/conftest.py", f"{d}/__init__.py"]
        d = posixpath.dirname(d)
    while todo:
        rel = todo.pop()
        if rel in seen or not rel.startswith(own_dir):
            continue
        path = root / rel
        if not path.is_file() and rel not in changed:
            continue
        seen.add(rel)
        if not path.is_file():
            continue
        cands, consts = _module_refs(rel, path.read_text(encoding="utf-8", errors="replace"), own_dir)
        strings |= consts
        todo += [c for c in cands if c not in seen]
    return seen, strings


def changed_test_files(root: Path, wp: str, diff: list[str]) -> tuple[list[str], dict[str, list[str]]]:
    """Test files the PR changes: edited/added directly, or one whose static
    closure inside tests/accept/<wp>/ (imported helpers, conftest, package
    __init__, fixture files it names) has a changed file. Returns the list and
    ``{test: [changed dependency, ...]}`` for the indirect ones."""
    own = f"tests/accept/{lanedlib.wp_dir(wp)}/"
    changed = {p for p in diff if p.startswith(own)}
    data = sorted(p for p in changed if not p.endswith(".py"))
    out: list[str] = []
    why: dict[str, list[str]] = {}
    for t in wp_test_files(root, wp):
        if t in changed:
            out.append(t)
            continue
        mods, strings = module_closure(root, t, own, changed)
        hits = sorted(mods & changed) + [f for f in data if _data_referenced(f, own, strings)]
        if hits:
            out.append(t)
            why[t] = hits
    return out, why


def cmd_tests_correction(root: Path, wp: str, base: str, head: str) -> int:
    """MODE tests-correction (module docstring): unchanged test files must
    pass; changed test files may fail, but only for a right reason."""
    step = "tests-correction"
    if not test_dir(root, wp).is_dir():
        return fail(step, f"no tests at tests/accept/{lanedlib.wp_dir(wp)}/")
    paths = read_paths(root, wp)
    if paths is None:
        return fail(step, "no PATHS file")
    if not built_on(root, base, wp):
        return fail(step, f"{wp} has no implementation on {base}; a tests-only PR runs --expect-fail")
    if step_invariant10(root, wp):
        return 1
    diff = lanedlib.git(root, "diff", "--name-only", f"{base}...{head}").stdout.split()
    all_tests = wp_test_files(root, wp)
    changed, indirect = changed_test_files(root, wp, diff)
    unchanged = [p for p in all_tests if p not in changed]
    for t, hits in sorted(indirect.items()):
        print(f"changed via dependency {t}: " + " ".join(hits))
    print(f"{step}: {len(changed)} changed test file(s) ({len(indirect)} via a changed helper, "
          f"conftest or fixture), {len(unchanged)} unchanged")
    if unchanged:
        proc = run_pytest(root, wp, [], env=evidence_env(root, None), targets=unchanged)
        sys.stdout.write(proc.stdout[-20000:])
        sys.stderr.write(proc.stderr[-5000:])
        if proc.returncode not in (0, 5):  # 5: the files collect no test
            return fail(step, f"a test the PR does not change fails (pytest exit {proc.returncode})")
        print("ok unchanged tests pass")
    right = 0
    if changed:
        res = classify_run(root, wp, paths, targets=changed)
        if isinstance(res, str):
            return fail(step, res)
        collected, passed, right, wrong = res
        print(f"{step}: changed tests {collected} collected, {passed} passed, "
              f"{right} right-reason, {wrong} wrong-reason")
        if wrong:
            return fail(step, f"{wrong} failure(s) for a wrong reason")
    if right:
        print(f"MODE tests-correction PASS ({right} changed test(s) fail for a right reason, "
              "pending an implementation PR)")
    else:
        print("MODE tests-correction PASS")
    print(f"PASS {wp} tests-correction")
    return 0


