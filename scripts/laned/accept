#!/usr/bin/env python3
"""Lane D Accept (plan §3 conventions, §3.1, invariant 10, §17.2).

    accept <WP> [--evidence FILE] [--root R]
        invariant10 -> pytest tests/accept/<wp>/ -> stub_scan over PATHS
        -> make laned-e2e (when the Makefile defines it) -> evidence
        With --evidence, pytest and e2e see LANED_EVIDENCE=<abs FILE>: the
        WP's own tests verify the evidence content (plan §3, §17.1 L4).
    accept <WP> --expect-fail [--root R]
        tests-only PRs for an unbuilt WP: tests collected and failing for a
        right reason only
    accept <WP> --verification --base REF --head REF [--root R]
        the run for MODE tests-only: MODE verification when it applies (rules
        below), else exactly --expect-fail
    accept <WP> --tests-correction --base REF --head REF [--root R]
        tests-only PRs for a WP already built on BASE (see MODE rules below)
    accept <WP> --check-pr --base REF --head REF [--root R]
        rule 1 and the WP's PATHS over `git diff --name-only BASE...HEAD`;
        prints the MODE the PR job runs next (rules below);
        for a review WP RV<n>: MODE review iff the diff is exactly an add or
        modify of evidence/rv<n>.md (no tests run)
    accept <WP>[,<WP>...] --cross --base REF --head REF [--root R]
        cross-WP regressions (CROSS rule below); prints `CROSS <WP> PASS|FAIL`
    accept selftest
        offline check of the review, tests-correction, verification,
        evidence and cross modes
    accept --gate <STAGE> [--root R]
        evidence/gates/<stage>.json: right stage, every check passed

MODE rules of --check-pr (the PR job runs the named mode next):
    MODE implementation   the diff has no tests/accept/ path and stays inside
                          the WP's PATHS -> full Accept
    MODE tests-only       the diff touches only tests/accept/<wp>/ and BASE has
                          no implementation of the WP (no L2 commit on BASE's
                          first-parent line: a commit after the one adding
                          PATHS that changes non-test files, all inside PATHS)
                          -> --verification (below), which is --expect-fail
                          over the WP's whole test dir unless the PR is a
                          verification PR
    MODE verification     printed by --verification, not by --check-pr: a
                          tests-only PR for a VERIFICATION WP, one whose row
                          only asserts properties of code another WP already
                          built. It applies iff (a) BASE has no L2 commit for
                          the WP, (b) every non-test entry of the WP's PATHS
                          already exists on BASE (an exact file; some file
                          under a dir/ entry; some file matching a glob) and
                          (c) the full Accept (invariant10, pytest, stub_scan
                          over PATHS, e2e) passes on the PR's tests over BASE's
                          code. Then it prints `MODE verification` and passes;
                          the ledger records mode `verification` with
                          `tests_tree` (tree sha of tests/accept/<wp>/ at HEAD).
                          A PATHS entry missing on BASE (or a PATHS file with no
                          non-test entry) never gives verification; any failing
                          Accept step falls back to --expect-fail semantics
                          (at least one right-reason failure), recorded as
                          mode `expect-fail`, so a normal tests-only PR still
                          works. On merge the status board treats the merge
                          commit (the first first-parent commit changing only
                          tests/accept/<wp>/ whose test dir has that
                          tests_tree) as both L1 and L2 for the WP; the
                          push-to-main Accept run then gives L3 as usual.
    MODE tests-correction the diff touches only tests/accept/<wp>/ and BASE
                          already has the WP's implementation (L2 commit found)
                          -> --tests-correction: every test file the PR does
                          NOT change must pass against BASE's implementation;
                          the test files it changes run in expect-fail
                          classification: each failure must be for a right
                          reason (it is pending a follow-up implementation
                          PR), and all of them passing is fine. Any
                          wrong-reason failure, or any failure in an
                          unchanged test file, fails the PR.
                          A test file counts as changed when the PR adds or
                          edits it, or any file in its static closure inside
                          tests/accept/<wp>/: modules it imports (relative,
                          or absolute resolving into the WP dir; transitive),
                          ancestor conftest.py / __init__.py in the WP dir,
                          and non-.py files under the WP dir named by a string
                          constant in that closure (basename, WP-dir-relative
                          path, or a containing directory such as "fixtures").
    MODE evidence         the diff only adds or modifies evidence files named
                          by `--evidence <file>` in the WP's §3.0 Accept cell
                          (plan at BASE); check-pr prints `EVIDENCE <file>`
                          per file -> `accept <WP> --evidence <file>` for each,
                          recorded in the ledger as mode `evidence` with the
                          file's blob sha (the push to main then re-runs it as
                          push/accept --evidence, which is what L4 reads).
                          A declared evidence file together with any other
                          path, a deletion, or an evidence/-only diff naming a
                          file the Accept cell does not declare (and PATHS do
                          not cover) -> FAIL evidence.
    MODE review           RV<n> label, the diff is exactly evidence/rv<n>.md

CROSS rule (the PR job runs it after the PR's own WP steps, every mode but
review): a WP other than the PR's own WP(s) is re-accepted when
    (a) it is built on BASE: tests/accept/<wp>/PATHS exists at BASE and BASE's
        first-parent line has its L2 commit (lanedlib.impl_commit_index, the
        board's L2 rule; the board's L1 ledger precondition is not re-checked,
        so a WP in doubt is included), and
    (b) its tests depend on `git diff --name-only BASE...HEAD`: the diff touches
        a global input (pyproject.toml, uv.lock, tests/conftest.py, ...), its
        own test dir, a path its PATHS match, a repo module in the static
        import closure of its test dir (AST, transitive through repo modules
        and package __init__.py; absolute imports resolve from the repo root,
        the importing file's dir, tests/accept and tests), or a path named by a
        string constant in its test files ("cascade/x/y.json", "chain.toml").
The tests-correction / tests-only / verification WP X of the PR is its own
main step, so X is never a cross WP. A cross WP runs invariant 10, pytest over
its test dir (all cross WPs in one pytest run, split only where two
non-package test dirs share a module basename) and stub_scan over its PATHS;
no e2e (the main step ran it). A failure the junit report cannot attribute to
one WP fails every WP of that run.

The pytest command is `uv run --frozen pytest` unless LANED_PYTEST_CMD is set
(shlex-split). It always runs with cwd = --root. Exit 0 means pass.
"""

from __future__ import annotations

import argparse
import ast
import contextlib
import io
import os
import posixpath
import re
import shlex
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))  # `python -P` drops the script dir
import lanedlib  # noqa: E402
import stub_scan  # noqa: E402

UNARMED = "unchanged_when_unarmed"
ARMED = "armed_nonempty_lane_d_effect"
DEF_RE = re.compile(r"^\s*(?:async\s+)?def\s+(test\w*)\s*\(", re.M)
PROTECTED = ("docs/plans/LANE_D_PLAN.md", "docs/plans/STATUS.md", "status/laned_build.json")
TOOLING_WP = "W0c"


def fail(step: str, detail: str = "") -> int:
    print(f"FAIL {step}" + (f": {detail}" if detail else ""))
    return 1


def pytest_cmd() -> list[str]:
    env = os.environ.get("LANED_PYTEST_CMD")
    return shlex.split(env) if env else ["uv", "run", "--frozen", "pytest"]


def test_dir(root: Path, wp: str) -> Path:
    return root / "tests" / "accept" / lanedlib.wp_dir(wp)


def read_paths(root: Path, wp: str) -> list[str] | None:
    pf = test_dir(root, wp) / "PATHS"
    return lanedlib.parse_paths(pf.read_text()) if pf.is_file() else None


# ---------------------------------------------------------------------------
# invariant 10
# ---------------------------------------------------------------------------

def unpaired_tests(root: Path, wp: str) -> list[str]:
    names: set[str] = set()
    for f in sorted(test_dir(root, wp).rglob("test_*.py")):
        names.update(DEF_RE.findall(f.read_text(encoding="utf-8", errors="replace")))
    return sorted(n for n in names if UNARMED in n and n.replace(UNARMED, ARMED) not in names)


def step_invariant10(root: Path, wp: str) -> int:
    missing = unpaired_tests(root, wp)
    if missing:
        for name in missing:
            print(f"unpaired {name} (needs {name.replace(UNARMED, ARMED)})")
        return fail("invariant10", f"{len(missing)} unpaired unarmed test(s)")
    print("ok invariant10")
    return 0


# ---------------------------------------------------------------------------
# accept
# ---------------------------------------------------------------------------

def run_pytest(root: Path, wp: str, extra: list[str],
               env: dict[str, str] | None = None,
               targets: list[str] | None = None) -> subprocess.CompletedProcess:
    """pytest over the WP's test dir, or over ``targets`` (root-relative files)."""
    rel = targets if targets is not None else [f"tests/accept/{lanedlib.wp_dir(wp)}/"]
    cmd = pytest_cmd() + ["-q", *extra, *rel]
    print("+ " + shlex.join(cmd), flush=True)
    return subprocess.run(cmd, cwd=str(root), capture_output=True, text=True, env=env)


def evidence_env(root: Path, evidence: str | None) -> dict[str, str]:
    """The WP's tests own the evidence content verifier: with --evidence they
    see the file as LANED_EVIDENCE (absolute path); without it the variable is
    removed so a stale value from the caller never leaks in."""
    env = dict(os.environ)
    env.pop("LANED_EVIDENCE", None)
    if evidence:
        env["LANED_EVIDENCE"] = str(lanedlib.resolve(root, evidence).resolve())
    return env


def step_evidence(root: Path, wp: str, evidence: str) -> int:
    path = lanedlib.resolve(root, evidence)
    text = path.read_text(encoding="utf-8") if path.is_file() else None
    ok, why = lanedlib.check_evidence(text, path.name, wp)
    if not ok:
        return fail("evidence", f"{evidence}: {why}")
    print(f"ok evidence {evidence}")
    return 0


def makefile_has_target(root: Path, target: str) -> bool:
    for name in ("GNUmakefile", "makefile", "Makefile"):
        mf = root / name
        if mf.is_file():
            return bool(re.search(rf"^{re.escape(target)}\s*:", mf.read_text(), re.M))
    return False


def cmd_accept(root: Path, wp: str, evidence: str | None) -> int:
    if not test_dir(root, wp).is_dir():
        return fail("pytest", f"no tests at tests/accept/{lanedlib.wp_dir(wp)}/")
    if step_invariant10(root, wp):
        return 1
    env = evidence_env(root, evidence)
    proc = run_pytest(root, wp, [], env=env)
    sys.stdout.write(proc.stdout[-20000:])
    sys.stderr.write(proc.stderr[-5000:])
    if proc.returncode != 0:
        return fail("pytest", f"exit {proc.returncode}")
    print("ok pytest")
    paths = read_paths(root, wp)
    if paths is None:
        return fail("stub_scan", "no PATHS file")
    lines, scanned = stub_scan.scan(root, paths)
    for line in lines:
        print(line)
    if lines:
        return fail("stub_scan", f"{len(lines)} finding(s)")
    print(f"ok stub_scan ({scanned} file(s))")
    if makefile_has_target(root, "laned-e2e"):
        proc = subprocess.run(["make", "laned-e2e"], cwd=str(root), capture_output=True, text=True, env=env)
        sys.stdout.write(proc.stdout[-20000:])
        sys.stderr.write(proc.stderr[-5000:])
        if proc.returncode != 0:
            return fail("e2e", f"make laned-e2e exit {proc.returncode}")
        print("ok e2e")
    if evidence and step_evidence(root, wp, evidence):
        return 1
    print(f"PASS {wp}")
    return 0


# ---------------------------------------------------------------------------
# expect-fail
# ---------------------------------------------------------------------------

NO_MODULE = re.compile(r"No module named '([\w.]+)'")
CANNOT_IMPORT = re.compile(r"cannot import name '(\w+)' from '([\w.]+)'")
NO_ATTR = re.compile(r"module '([\w.]+)' has no attribute '(\w+)'")
SYNTAX = re.compile(r"\b(SyntaxError|IndentationError|TabError)\b")
FIXTURE = re.compile(r"fixture '[^']+' not found")


def classify(kind: str, text: str, paths: list[str]) -> tuple[bool, str]:
    """(right reason?, explanation) for one failed or errored test case."""
    m = NO_MODULE.search(text)
    if m:
        mod = m.group(1)
        return lanedlib.module_in_paths(mod, paths), f"missing module {mod}"
    m = CANNOT_IMPORT.search(text) or NO_ATTR.search(text)
    if m:
        if m.re is CANNOT_IMPORT:
            name, mod = m.group(1), m.group(2)
        else:
            mod, name = m.group(1), m.group(2)
        ok = lanedlib.module_in_paths(f"{mod}.{name}", paths) or lanedlib.module_in_paths(mod, paths)
        return ok, f"missing {mod}.{name}"
    if SYNTAX.search(text):
        return False, "syntax error"
    if FIXTURE.search(text):
        return False, "fixture error"
    if kind == "error":
        return False, "error outside a test body"
    if "AssertionError" in text:
        return True, "assertion failure"
    return False, "failure that is not an assertion"


def classify_run(root: Path, wp: str, paths: list[str],
                 targets: list[str] | None = None) -> tuple[int, int, int, int] | str:
    """Run pytest (whole test dir, or ``targets``) and classify every failure:
    (collected, passed, right-reason, wrong-reason), or an error string."""
    with tempfile.TemporaryDirectory(prefix="laned-xf-") as tmp:
        junit = Path(tmp) / "junit.xml"
        proc = run_pytest(root, wp, [f"--junitxml={junit}", "--continue-on-collection-errors"],
                          env=evidence_env(root, None), targets=targets)
        sys.stdout.write(proc.stdout[-20000:])
        if not junit.is_file():
            sys.stderr.write(proc.stderr[-5000:])
            return f"pytest wrote no report (exit {proc.returncode})"
        tree = ET.parse(junit)
    cases = list(tree.iter("testcase"))
    right = wrong = passed = 0
    for case in cases:
        name = f"{case.get('classname', '')}::{case.get('name', '')}"
        bad = [(child.tag, (child.get("message") or "") + "\n" + (child.text or ""))
               for child in case if child.tag in ("failure", "error")]
        if not bad:
            if not any(child.tag == "skipped" for child in case):
                passed += 1
            continue
        for kind, text in bad:
            ok, why = classify(kind, text, paths)
            print(f"{'right' if ok else 'WRONG'} {kind} {name}: {why}")
            if ok:
                right += 1
            else:
                wrong += 1
    return len(cases), passed, right, wrong


def cmd_expect_fail(root: Path, wp: str) -> int:
    if not test_dir(root, wp).is_dir():
        return fail("expect-fail", f"no tests at tests/accept/{lanedlib.wp_dir(wp)}/")
    paths = read_paths(root, wp)
    if paths is None:
        return fail("expect-fail", "no PATHS file")
    if step_invariant10(root, wp):
        return 1
    res = classify_run(root, wp, paths)
    if isinstance(res, str):
        return fail("expect-fail", res)
    collected, passed, right, wrong = res
    if not collected:
        return fail("expect-fail", "no tests collected")
    print(f"expect-fail: {collected} collected, {passed} passed, {right} right-reason, {wrong} wrong-reason")
    if wrong:
        return fail("expect-fail", f"{wrong} failure(s) for a wrong reason")
    if not right:
        return fail("expect-fail", "no test fails for a right reason")
    print(f"PASS {wp} expect-fail")
    return 0


# ---------------------------------------------------------------------------
# verification (a tests-only PR whose tests pass on code already built)
# ---------------------------------------------------------------------------

def cmd_verification(root: Path, wp: str, base: str, head: str) -> int:
    """The run for MODE tests-only (module docstring, "MODE verification").

    Verification applies only when BASE has no L2 commit for the WP and every
    non-test PATHS entry already exists on BASE; then the full Accept runs on
    the working tree (the PR's tests over BASE's code). If it passes this is
    ``MODE verification``. In every other case (a PATHS file missing on BASE,
    or any Accept step failing) the run is the classic ``--expect-fail``.
    The last line before the result names the ledger mode: ``LEDGER-MODE
    verification`` (with ``TESTS-TREE <sha>`` of tests/accept/<wp>/ at HEAD)
    or ``LEDGER-MODE expect-fail``."""
    paths = read_paths(root, wp)
    if paths is None or not test_dir(root, wp).is_dir():
        print("LEDGER-MODE expect-fail")
        return cmd_expect_fail(root, wp)
    if built_on(root, base, wp):
        return fail("verification", f"{wp} is already built on {base}; a tests-only PR runs --tests-correction")
    missing = lanedlib.missing_paths_at(root, base, paths)
    if missing:
        print(f"verification: not a verification WP (missing on {base}: {' '.join(missing)}); "
              "running --expect-fail")
        print("LEDGER-MODE expect-fail")
        return cmd_expect_fail(root, wp)
    print(f"verification: every non-test PATHS entry exists on {base}; running the full Accept")
    if cmd_accept(root, wp, None) == 0:
        tree = lanedlib.wp_tree_at(root, head, wp)
        if tree is None:
            return fail("verification", f"no tests/accept/{lanedlib.wp_dir(wp)}/ at {head}")
        print(f"TESTS-TREE {tree}")
        print("LEDGER-MODE verification")
        print("MODE verification")
        print(f"PASS {wp} verification")
        return 0
    print("verification: the full Accept failed; falling back to --expect-fail")
    print("LEDGER-MODE expect-fail")
    return cmd_expect_fail(root, wp)


# ---------------------------------------------------------------------------
# check-pr
# ---------------------------------------------------------------------------

def paths_at(root: Path, ref: str, wp: str) -> list[str] | None:
    rel = f"tests/accept/{lanedlib.wp_dir(wp)}/PATHS"
    proc = lanedlib.git(root, "show", f"{ref}:{rel}", check=False)
    if proc.returncode == 0:
        return lanedlib.parse_paths(proc.stdout)
    return read_paths(root, wp)


REVIEW_WP = re.compile(r"^RV(\d+)$")


def cmd_check_pr_review(root: Path, wp: str, n: str, base: str, head: str) -> int:
    """A review PR (label laned:RV<n>) adds or edits exactly evidence/rv<n>.md."""
    want = f"evidence/rv{n}.md"
    out = lanedlib.git(root, "diff", "--no-renames", "--name-status", f"{base}...{head}").stdout
    changes = [tuple(line.split("\t", 1)) for line in out.splitlines() if line.strip()]
    if not changes:
        return fail("review", "the PR changes nothing")
    bad = [f"{s} {p}" for s, p in changes if p != want or s not in ("A", "M")]
    if bad:
        return fail("review", f"a {wp} PR may only add or modify {want}; it also has: " + " ".join(bad))
    print("MODE review")
    return 0


def plan_at(root: Path, ref: str) -> str | None:
    """The plan at ``ref`` (the PR cannot edit it: PROTECTED), else the working tree's."""
    proc = lanedlib.git(root, "show", f"{ref}:{lanedlib.PLAN_PATH}", check=False)
    if proc.returncode == 0:
        return proc.stdout
    p = root / lanedlib.PLAN_PATH
    return p.read_text(encoding="utf-8") if p.is_file() else None


def declared_evidence(root: Path, ref: str, wp: str) -> list[str]:
    """The evidence files named by ``--evidence`` in the WP's §3.0 Accept cell at ``ref``."""
    text = plan_at(root, ref)
    return lanedlib.accept_evidence_files(text, wp) if text else []


def cmd_check_pr_evidence(root: Path, wp: str, base: str, head: str,
                          diff: list[str]) -> int | None:
    """MODE evidence (module docstring), or None when the PR is not an evidence PR.

    An evidence PR adds or modifies only evidence files named in the WP's
    Accept cell (plan at BASE). Touching one of them together with anything
    else, deleting one, or an evidence/-only diff naming a file the Accept cell
    does not declare (and the WP's PATHS do not cover) fails ``FAIL evidence``."""
    declared = declared_evidence(root, base, wp)
    out = lanedlib.git(root, "diff", "--no-renames", "--name-status", f"{base}...{head}").stdout
    changes = [tuple(line.split("\t", 1)) for line in out.splitlines() if "\t" in line]
    touched = [p for _, p in changes if p in declared]
    if touched:
        bad = [f"{s} {p}" for s, p in changes if p not in declared or s not in ("A", "M")]
        if bad:
            return fail("evidence", f"an evidence PR for {wp} may only add or modify "
                        + " ".join(declared) + "; it also has: " + " ".join(bad))
        print("MODE evidence")
        for p in touched:
            print(f"EVIDENCE {p}")
        return 0
    if diff and all(p.startswith("evidence/") for p in diff):
        paths = paths_at(root, base, wp) or paths_at(root, head, wp) or []
        if not all(lanedlib.path_matches(p, paths) for p in diff):
            named = " ".join(declared) if declared else "none"
            return fail("evidence", f"not an evidence file named in {wp}'s Accept cell "
                        f"(declared: {named}): " + " ".join(sorted(diff)))
    return None


def cmd_check_pr(root: Path, wp: str, base: str, head: str) -> int:
    m = REVIEW_WP.match(wp)
    if m:
        return cmd_check_pr_review(root, wp, m.group(1), base, head)
    diff = lanedlib.git(root, "diff", "--name-only", f"{base}...{head}").stdout.split()
    if not diff:
        return fail("paths", "the PR changes nothing")
    rc = cmd_check_pr_evidence(root, wp, base, head, diff)
    if rc is not None:
        return rc
    tests = [p for p in diff if p.startswith("tests/accept/")]
    others = [p for p in diff if not p.startswith("tests/accept/")]
    if tests and others:
        return fail("rule1", "tests/accept/ edited together with: " + " ".join(others))
    if tests:
        own = f"tests/accept/{lanedlib.wp_dir(wp)}/"
        foreign = [p for p in tests if not p.startswith(own)]
        if foreign:
            return fail("rule1", f"tests-only PR for {wp} touches another WP's tests: " + " ".join(foreign))
        # MODE rules (module docstring): a WP already built on BASE gets a
        # tests-correction run, an unbuilt one the classic expect-fail run.
        print("MODE tests-correction" if built_on(root, base, wp) else "MODE tests-only")
        return 0
    paths = paths_at(root, base, wp) or paths_at(root, head, wp)
    if not paths:
        return fail("paths", f"no tests/accept/{lanedlib.wp_dir(wp)}/PATHS")
    outside = [p for p in diff if not lanedlib.path_matches(p, paths)]
    if wp != TOOLING_WP:
        outside += [p for p in diff if p.startswith("scripts/laned/") and p not in outside]
    outside += [p for p in diff if p in PROTECTED and p not in outside]
    if outside:
        return fail("paths", "outside the WP's PATHS: " + " ".join(sorted(outside)))
    print("MODE implementation")
    return 0


# ---------------------------------------------------------------------------
# tests-correction (a tests-only PR for a WP already built on BASE)
# ---------------------------------------------------------------------------

def built_on(root: Path, ref: str, wp: str) -> bool:
    """True when ``ref`` carries the WP's implementation: its first-parent
    line has the L2 commit (the status board's rule, lanedlib.impl_commit_index)
    for the PATHS file at ``ref``. No PATHS at ``ref`` means a new WP."""
    rel = f"tests/accept/{lanedlib.wp_dir(wp)}/PATHS"
    proc = lanedlib.git(root, "show", f"{ref}:{rel}", check=False)
    if proc.returncode != 0:
        return False
    history = lanedlib.first_parent_history(root, ref)
    return lanedlib.impl_commit_index(history, wp, lanedlib.parse_paths(proc.stdout)) is not None


def is_test_file(rel: str) -> bool:
    name = rel.rsplit("/", 1)[-1]
    return name.endswith(".py") and (name.startswith("test_") or name.endswith("_test.py"))


def wp_test_files(root: Path, wp: str) -> list[str]:
    d = test_dir(root, wp)
    return sorted(p.relative_to(root).as_posix() for p in d.rglob("*.py")
                  if is_test_file(p.name) and "__pycache__" not in p.parts)


def _module_files(base: str, dotted: str) -> list[str]:
    """Candidate files for module ``a.b`` under dir ``base``: every prefix as
    ``.py`` or a package ``__init__.py`` (importing ``a.b`` runs ``a`` too)."""
    parts = [p for p in dotted.split(".") if p]
    out: list[str] = []
    for i in range(1, len(parts) + 1):
        stem = posixpath.normpath(posixpath.join(base or ".", *parts[:i]))
        out += [stem + ".py", stem + "/__init__.py"]
    return out


def _module_refs(rel: str, text: str, own_dir: str,
                 extra_bases: tuple[str, ...] = ()) -> tuple[list[str], set[str]]:
    """(candidate module files ``rel`` imports, its string constants) by AST."""
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return [], set()
    here = posixpath.dirname(rel)
    # absolute imports resolve against the repo root (package mode), the
    # module's own dir (pytest rootdir-less prepend) and the WP dir
    bases = ("", here, own_dir.rstrip("/"), *extra_bases)
    cands: list[str] = []
    strings: set[str] = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                for b in bases:
                    cands += _module_files(b, alias.name)
        elif isinstance(node, ast.ImportFrom):
            mod = node.module or ""
            if node.level:
                base = here
                for _ in range(node.level - 1):
                    base = posixpath.dirname(base)
                roots: tuple[str, ...] = (base,)
                cands.append(posixpath.normpath(posixpath.join(base or ".", "__init__.py")))
            else:
                roots = bases
            for b in roots:
                if mod:
                    cands += _module_files(b, mod)
                for alias in node.names:
                    cands += _module_files(b, f"{mod}.{alias.name}" if mod else alias.name)
        elif isinstance(node, ast.Constant) and isinstance(node.value, str):
            strings.add(node.value)
    return cands, strings


def _data_referenced(f: str, own_dir: str, strings: set[str]) -> bool:
    """Is the (non-.py) WP-dir file ``f`` named by one of the string constants?
    A constant matches the file's basename, its path relative to the WP dir or
    the repo, or a directory containing it (``"fixtures"``)."""
    rel = f[len(own_dir):]
    base = posixpath.basename(f)
    for s in strings:
        s = s.strip().strip("/")
        if not s or s == "." or "\n" in s:
            continue
        if s in (base, rel, f) or rel.startswith(s + "/") or f.startswith(s + "/") \
                or rel.endswith("/" + s):
            return True
    return False


def module_closure(root: Path, test_rel: str, own_dir: str,
                      changed: set[str]) -> tuple[set[str], set[str]]:
    """Static closure of one test module inside the WP dir ``own_dir``:
    (module files it depends on, string constants in them). Ancestor
    ``conftest.py`` / ``__init__.py`` files inside the WP dir count too."""
    seen: set[str] = set()
    strings: set[str] = set()
    todo = [test_rel]
    d = posixpath.dirname(test_rel)
    while d.startswith(own_dir.rstrip("/")):
        todo += [f"{d}/conftest.py", f"{d}/__init__.py"]
        d = posixpath.dirname(d)
    while todo:
        rel = todo.pop()
        if rel in seen or not rel.startswith(own_dir):
            continue
        path = root / rel
        if not path.is_file() and rel not in changed:
            continue
        seen.add(rel)
        if not path.is_file():
            continue
        cands, consts = _module_refs(rel, path.read_text(encoding="utf-8", errors="replace"), own_dir)
        strings |= consts
        todo += [c for c in cands if c not in seen]
    return seen, strings


def changed_test_files(root: Path, wp: str, diff: list[str]) -> tuple[list[str], dict[str, list[str]]]:
    """Test files the PR changes: edited/added directly, or one whose static
    closure inside tests/accept/<wp>/ (imported helpers, conftest, package
    __init__, fixture files it names) has a changed file. Returns the list and
    ``{test: [changed dependency, ...]}`` for the indirect ones."""
    own = f"tests/accept/{lanedlib.wp_dir(wp)}/"
    changed = {p for p in diff if p.startswith(own)}
    data = sorted(p for p in changed if not p.endswith(".py"))
    out: list[str] = []
    why: dict[str, list[str]] = {}
    for t in wp_test_files(root, wp):
        if t in changed:
            out.append(t)
            continue
        mods, strings = module_closure(root, t, own, changed)
        hits = sorted(mods & changed) + [f for f in data if _data_referenced(f, own, strings)]
        if hits:
            out.append(t)
            why[t] = hits
    return out, why


def cmd_tests_correction(root: Path, wp: str, base: str, head: str) -> int:
    """MODE tests-correction (module docstring): unchanged test files must
    pass; changed test files may fail, but only for a right reason."""
    step = "tests-correction"
    if not test_dir(root, wp).is_dir():
        return fail(step, f"no tests at tests/accept/{lanedlib.wp_dir(wp)}/")
    paths = read_paths(root, wp)
    if paths is None:
        return fail(step, "no PATHS file")
    if not built_on(root, base, wp):
        return fail(step, f"{wp} has no implementation on {base}; a tests-only PR runs --expect-fail")
    if step_invariant10(root, wp):
        return 1
    diff = lanedlib.git(root, "diff", "--name-only", f"{base}...{head}").stdout.split()
    all_tests = wp_test_files(root, wp)
    changed, indirect = changed_test_files(root, wp, diff)
    unchanged = [p for p in all_tests if p not in changed]
    for t, hits in sorted(indirect.items()):
        print(f"changed via dependency {t}: " + " ".join(hits))
    print(f"{step}: {len(changed)} changed test file(s) ({len(indirect)} via a changed helper, "
          f"conftest or fixture), {len(unchanged)} unchanged")
    if unchanged:
        proc = run_pytest(root, wp, [], env=evidence_env(root, None), targets=unchanged)
        sys.stdout.write(proc.stdout[-20000:])
        sys.stderr.write(proc.stderr[-5000:])
        if proc.returncode not in (0, 5):  # 5: the files collect no test
            return fail(step, f"a test the PR does not change fails (pytest exit {proc.returncode})")
        print("ok unchanged tests pass")
    right = 0
    if changed:
        res = classify_run(root, wp, paths, targets=changed)
        if isinstance(res, str):
            return fail(step, res)
        collected, passed, right, wrong = res
        print(f"{step}: changed tests {collected} collected, {passed} passed, "
              f"{right} right-reason, {wrong} wrong-reason")
        if wrong:
            return fail(step, f"{wrong} failure(s) for a wrong reason")
    if right:
        print(f"MODE tests-correction PASS ({right} changed test(s) fail for a right reason, "
              "pending an implementation PR)")
    else:
        print("MODE tests-correction PASS")
    print(f"PASS {wp} tests-correction")
    return 0


