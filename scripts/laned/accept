# accept
# ---------------------------------------------------------------------------

def run_pytest(root: Path, wp: str, extra: list[str],
               env: dict[str, str] | None = None,
               targets: list[str] | None = None) -> subprocess.CompletedProcess:
    """pytest over the WP's test dir, or over ``targets`` (root-relative files)."""
    rel = targets if targets is not None else [f"tests/accept/{lanedlib.wp_dir(wp)}/"]
    cmd = pytest_cmd() + ["-q", *extra, *rel]
    print("+ " + shlex.join(cmd), flush=True)
    return subprocess.run(cmd, cwd=str(root), capture_output=True, text=True, env=env)


def evidence_env(root: Path, evidence: str | None) -> dict[str, str]:
    """The WP's tests own the evidence content verifier: with --evidence they
    see the file as LANED_EVIDENCE (absolute path); without it the variable is
    removed so a stale value from the caller never leaks in."""
    env = dict(os.environ)
    env.pop("LANED_EVIDENCE", None)
    if evidence:
        env["LANED_EVIDENCE"] = str(lanedlib.resolve(root, evidence).resolve())
    return env


def step_evidence(root: Path, wp: str, evidence: str) -> int:
    path = lanedlib.resolve(root, evidence)
    text = path.read_text(encoding="utf-8") if path.is_file() else None
    ok, why = lanedlib.check_evidence(text, path.name, wp)
    if not ok:
        return fail("evidence", f"{evidence}: {why}")
    print(f"ok evidence {evidence}")
    return 0


def makefile_has_target(root: Path, target: str) -> bool:
    for name in ("GNUmakefile", "makefile", "Makefile"):
        mf = root / name
        if mf.is_file():
            return bool(re.search(rf"^{re.escape(target)}\s*:", mf.read_text(), re.M))
    return False


def cmd_accept(root: Path, wp: str, evidence: str | None) -> int:
    if not test_dir(root, wp).is_dir():
        return fail("pytest", f"no tests at tests/accept/{lanedlib.wp_dir(wp)}/")
    if step_invariant10(root, wp):
        return 1
    env = evidence_env(root, evidence)
    proc = run_pytest(root, wp, [], env=env)
    sys.stdout.write(proc.stdout[-20000:])
    sys.stderr.write(proc.stderr[-5000:])
    if proc.returncode != 0:
        return fail("pytest", f"exit {proc.returncode}")
    print("ok pytest")
    paths = read_paths(root, wp)
    if paths is None:
        return fail("stub_scan", "no PATHS file")
    lines, scanned = stub_scan.scan(root, paths)
    for line in lines:
        print(line)
    if lines:
        return fail("stub_scan", f"{len(lines)} finding(s)")
    print(f"ok stub_scan ({scanned} file(s))")
    if makefile_has_target(root, "laned-e2e"):
        proc = subprocess.run(["make", "laned-e2e"], cwd=str(root), capture_output=True, text=True, env=env)
        sys.stdout.write(proc.stdout[-20000:])
        sys.stderr.write(proc.stderr[-5000:])
        if proc.returncode != 0:
            return fail("e2e", f"make laned-e2e exit {proc.returncode}")
        print("ok e2e")
    if evidence and step_evidence(root, wp, evidence):
        return 1
    print(f"PASS {wp}")
    return 0


# ---------------------------------------------------------------------------
# expect-fail
# ---------------------------------------------------------------------------

NO_MODULE = re.compile(r"No module named '([\w.]+)'")
CANNOT_IMPORT = re.compile(r"cannot import name '(\w+)' from '([\w.]+)'")
NO_ATTR = re.compile(r"module '([\w.]+)' has no attribute '(\w+)'")
SYNTAX = re.compile(r"\b(SyntaxError|IndentationError|TabError)\b")
FIXTURE = re.compile(r"fixture '[^']+' not found")


def classify(kind: str, text: str, paths: list[str]) -> tuple[bool, str]:
    """(right reason?, explanation) for one failed or errored test case."""
    m = NO_MODULE.search(text)
    if m:
        mod = m.group(1)
        return lanedlib.module_in_paths(mod, paths), f"missing module {mod}"
    m = CANNOT_IMPORT.search(text) or NO_ATTR.search(text)
    if m:
        if m.re is CANNOT_IMPORT:
            name, mod = m.group(1), m.group(2)
        else:
            mod, name = m.group(1), m.group(2)
        ok = lanedlib.module_in_paths(f"{mod}.{name}", paths) or lanedlib.module_in_paths(mod, paths)
        return ok, f"missing {mod}.{name}"
    if SYNTAX.search(text):
        return False, "syntax error"
    if FIXTURE.search(text):
        return False, "fixture error"
    if kind == "error":
        return False, "error outside a test body"
    if "AssertionError" in text:
        return True, "assertion failure"
    return False, "failure that is not an assertion"


def classify_run(root: Path, wp: str, paths: list[str],
                 targets: list[str] | None = None) -> tuple[int, int, int, int] | str:
    """Run pytest (whole test dir, or ``targets``) and classify every failure:
    (collected, passed, right-reason, wrong-reason), or an error string."""
    with tempfile.TemporaryDirectory(prefix="laned-xf-") as tmp:
        junit = Path(tmp) / "junit.xml"
        proc = run_pytest(root, wp, [f"--junitxml={junit}", "--continue-on-collection-errors"],
                          env=evidence_env(root, None), targets=targets)
        sys.stdout.write(proc.stdout[-20000:])
        if not junit.is_file():
            sys.stderr.write(proc.stderr[-5000:])
            return f"pytest wrote no report (exit {proc.returncode})"
        tree = ET.parse(junit)
    cases = list(tree.iter("testcase"))
    right = wrong = passed = 0
    for case in cases:
        name = f"{case.get('classname', '')}::{case.get('name', '')}"
        bad = [(child.tag, (child.get("message") or "") + "\n" + (child.text or ""))
               for child in case if child.tag in ("failure", "error")]
        if not bad:
            if not any(child.tag == "skipped" for child in case):
                passed += 1
            continue
        for kind, text in bad:
            ok, why = classify(kind, text, paths)
            print(f"{'right' if ok else 'WRONG'} {kind} {name}: {why}")
            if ok:
                right += 1
            else:
                wrong += 1
    return len(cases), passed, right, wrong


def cmd_expect_fail(root: Path, wp: str) -> int:
    if not test_dir(root, wp).is_dir():
        return fail("expect-fail", f"no tests at tests/accept/{lanedlib.wp_dir(wp)}/")
    paths = read_paths(root, wp)
    if paths is None:
        return fail("expect-fail", "no PATHS file")
    if step_invariant10(root, wp):
        return 1
    res = classify_run(root, wp, paths)
    if isinstance(res, str):
        return fail("expect-fail", res)
    collected, passed, right, wrong = res
    if not collected:
        return fail("expect-fail", "no tests collected")
    print(f"expect-fail: {collected} collected, {passed} passed, {right} right-reason, {wrong} wrong-reason")
    if wrong:
        return fail("expect-fail", f"{wrong} failure(s) for a wrong reason")
    if not right:
        return fail("expect-fail", "no test fails for a right reason")
    print(f"PASS {wp} expect-fail")
    return 0


# ---------------------------------------------------------------------------
# check-pr
# ---------------------------------------------------------------------------

def paths_at(root: Path, ref: str, wp: str) -> list[str] | None:
    rel = f"tests/accept/{lanedlib.wp_dir(wp)}/PATHS"
    proc = lanedlib.git(root, "show", f"{ref}:{rel}", check=False)
    if proc.returncode == 0:
        return lanedlib.parse_paths(proc.stdout)
    return read_paths(root, wp)


REVIEW_WP = re.compile(r"^RV(\d+)$")


def cmd_check_pr_review(root: Path, wp: str, n: str, base: str, head: str) -> int:
    """A review PR (label laned:RV<n>) adds or edits exactly evidence/rv<n>.md."""
    want = f"evidence/rv{n}.md"
    out = lanedlib.git(root, "diff", "--no-renames", "--name-status", f"{base}...{head}").stdout
    changes = [tuple(line.split("\t", 1)) for line in out.splitlines() if line.strip()]
    if not changes:
        return fail("review", "the PR changes nothing")
    bad = [f"{s} {p}" for s, p in changes if p != want or s not in ("A", "M")]
    if bad:
        return fail("review", f"a {wp} PR may only add or modify {want}; it also has: " + " ".join(bad))
    print("MODE review")
    return 0


def cmd_check_pr(root: Path, wp: str, base: str, head: str) -> int:
    m = REVIEW_WP.match(wp)
    if m:
        return cmd_check_pr_review(root, wp, m.group(1), base, head)
    diff = lanedlib.git(root, "diff", "--name-only", f"{base}...{head}").stdout.split()
    if not diff:
        return fail("paths", "the PR changes nothing")
    tests = [p for p in diff if p.startswith("tests/accept/")]
    others = [p for p in diff if not p.startswith("tests/accept/")]
    if tests and others:
        return fail("rule1", "tests/accept/ edited together with: " + " ".join(others))
    if tests:
        own = f"tests/accept/{lanedlib.wp_dir(wp)}/"
        foreign = [p for p in tests if not p.startswith(own)]
        if foreign:
            return fail("rule1", f"tests-only PR for {wp} touches another WP's tests: " + " ".join(foreign))
        # MODE rules (module docstring): a WP already built on BASE gets a
        # tests-correction run, an unbuilt one the classic expect-fail run.
        print("MODE tests-correction" if built_on(root, base, wp) else "MODE tests-only")
        return 0
    paths = paths_at(root, base, wp) or paths_at(root, head, wp)
    if not paths:
        return fail("paths", f"no tests/accept/{lanedlib.wp_dir(wp)}/PATHS")
    outside = [p for p in diff if not lanedlib.path_matches(p, paths)]
    if wp != TOOLING_WP:
        outside += [p for p in diff if p.startswith("scripts/laned/") and p not in outside]
    outside += [p for p in diff if p in PROTECTED and p not in outside]
    if outside:
        return fail("paths", "outside the WP's PATHS: " + " ".join(sorted(outside)))
    print("MODE implementation")
    return 0


# ---------------------------------------------------------------------------
# tests-correction (a tests-only PR for a WP already built on BASE)
# ---------------------------------------------------------------------------

def built_on(root: Path, ref: str, wp: str) -> bool:
    """True when ``ref`` carries the WP's implementation: its first-parent
    line has the L2 commit (the status board's rule, lanedlib.impl_commit_index)
    for the PATHS file at ``ref``. No PATHS at ``ref`` means a new WP."""
    rel = f"tests/accept/{lanedlib.wp_dir(wp)}/PATHS"
    proc = lanedlib.git(root, "show", f"{ref}:{rel}", check=False)
    if proc.returncode != 0:
        return False
    history = lanedlib.first_parent_history(root, ref)
    return lanedlib.impl_commit_index(history, wp, lanedlib.parse_paths(proc.stdout)) is not None


def is_test_file(rel: str) -> bool:
    name = rel.rsplit("/", 1)[-1]
    return name.endswith(".py") and (name.startswith("test_") or name.endswith("_test.py"))


def wp_test_files(root: Path, wp: str) -> list[str]:
    d = test_dir(root, wp)
    return sorted(p.relative_to(root).as_posix() for p in d.rglob("*.py")
                  if is_test_file(p.name) and "__pycache__" not in p.parts)


def cmd_tests_correction(root: Path, wp: str, base: str, head: str) -> int:
    """MODE tests-correction (module docstring): unchanged test files must
    pass; changed test files may fail, but only for a right reason."""
    step = "tests-correction"
    if not test_dir(root, wp).is_dir():
        return fail(step, f"no tests at tests/accept/{lanedlib.wp_dir(wp)}/")
    paths = read_paths(root, wp)
    if paths is None:
        return fail(step, "no PATHS file")
    if not built_on(root, base, wp):
        return fail(step, f"{wp} has no implementation on {base}; a tests-only PR runs --expect-fail")
    if step_invariant10(root, wp):
        return 1
    own = f"tests/accept/{lanedlib.wp_dir(wp)}/"
    diff = lanedlib.git(root, "diff", "--name-only", f"{base}...{head}").stdout.split()
    all_tests = wp_test_files(root, wp)
    changed = [p for p in all_tests if p in diff and p.startswith(own)]
    unchanged = [p for p in all_tests if p not in changed]
    print(f"{step}: {len(changed)} changed test file(s), {len(unchanged)} unchanged")
    if unchanged:
        proc = run_pytest(root, wp, [], env=evidence_env(root, None), targets=unchanged)
        sys.stdout.write(proc.stdout[-20000:])
        sys.stderr.write(proc.stderr[-5000:])
        if proc.returncode not in (0, 5):  # 5: the files collect no test
            return fail(step, f"a test the PR does not change fails (pytest exit {proc.returncode})")
        print("ok unchanged tests pass")
    right = 0
    if changed:
        res = classify_run(root, wp, paths, targets=changed)
        if isinstance(res, str):
            return fail(step, res)
        collected, passed, right, wrong = res
        print(f"{step}: changed tests {collected} collected, {passed} passed, "
              f"{right} right-reason, {wrong} wrong-reason")
        if wrong:
            return fail(step, f"{wrong} failure(s) for a wrong reason")
    if right:
        print(f"MODE tests-correction PASS ({right} changed test(s) fail for a right reason, "
              "pending an implementation PR)")
    else:
        print("MODE tests-correction PASS")
    print(f"PASS {wp} tests-correction")
    return 0


