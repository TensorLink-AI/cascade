def selftest_batch_impl(ident: tuple[str, ...]) -> list[str]:
    """The BATCH IMPLEMENTATION rule of --check-pr (plan rev6.3 (b)), the
    per-WP Accept after it, the squash merge as each WP's L2 commit
    (built_on) and the tests-correction batch, on a real git repo."""
    failures: list[str] = []
    saved = os.environ.get("LANED_PYTEST_CMD")
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    # WP -> (PATHS, implementation files)
    wps = {"I1": ("pkg/i1.py\n", {"pkg/i1.py": "VALUE = 1\n"}),
           "I2": ("pkg/i2/\n", {"pkg/i2/__init__.py": "", "pkg/i2/mod.py": "VALUE = 1\n"}),
           "I3": ("pkg/i3_*.py\n", {"pkg/i3_core.py": "VALUE = 1\n"}),
           "I4": ("pkg/i4.py\n", {"pkg/i4.py": "VALUE = 1\n"}),
           "D1": ("pkg/d1.py\n", {"pkg/d1.py": "VALUE = 1\n"}),
           "D2": ("pkg/d2.py\n", {"pkg/d2.py": "VALUE = 1\n"}),
           "O1": ("pkg/\n", {"pkg/o1.py": "VALUE = 1\n"}),
           "X1": ("pkg/x1.py\n", {"pkg/x1.py": "VALUE = 1\n"})}
    mods = {"I1": "pkg.i1", "I2": "pkg.i2.mod", "I3": "pkg.i3_core", "I4": "pkg.i4",
            "D1": "pkg.d1", "D2": "pkg.d2", "O1": "pkg.o1", "X1": "pkg.x1"}

    def impl(*names: str) -> dict[str, str]:
        out: dict[str, str] = {}
        for n in names:
            out.update(wps[n][1])
        return out

    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-batchimpl-") as tmp:
            root = Path(tmp) / "repo"
            root.mkdir()

            def commit(files: dict[str, str], msg: str) -> str:
                for rel, text in files.items():
                    (root / rel).parent.mkdir(parents=True, exist_ok=True)
                    (root / rel).write_text(text)
                lanedlib.git(root, "add", "-A")
                lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
                return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

            lanedlib.git(root, "init", "-q")
            lanedlib.git(root, "checkout", "-q", "-b", "main")
            commit({lanedlib.PLAN_PATH: SELFTEST_BATCH_IMPL_PLAN, ".gitignore": "__pycache__/\n",
                    "README.md": "x\n", "pkg/__init__.py": ""}, "plan")
            for w, (paths, _) in wps.items():
                d = lanedlib.wp_dir(w)
                commit({f"tests/accept/{d}/PATHS": paths,
                        f"tests/accept/{d}/test_{d}.py": f"import {mods[w]}\n\n\ndef test_{d}():\n"
                                                         f"    assert {mods[w]}.VALUE == 1\n"}, f"tests {w}")
            base = lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

            def check(name: str, files: dict[str, str], labels: list[str] | None, wp: str,
                      start: str) -> tuple[int, str, str]:
                lanedlib.git(root, "checkout", "-q", "-B", name, start)
                head = commit(files, name)
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_check_pr(root, wp, start, head, labels)
                return rc, buf.getvalue(), head

            def want_batch(name: str, files: dict[str, str], labels: list[str], mode: str,
                           start: str) -> str:
                head = ""
                for wp in labels:
                    rc, out, head = check(f"{name}-{wp}", files, labels, wp, start)
                    lines = [ln for ln in out.splitlines() if ln.startswith(("BATCH ", "MODE "))]
                    if rc != 0 or lines != ["BATCH " + " ".join(labels), f"MODE {mode}"]:
                        failures.append(f"batch-impl {name}: {wp} rc={rc}, want BATCH + MODE {mode}: "
                                        f"{out.strip()}")
                return head

            def want_refused(name: str, files: dict[str, str], labels: list[str], want: str,
                             start: str = base) -> None:
                for wp in labels:
                    if REVIEW_WP.match(wp):
                        continue
                    rc, out, _ = check(f"{name}-{wp}", files, labels, wp, start)
                    if rc == 0 or want not in out or "MODE " in out:
                        failures.append(f"batch-impl {name}: {wp} rc={rc}, want {want}: {out.strip()}")

            want_batch("two", impl("I1", "I2"), ["I1", "I2"], "implementation", base)
            head3 = want_batch("three", impl("I1", "I2", "I3"), ["I1", "I2", "I3"], "implementation", base)
            # rev6.17 FEATURE rule: no size cap, overlap or dependency refusal
            want_batch("four", impl("I1", "I2", "I3", "I4"), ["I1", "I2", "I3", "I4"], "implementation", base)
            want_batch("overlap", impl("I1", "O1"), ["I1", "O1"], "implementation", base)
            want_batch("dep", impl("I1", "D1"), ["I1", "D1"], "implementation", base)
            want_batch("dep-transitive", impl("I1", "D2"), ["D2", "I1"], "implementation", base)
            want_batch("deps-unknown", impl("I1", "X1"), ["I1", "X1"], "implementation", base)
            want_refused("no-tests", {**impl("I1"), "pkg/n1.py": "VALUE = 1\n"}, ["I1", "N1"],
                         "FAIL rule1: batch-no-tests")
            want_refused("no-wp", {**impl("I1", "I2"), "README.md": "y\n"}, ["I1", "I2"],
                         "FAIL paths: batch-out-of-scope: outside every labelled WP's PATHS "
                         "(BASE + entries this PR adds): README.md")
            want_refused("tooling", {**impl("I1", "I2"), "scripts/laned/x.py": "X = 1\n"}, ["I1", "I2"],
                         "FAIL paths: batch-out-of-scope")
            want_refused("idle-label", impl("I1"), ["I1", "I2"], "FAIL rule1: batch-label-without-changes")
            want_refused("review-label", impl("I1"), ["I1", "RV9"], "FAIL rule1: batch-non-wp-label")
            # one label: unchanged (another WP's files are outside its PATHS)
            for labels in (None, ["I1"]):
                rc, out, _ = check("single", impl("I1", "I2"), labels, "I1", base)
                if rc == 0 or not out.startswith("FAIL paths: outside the WP's PATHS: pkg/i2/"):
                    failures.append(f"batch-impl single {labels}: rc={rc}: {out.strip()}")
            rc, out, _ = check("single-ok", impl("I1"), ["I1"], "I1", base)
            if rc != 0 or out != "MODE implementation\n":
                failures.append(f"batch-impl single-ok: rc={rc}: {out!r}")
            # each WP's own Accept passes on the batch head
            lanedlib.git(root, "checkout", "-q", head3)
            for wp in ("I1", "I2", "I3"):
                with contextlib.redirect_stdout(io.StringIO()) as buf, \
                        contextlib.redirect_stderr(io.StringIO()):
                    rc = cmd_accept(root, wp, None)
                if rc != 0:
                    failures.append(f"batch-impl accept {wp} failed: {buf.getvalue().strip()[-1500:]}")
            # the squash merge is each WP's L2 commit; a stray-file merge is not
            lanedlib.git(root, "checkout", "-q", "main")
            lanedlib.git(root, "merge", "-q", "--squash", head3)
            merged = commit({}, "feat: I1 I2 I3 (#2)")
            built = [w for w in ("I1", "I2", "I3", "I4") if built_on(root, merged, w)]
            if built != ["I1", "I2", "I3"]:
                failures.append(f"batch-impl squash: built {built}, want I1 I2 I3")
            stray = commit({"pkg/d1.py": "VALUE = 1\n", "pkg/x1.py": "VALUE = 1\n", "README.md": "z\n"}, "stray")
            if built_on(root, stray, "D1") or built_on(root, stray, "X1"):
                failures.append("batch-impl: a merge with a file in no WP's PATHS counted as L2")
            lanedlib.git(root, "reset", "-q", "--hard", merged)
            # tests-corrections batch: all built (<= 3) -> MODE tests-correction per WP
            more = {f"tests/accept/{lanedlib.wp_dir(w)}/test_more_{lanedlib.wp_dir(w)}.py": SELFTEST_PASSING
                    for w in ("I1", "I2")}
            head = want_batch("corrections", more, ["I1", "I2"], "tests-correction", merged)
            lanedlib.git(root, "checkout", "-q", head)
            for wp in ("I1", "I2"):
                with contextlib.redirect_stdout(io.StringIO()) as buf, \
                        contextlib.redirect_stderr(io.StringIO()):
                    rc = cmd_tests_correction(root, wp, merged, head)
                if rc != 0:
                    failures.append(f"batch-impl tests-correction {wp} failed: {buf.getvalue().strip()[-1500:]}")
            # rev6.17: built (I1) and unbuilt (D1) WPs mix, each with its own MODE
            for wp, mode in (("I1", "tests-correction"), ("D1", "tests-only")):
                rc, out, _ = check(f"mixed-{wp}", {"tests/accept/i1/test_more_i1.py": SELFTEST_PASSING,
                                                   "tests/accept/d1/test_more_d1.py": SELFTEST_PASSING},
                                   ["I1", "D1"], wp, merged)
                if rc != 0 or f"MODE {mode}\n" not in out:
                    failures.append(f"batch-impl mixed: {wp} rc={rc}, want MODE {mode}: {out.strip()}")
            lanedlib.git(root, "checkout", "-q", "main")
            four_base = commit(impl("I4"), "feat: I4 (#3)")
            want_batch("four-corrections",
                       {f"tests/accept/{lanedlib.wp_dir(w)}/test_more.py": SELFTEST_PASSING
                        for w in ("I1", "I2", "I3", "I4")},
                       ["I1", "I2", "I3", "I4"], "tests-correction", four_base)
    finally:
        if saved is None:
            os.environ.pop("LANED_PYTEST_CMD", None)
        else:
            os.environ["LANED_PYTEST_CMD"] = saved
    return failures


SELFTEST_COUPLED_PLAN = """# selftest plan

| WP | What | Depends | Runs in | Accept |
|---|---|---|---|---|
| C1 | producer | — | ci | `scripts/laned/accept C1` |
| C2 | draw | C1 | ci | `scripts/laned/accept C2` |
| C3 | report | — | ci | `scripts/laned/accept C3` |
| C4 | replay | C3 | ci | `scripts/laned/accept C4` |
| E1 | elsewhere | — | ci | `scripts/laned/accept E1` |
"""


def selftest_coupled(ident: tuple[str, ...]) -> list[str]:
    """Legacy COUPLED sets under the FEATURE rule (rev6.17): the declared set,
    subsets, supersets and undeclared sets all pass check-pr now (no size,
    dependency or overlap refusal); scope and idle-label refusals stay; a
    declared coupled-set squash merge is still each member's L2 commit
    (built_on, git-only), a partial one is not."""
    failures: list[str] = []
    saved = os.environ.get("LANED_PYTEST_CMD")
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    # C1, C2 and C4 share pkg/core.py (overlapping PATHS); C2 depends on C1
    # and C4 on C3.
    wps = {"C1": ("pkg/core.py\npkg/c1.py\n", "pkg.c1"),
           "C2": ("pkg/core.py\npkg/c2.py\n", "pkg.c2"),
           "C3": ("pkg/c3.py\n", "pkg.c3"),
           "C4": ("pkg/core.py\npkg/c4.py\n", "pkg.c4"),
           "E1": ("pkg/e1.py\n", "pkg.e1")}
    code = {f"pkg/{w.lower()}.py": "from pkg.core import VALUE  # noqa: F401\n" for w in wps}
    code["pkg/core.py"] = "VALUE = 1\n"
    members = ["C1", "C2", "C3", "C4"]
    declared = "# selftest\nC1 C2 C3 C4  # the coupled set\nE1\n"
    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-coupled-") as tmp:
            root = Path(tmp) / "repo"
            root.mkdir()

            def commit(files: dict[str, str], msg: str) -> str:
                for rel, text in files.items():
                    (root / rel).parent.mkdir(parents=True, exist_ok=True)
                    (root / rel).write_text(text)
                lanedlib.git(root, "add", "-A")
                lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
                return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

            lanedlib.git(root, "init", "-q")
            lanedlib.git(root, "checkout", "-q", "-b", "main")
            commit({lanedlib.PLAN_PATH: SELFTEST_COUPLED_PLAN, ".gitignore": "__pycache__/\n",
                    "README.md": "x\n", "pkg/__init__.py": ""}, "plan")
            for w, (paths, mod) in wps.items():
                d = lanedlib.wp_dir(w)
                commit({f"tests/accept/{d}/PATHS": paths,
                        f"tests/accept/{d}/test_{d}.py": f"import {mod}\n\n\ndef test_{d}():\n"
                                                         f"    assert {mod}.VALUE == 1\n"}, f"tests {w}")
            undeclared = lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()
            base = commit({lanedlib.COUPLED_BATCHES_PATH: declared}, "W0c: declare C1-C4 coupled")

            def impl(*names: str) -> dict[str, str]:
                out = {"pkg/core.py": code["pkg/core.py"]}
                out.update({f"pkg/{n.lower()}.py": code[f"pkg/{n.lower()}.py"] for n in names})
                return out

            def check(name: str, files: dict[str, str], labels: list[str], wp: str,
                      start: str) -> tuple[int, str, str]:
                lanedlib.git(root, "checkout", "-q", "-B", name, start)
                head = commit(files, name)
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_check_pr(root, wp, start, head, labels)
                return rc, buf.getvalue(), head

            def want_ok(name: str, files: dict[str, str], labels: list[str], start: str = base) -> str:
                head = ""
                for wp in labels:
                    rc, out, head = check(f"{name}-{wp}", files, labels, wp, start)
                    lines = [ln for ln in out.splitlines() if ln.startswith(("BATCH ", "MODE "))]
                    if rc != 0 or lines != ["BATCH " + " ".join(labels), "MODE implementation"] \
                            or "COUPLED " in out:
                        failures.append(f"coupled {name}: {wp} rc={rc}: {out.strip()}")
                return head

            def want_refused(name: str, files: dict[str, str], labels: list[str], want: str,
                             start: str = base) -> None:
                for wp in labels:
                    rc, out, _ = check(f"{name}-{wp}", files, labels, wp, start)
                    if rc == 0 or want not in out or "MODE " in out:
                        failures.append(f"coupled {name}: {wp} rc={rc}, want {want}: {out.strip()}")

            order = ["C3", "C1", "C4", "C2"]          # label order is free
            head = want_ok("exact-set", impl(*members), order)
            lanedlib.git(root, "checkout", "-q", head)
            for wp in members:
                with contextlib.redirect_stdout(io.StringIO()) as buf, \
                        contextlib.redirect_stderr(io.StringIO()):
                    rc = cmd_accept(root, wp, None)
                if rc != 0:
                    failures.append(f"coupled accept {wp} failed: {buf.getvalue().strip()[-1500:]}")
            # rev6.17: subsets, supersets and undeclared sets are feature PRs too
            want_ok("subset-dependent", impl("C1", "C2"), ["C1", "C2"])
            want_ok("subset-overlap", impl("C1", "C4"), ["C1", "C4"])
            want_ok("superset", {**impl(*members), "pkg/e1.py": code["pkg/e1.py"]}, [*members, "E1"])
            want_ok("undeclared", impl(*members), members, undeclared)
            want_refused("out-of-scope", {**impl(*members), "README.md": "y\n"}, members,
                         "FAIL paths: batch-out-of-scope: outside every labelled WP's PATHS")
            want_refused("tooling", {**impl(*members), "scripts/laned/x.py": "X = 1\n"}, members,
                         "FAIL paths: batch-out-of-scope")
            want_refused("self-declared", {**impl(*members), lanedlib.COUPLED_BATCHES_PATH: declared},
                         members, "FAIL paths: batch-out-of-scope", undeclared)
            want_refused("idle-member", impl("C1", "C2", "C4"), members,
                         "FAIL rule1: batch-label-without-changes: label(s) none of whose PATHS "
                         "or tests the diff touches: laned:C3")
            # the declared coupled-set squash merge is each member's L2 (git-only, legacy)
            lanedlib.git(root, "checkout", "-q", "main")
            lanedlib.git(root, "merge", "-q", "--squash", head)
            merged = commit({}, "feat: C1 C2 C3 C4 (#9)")
            built = [w for w in (*members, "E1") if built_on(root, merged, w)]
            if built != members:
                failures.append(f"coupled squash: built {built}, want {members}")
            lanedlib.git(root, "checkout", "-q", "-B", "partial", base)
            partial = commit({"pkg/core.py": "VALUE = 1\n", "pkg/c2.py": code["pkg/c2.py"],
                              "pkg/c4.py": code["pkg/c4.py"]}, "partial")
            if any(built_on(root, partial, w) for w in ("C1", "C3")):
                failures.append("coupled: a merge missing members counted as their L2")
            if lanedlib.parse_coupled_batches(declared) != [("C1", "C2", "C3", "C4")]:
                failures.append(f"coupled parse: {lanedlib.parse_coupled_batches(declared)}")
    finally:
        if saved is None:
            os.environ.pop("LANED_PYTEST_CMD", None)
        else:
            os.environ["LANED_PYTEST_CMD"] = saved
    return failures


def selftest_feature(ident: tuple[str, ...]) -> list[str]:
    """The FEATURE rule (rev6.17) on a real git repo and real pytest: tests +
    code in one PR (new failing-on-BASE test passing on HEAD -> PASS; a new
    test already passing on BASE -> refused unless a verification WP; a
    wrong-reason BASE failure -> refused), PATHS added in the same PR, a new
    WP created with its code, a 6-WP overlapping feature batch whose squash
    merge is each WP's L2 by the ledger (PR number), and a weakened or
    removed assertion refused without laned:tests-correction."""
    failures: list[str] = []
    saved = {k: os.environ.get(k) for k in ("LANED_PYTEST_CMD", "LANED_LEDGER", "LANED_PR_LABELS")}
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    os.environ.pop("LANED_LEDGER", None)
    os.environ.pop("LANED_PR_LABELS", None)
    six = [f"F{n}" for n in range(1, 7)]
    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-feature-") as tmp:
            root = Path(tmp) / "repo"
            root.mkdir()

            def commit(files: dict[str, str | None], msg: str) -> str:
                for rel, text in files.items():
                    if text is None:
                        (root / rel).unlink()
                        continue
                    (root / rel).parent.mkdir(parents=True, exist_ok=True)
                    (root / rel).write_text(text)
                lanedlib.git(root, "add", "-A")
                lanedlib.git(root, *ident, "commit", "-q", "--allow-empty", "-m", msg)
                return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

            lanedlib.git(root, "init", "-q")
            lanedlib.git(root, "checkout", "-q", "-b", "main")
            commit({".gitignore": "__pycache__/\n", "README.md": "x\n", "pkg/__init__.py": "",
                    "pkg/core.py": "VALUE = 1\n", "pkg/w1.py": "VALUE = 1\n", "pkg/v1.py": "VALUE = 1\n",
                    lanedlib.VERIFICATION_WPS_PATH: "V1\n"}, "seed")
            # W1 built (L2 by an implementation commit); V1 a declared verification WP
            commit({"tests/accept/w1/PATHS": "pkg/w1.py\n",
                    "tests/accept/w1/test_w1.py":
                        "import pkg.w1\n\n\ndef test_w1():\n    assert pkg.w1.VALUE >= 1\n"
                        "    assert isinstance(pkg.w1.VALUE, int)\n",
                    "tests/accept/v1/PATHS": "pkg/v1.py\n",
                    "tests/accept/v1/test_v1.py": "import pkg.v1\n\n\ndef test_v1():\n    assert pkg.v1.VALUE\n"},
                   "tests W1 V1")
            # the six feature WPs share pkg/core.py (overlapping PATHS)
            commit({f"tests/accept/{w.lower()}/PATHS": f"pkg/core.py\npkg/{w.lower()}.py\n" for w in six}
                   | {f"tests/accept/{w.lower()}/test_{w.lower()}.py":
                      f"import pkg.{w.lower()}\n\n\ndef test_{w.lower()}():\n    assert pkg.{w.lower()}.VALUE\n"
                      for w in six}
                   | {"tests/accept/g1/PATHS": "pkg/core.py\n",
                      "tests/accept/g1/test_g1.py": "import pkg.core\n\n\ndef test_g1():\n    assert pkg.core.VALUE\n"},
                   "tests F1-F6, G1")
            base = commit({"pkg/w1.py": "VALUE = 2\n"}, "impl W1")
            w1_more = ("import pkg.w1\n\n\ndef test_w1_three():\n    assert pkg.w1.VALUE == 3\n")

            def check(name: str, files: dict[str, str | None], labels: list[str], wp: str,
                      correction: bool = False, start: str = base) -> tuple[int, str, str]:
                lanedlib.git(root, "checkout", "-q", "-B", name, start)
                head = commit(files, name)
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_check_pr(root, wp, start, head, labels, correction)
                return rc, buf.getvalue(), head

            def combined(name: str, head: str, wp: str, want_ok: bool, want: str = "",
                         correction: bool = False, start: str = base) -> None:
                lanedlib.git(root, "checkout", "-q", head)
                with contextlib.redirect_stdout(io.StringIO()) as buf, \
                        contextlib.redirect_stderr(io.StringIO()):
                    rc = cmd_combined(root, wp, start, head, correction)
                out = buf.getvalue()
                ok = rc == 0 and f"PASS {wp} combined" in out and "LEDGER-MODE combined" in out
                if ok != want_ok or (want and want not in out):
                    failures.append(f"feature {name}: {wp} combined {'passed' if ok else 'failed'}, want "
                                    f"{'pass' if want_ok else 'fail'} {want}: {out.strip()[-1500:]}")
                lanedlib.git(root, "checkout", "-q", "main")

            def checked(name: str, files: dict[str, str | None], labels: list[str], wp: str,
                        mode: str, correction: bool = False) -> str:
                rc, out, head = check(name, files, labels, wp, correction)
                if rc != 0 or f"MODE {mode}\n" not in out:
                    failures.append(f"feature {name}: {wp} check-pr rc={rc}, want MODE {mode}: {out.strip()}")
                return head

            # (1) tests + code in one PR: the new test fails on BASE for a right
            # reason (assertion) and passes on HEAD -> PASS
            head = checked("tests-plus-code", {"pkg/w1.py": "VALUE = 3\n",
                                               "tests/accept/w1/test_w1_more.py": w1_more},
                           ["W1"], "W1", "combined")
            combined("tests-plus-code", head, "W1", True)
            # ... but HEAD's code does not make it pass -> FAIL
            head = checked("tests-plus-wrong-code", {"pkg/w1.py": "VALUE = 4\n",
                                                     "tests/accept/w1/test_w1_more.py": w1_more},
                           ["W1"], "W1", "combined")
            combined("tests-plus-wrong-code", head, "W1", False, "the full Accept fails on HEAD")
            # (2) a new test that already passes on BASE proves nothing -> refused
            head = checked("new-test-passes-on-base",
                           {"pkg/w1.py": "VALUE = 3\n", "tests/accept/w1/test_w1_more.py": w1_more,
                            "tests/accept/w1/test_w1_old.py":
                                "import pkg.w1\n\n\ndef test_w1_positive():\n    assert pkg.w1.VALUE > 0\n"},
                           ["W1"], "W1", "combined")
            combined("new-test-passes-on-base", head, "W1", False, "already pass on BASE")
            # ... unless the WP is a declared verification WP
            head = checked("verification-wp-passes-on-base",
                           {"pkg/v1.py": "VALUE = 1  # documented\n",
                            "tests/accept/v1/test_v1_more.py":
                                "import pkg.v1\n\n\ndef test_v1_int():\n    assert isinstance(pkg.v1.VALUE, int)\n"},
                           ["V1"], "V1", "combined")
            combined("verification-wp-passes-on-base", head, "V1", True)
            # a new test failing on BASE for a wrong reason (missing module outside PATHS) -> refused
            head = checked("wrong-reason-on-base",
                           {"pkg/w1.py": "VALUE = 3\n",
                            "tests/accept/w1/test_w1_more.py":
                                "import laned_no_such_dep\n\n\ndef test_x():\n    assert laned_no_such_dep\n"},
                           ["W1"], "W1", "combined")
            combined("wrong-reason-on-base", head, "W1", False, "wrong reason")
            # (3) PATHS ride along: a new entry and its file in the same PR
            files = {"tests/accept/w1/PATHS": "pkg/w1.py\npkg/w1_extra.py\n",
                     "pkg/w1_extra.py": "EXTRA = 5\n",
                     "tests/accept/w1/test_w1_extra.py":
                         "import pkg.w1_extra\n\n\ndef test_extra():\n    assert pkg.w1_extra.EXTRA == 5\n"}
            rc, out, head = check("paths-ride-along", files, ["W1"], "W1")
            if rc != 0 or "PATHS-ADDED W1 pkg/w1_extra.py\n" not in out or "MODE combined\n" not in out:
                failures.append(f"feature paths-ride-along: rc={rc}: {out.strip()}")
            combined("paths-ride-along", head, "W1", True)
            # ... a file outside BASE + HEAD PATHS is still out of scope
            rc, out, _ = check("paths-ride-along-outside", {**files, "pkg/other.py": "X = 1\n"}, ["W1"], "W1")
            if rc == 0 or "FAIL paths: batch-out-of-scope" not in out or "pkg/other.py" not in out:
                failures.append(f"feature paths-ride-along-outside: rc={rc}: {out.strip()}")
            # ... an added entry matching everything is refused
            rc, out, _ = check("paths-too-broad", {**files, "tests/accept/w1/PATHS": "pkg/w1.py\n*\n"},
                               ["W1"], "W1")
            if rc == 0 or "FAIL paths: batch-paths-too-broad" not in out:
                failures.append(f"feature paths-too-broad: rc={rc}: {out.strip()}")
            # a brand-new WP: PATHS, tests and code in one PR
            rc, out, head = check("new-wp", {"tests/accept/n1/PATHS": "pkg/n1.py\n",
                                             "tests/accept/n1/test_n1.py":
                                                 "import pkg.n1\n\n\ndef test_n1():\n    assert pkg.n1.VALUE == 7\n",
                                             "pkg/n1.py": "VALUE = 7\n"}, ["N1"], "N1")
            if rc != 0 or "PATHS-ADDED N1 pkg/n1.py\n" not in out or "MODE combined\n" not in out:
                failures.append(f"feature new-wp: rc={rc}: {out.strip()}")
            combined("new-wp", head, "N1", True)
            # (4) weakened assertion without laned:tests-correction -> refused
            weak = {"pkg/w1.py": "VALUE = 3\n", "tests/accept/w1/test_w1_more.py": w1_more,
                    "tests/accept/w1/test_w1.py": "import pkg.w1\n\n\ndef test_w1():\n    assert pkg.w1.VALUE >= 1\n"}
            rc, out, _ = check("weakened", weak, ["W1"], "W1")
            if rc == 0 or "FAIL weakened" not in out or "fewer assertions in tests/accept/w1/test_w1.py::test_w1" \
                    not in out or "MODE " in out:
                failures.append(f"feature weakened: rc={rc}: {out.strip()}")
            for name, extra in (("removed-test", {"tests/accept/w1/test_w1.py": None}),
                                ("skip-added", {"tests/accept/w1/test_w1.py":
                                                "import pytest\nimport pkg.w1\n\n\n@pytest.mark.skip\n"
                                                "def test_w1():\n    assert pkg.w1.VALUE >= 1\n"
                                                "    assert isinstance(pkg.w1.VALUE, int)\n"}),
                                ("paths-removed", {"tests/accept/w1/PATHS": "pkg/w1_only.py\n",
                                                   "pkg/w1_only.py": "X = 1\n"})):
                rc, out, _ = check(name, {"pkg/w1.py": "VALUE = 3\n",
                                          "tests/accept/w1/test_w1_more.py": w1_more, **extra}, ["W1"], "W1")
                if rc == 0 or "FAIL weakened" not in out:
                    failures.append(f"feature {name}: rc={rc}, want FAIL weakened: {out.strip()}")
            # ... with the label it is allowed (printed) and the run goes on
            rc, out, head = check("weakened-labelled", weak, ["W1", lanedlib.CORRECTION_LABEL], "W1",
                                  correction=True)
            if rc != 0 or "(allowed: laned:tests-correction)" not in out or "MODE combined\n" not in out:
                failures.append(f"feature weakened-labelled: rc={rc}: {out.strip()}")
            combined("weakened-labelled", head, "W1", True, correction=True)
            # (5) a 6-WP overlapping feature batch (shared pkg/core.py), tests for
            # two of them in the same PR: every label passes, each WP's own mode
            feat = {"pkg/core.py": "VALUE = 2\n"}
            feat.update({f"pkg/{w.lower()}.py": "from pkg.core import VALUE  # noqa: F401\n" for w in six})
            feat["tests/accept/f1/test_f1_core.py"] = ("import pkg.core\n\n\ndef test_core_two():\n"
                                                       "    assert pkg.core.VALUE == 2\n")
            feat["tests/accept/f2/test_f2_core.py"] = ("import pkg.f2\n\n\ndef test_f2_two():\n"
                                                       "    assert pkg.f2.VALUE == 2\n")
            fhead = ""
            for wp in six:
                rc, out, fhead = check(f"six-{wp}", feat, six, wp)
                mode = "combined" if wp in ("F1", "F2") else "implementation"
                if rc != 0 or f"BATCH {' '.join(six)}\n" not in out or f"MODE {mode}\n" not in out \
                        or any(f"WPMODE {w} " not in out for w in six):
                    failures.append(f"feature six: {wp} check-pr rc={rc}, want MODE {mode}: {out.strip()}")
            for wp in ("F1", "F2"):
                combined(f"six-{wp}", fhead, wp, True)
            lanedlib.git(root, "checkout", "-q", fhead)
            for wp in six[2:]:
                with contextlib.redirect_stdout(io.StringIO()) as buf, \
                        contextlib.redirect_stderr(io.StringIO()):
                    rc = cmd_accept(root, wp, None)
                if rc != 0:
                    failures.append(f"feature six: accept {wp} failed: {buf.getvalue().strip()[-1500:]}")
            lanedlib.git(root, "checkout", "-q", "main")
            # the squash merge: git alone cannot attribute it (overlapping, 6 WPs) ...
            lanedlib.git(root, "merge", "-q", "--squash", fhead)
            merged = commit({}, "feat(laned): F1-F6 shared core (#77)")
            if any(built_on(root, merged, w) for w in six[2:]):
                failures.append("feature six: L2 without a ledger row")
            # ... the ledger's PR rows (PR #77, one per laned:<WP> label) make it
            # every labelled WP's L2 (LABELLED rule: label + a non-test PATHS file)
            ledger = Path(tmp) / "ci_runs.json"
            rows = [{"workflow": "laned-accept", "event": "pull_request", "wp": w, "pr": 77,
                     "mode": "combined" if w in ("F1", "F2") else "accept", "head_sha": fhead,
                     "conclusion": "success", "created_at": "2026-11-23T00:00:00Z"} for w in six]
            rows.append({**rows[5], "conclusion": "failure", "created_at": "2026-11-23T01:00:00Z"})
            ledger.write_text(json.dumps({"runs": rows}))
            os.environ["LANED_LEDGER"] = str(ledger)
            built = [w for w in six if built_on(root, merged, w)]
            if built != six:
                failures.append(f"feature six: built {built}, want {six}")
            if lanedlib.green_pr_numbers(rows, "F6") or lanedlib.green_pr_numbers(rows, "F1") != {77}:
                failures.append("green_pr_numbers: last row per PR decides")
            # the #817 / W5i case: G1's broad PATHS (pkg/core.py) cover every
            # file of #79, a merge labelled laned:F1 only. The git-only rule
            # took it as G1's L2; with #79's labels known it is not. A merge
            # labelled laned:G1 that changes only G1's tests (#80) is no L2.
            core_only = commit({"pkg/core.py": "VALUE = 3\n"}, "fix(laned): F1 core (#79)")
            g1_tests = commit({"tests/accept/g1/test_g1_more.py": SELFTEST_PASSING}, "tests(laned): G1 (#80)")
            os.environ.pop("LANED_LEDGER", None)
            if not built_on(root, core_only, "G1"):
                failures.append("feature g1: the legacy git-only rule (no labels) no longer sees #79")
            labels = Path(tmp) / "pr_labels.json"
            labels.write_text(json.dumps([{"number": 79, "labels": [{"name": "laned:F1"}]},
                                          {"number": 80, "labels": [{"name": "laned:G1"},
                                                                    {"name": "laned:tests-correction"}]}]))
            os.environ["LANED_PR_LABELS"] = str(labels)
            if built_on(root, g1_tests, "G1"):
                failures.append("feature g1: an unlabelled (#79) or tests-only labelled (#80) merge gave L2")
            if lanedlib.parse_pr_labels(labels.read_text()) != {79: {"F1"}, 80: {"G1"}}:
                failures.append(f"parse_pr_labels: {lanedlib.parse_pr_labels(labels.read_text())}")
            os.environ.pop("LANED_PR_LABELS", None)
            lanedlib.git(root, "reset", "-q", "--hard", merged)
            os.environ["LANED_LEDGER"] = str(ledger)
            # ... and a later tests-only PR for a feature-built WP is a tests-correction
            rc, out, _ = check("after-feature", {"tests/accept/f3/test_f3_more.py":
                                                 "import pkg.f3\n\n\ndef test_more():\n    assert pkg.f3.VALUE\n"},
                               ["F3"], "F3", start=merged)
            if rc != 0 or out != "MODE tests-correction\n":
                failures.append(f"feature after-feature: rc={rc}: {out.strip()}")
    finally:
        for k, v in saved.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v
        _LEDGER.clear()
    return failures


def cmd_selftest() -> int:
    """Offline check of the RV<n> review mode of --check-pr and of the
    tests-only / tests-correction MODE rules."""
    failures: list[str] = []
    ident = ("-c", "user.name=t", "-c", "user.email=t@t", "-c", "commit.gpgsign=false")
    # the fixture repos' `(#N)` subjects must never meet the real repo's PR
    # labels or ledger (the PR job exports both)
    for k in ("LANED_PR_LABELS", "LANED_LEDGER"):
        os.environ.pop(k, None)
    with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-") as tmp:
        root = Path(tmp) / "repo"
        root.mkdir()

        def put(rel: str, text: str) -> None:
            (root / rel).parent.mkdir(parents=True, exist_ok=True)
            (root / rel).write_text(text)

        def commit(msg: str) -> str:
            lanedlib.git(root, "add", "-A")
            lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
            return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

        lanedlib.git(root, "init", "-q")
        put("README.md", "x\n")
        put("evidence/rv1.md", "Covers: W0c\n")
        base = commit("base")

        def case(name: str, files: dict[str, str | None], wp: str, want_ok: bool) -> None:
            lanedlib.git(root, "checkout", "-q", "-B", name, base)
            for rel, text in files.items():
                if text is None:
                    (root / rel).unlink()
                else:
                    put(rel, text)
            head = commit(name)
            with contextlib.redirect_stdout(io.StringIO()) as buf:
                rc = cmd_check_pr(root, wp, base, head)
            ok = rc == 0 and "MODE review" in buf.getvalue()
            if ok != want_ok:
                failures.append(f"{name}: {wp} check-pr {'passed' if ok else 'failed'}: {buf.getvalue().strip()}")

        case("add", {"evidence/rv2.md": "Covers: W1\n"}, "RV2", True)
        case("modify", {"evidence/rv1.md": "Covers: W0c, W0\n"}, "RV1", True)
        case("plus-other", {"evidence/rv2.md": "r\n", "README.md": "y\n"}, "RV2", False)
        case("wrong-review", {"evidence/rv2.md": "r\n"}, "RV1", False)
        case("plus-tests", {"evidence/rv2.md": "r\n", "tests/accept/w1/test_x.py": "x = 1\n"}, "RV2", False)
        case("delete", {"evidence/rv1.md": None}, "RV1", False)
        case("other-file-only", {"docs/notes.md": "n\n"}, "RV3", False)
    failures += selftest_tests_correction(ident)
    failures += selftest_verification(ident)
    failures += selftest_evidence(ident)
    failures += selftest_w3a_nolock_evidence()
    failures += selftest_wb19_partial_evidence()
    failures += selftest_cross(ident)
    failures += selftest_freshness(ident)
    failures += selftest_merge_group(ident)
    failures += selftest_batch(ident)
    failures += selftest_batch_impl(ident)
    failures += selftest_coupled(ident)
    failures += selftest_feature(ident)
    for f in failures:
        print(f"accept selftest: FAIL {f}", file=sys.stderr)
    if failures:
        return 1
    print("accept selftest: ok")
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["selftest"]:
        return cmd_selftest()
    ap = argparse.ArgumentParser(prog="accept", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("wp", nargs="?")
    ap.add_argument("--root", default=".")
    ap.add_argument("--evidence")
    ap.add_argument("--expect-fail", action="store_true",
                    help="MODE tests-only: the whole test dir must fail for a right reason")
    ap.add_argument("--verification", action="store_true",
                    help="the MODE tests-only run (needs --base/--head): MODE verification when BASE has "
                         "no L2 commit, every non-test PATHS entry exists on BASE and the full Accept "
                         "passes; otherwise --expect-fail")
    ap.add_argument("--tests-correction", action="store_true",
                    help="MODE tests-correction (needs --base/--head): unchanged test files pass, "
                         "changed ones pass or fail for a right reason")
    ap.add_argument("--check-pr", action="store_true",
                    help="rule 1 + PATHS; prints MODE implementation|tests-only|tests-correction|evidence|review")
    ap.add_argument("--cross", action="store_true",
                    help="(needs --base/--head) accept every other WP at >= L2 on BASE whose tests "
                         "depend on the PR's changes; WP may list the PR's WPs, comma-separated")
    ap.add_argument("--freshness", action="store_true",
                    help="(needs --base/--head/--main) STALE BASE when main moved past the tested base "
                         "with changes the PR's paths touch or import")
    ap.add_argument("--warn-only", action="store_true",
                    help="--freshness: a stale base prints a WARNING and exits 0 (pull_request job; the "
                         "merge queue's --merge-group run is the gate)")
    ap.add_argument("--merge-group", action="store_true",
                    help="(needs --base/--head/--group-labels) the merge queue's combined ref: every "
                         "queued PR's own WP runs (MERGE-GROUP rule)")
    ap.add_argument("--group-labels", metavar="FILE",
                    help="--merge-group: JSON {PR number: [label names]} of the queued PRs")
    ap.add_argument("--pr-wps", metavar="WP[,WP...]",
                    help="--check-pr: every laned:<WP> label of the PR (BATCH rule for tests-only and "
                         "tests-correction PRs, FEATURE rule for any PR with code)")
    ap.add_argument("--combined", action="store_true",
                    help="MODE combined (needs --base/--head): the WP's new/changed tests fail on BASE "
                         "for a right reason, then the full Accept passes on HEAD")
    ap.add_argument("--correction", action="store_true",
                    help=f"--check-pr / --combined: the PR carries laned:{lanedlib.CORRECTION_LABEL} "
                         "(may delete or weaken existing assertions)")
    ap.add_argument("--base")
    ap.add_argument("--head")
    ap.add_argument("--main", metavar="REF", help="--freshness: main's current tip (origin/main)")
    ap.add_argument("--gate", metavar="STAGE")
    args = ap.parse_args(argv)
    root = Path(args.root).resolve()
    if args.gate:
        return cmd_gate(root, args.gate)
    if args.freshness:
        if not (args.base and args.head and args.main):
            ap.error("--freshness needs --base, --head and --main")
        return cmd_freshness(root, args.base, args.head, args.main, args.warn_only)
    if args.merge_group:
        if not (args.base and args.head and args.group_labels):
            ap.error("--merge-group needs --base, --head and --group-labels")
        try:
            labels = read_group_labels(args.group_labels)
        except (OSError, ValueError) as e:
            print(f"GROUP FAIL: unreadable --group-labels: {e}")
            return 1
        return cmd_merge_group(root, args.base, args.head, labels)
    if args.cross:
        if not (args.wp and args.base and args.head):
            ap.error("--cross needs the PR's WP(s), --base and --head")
        return cmd_cross(root, [w for w in re.split(r"[,\s]+", args.wp) if w], args.base, args.head)
    if not args.wp:
        ap.error("a WP id is required (or --gate STAGE)")
    if args.check_pr:
        if not (args.base and args.head):
            ap.error("--check-pr needs --base and --head")
        pr_wps = [w for w in re.split(r"[,\s]+", args.pr_wps or "") if w]
        return cmd_check_pr(root, args.wp, args.base, args.head, pr_wps, args.correction)
    if args.combined:
        if not (args.base and args.head):
            ap.error("--combined needs --base and --head")
        return cmd_combined(root, args.wp, args.base, args.head, args.correction)
    if args.verification:
        if not (args.base and args.head):
            ap.error("--verification needs --base and --head")
        return cmd_verification(root, args.wp, args.base, args.head)
    if args.tests_correction:
        if not (args.base and args.head):
            ap.error("--tests-correction needs --base and --head")
        return cmd_tests_correction(root, args.wp, args.base, args.head)
    if args.expect_fail:
        return cmd_expect_fail(root, args.wp)
    return cmd_accept(root, args.wp, args.evidence)


if __name__ == "__main__":
    sys.exit(main())
