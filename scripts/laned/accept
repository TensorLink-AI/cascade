def selftest_cross(ident: tuple[str, ...]) -> list[str]:
    """The CROSS rule on a real git repo and real pytest: A, B, C, D, F, G
    built, E tests-only; B's tests import pkg_b, which imports A's pkg_a; D's
    PATHS also cover A's shared_ad.py; C and E must never run for an A PR.
    F is red on BASE (KNOWN unless the PR adds a failure); G cannot be
    collected on BASE (always FAIL when selected)."""
    failures: list[str] = []
    saved = os.environ.get("LANED_PYTEST_CMD")
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-cross-") as tmp:
            root = Path(tmp) / "repo"
            root.mkdir()

            def commit(files: dict[str, str], msg: str) -> str:
                for rel, text in files.items():
                    (root / rel).parent.mkdir(parents=True, exist_ok=True)
                    (root / rel).write_text(text)
                lanedlib.git(root, "add", "-A")
                lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
                return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

            lanedlib.git(root, "init", "-q")
            commit({"README.md": "x\n", ".gitignore": "__pycache__/\n", lanedlib.PLAN_PATH: SELFTEST_CROSS_PLAN,
                    "pkg_a.py": "VALUE = 0\n", "pkg_b.py": "DOUBLE = 0\n", "pkg_c.py": "C = 0\n",
                    "pkg_d.py": "D = 0\n", "shared_ad.py": "S = 0\n"}, "seed")
            for wp, paths, test in (
                    ("a", "pkg_a.py\nshared_ad.py\n", "import pkg_a\n\n\ndef test_a():\n    assert pkg_a.VALUE > 0\n"),
                    ("b", "pkg_b.py\n", "import pkg_b\n\n\ndef test_b():\n    assert pkg_b.DOUBLE == 2\n"),
                    ("c", "pkg_c.py\n", "import pkg_c\n\n\ndef test_c():\n    assert pkg_c.C == 3\n"),
                    ("d", "pkg_d.py\nshared_ad.py\n", "import pkg_d\n\n\ndef test_d():\n    assert pkg_d.D == 4\n"),
                    ("e", "pkg_e.py\n", "import pkg_a\nimport pkg_e\n\n\ndef test_e():\n    assert pkg_e.E\n"),
                    # F is red on BASE (test_f_red); test_f_ok reads A's VALUE through pkg_f
                    ("f", "pkg_f.py\n", "import pkg_f\n\n\ndef test_f_red():\n    assert pkg_f.F == 99\n\n\n"
                                        "def test_f_ok():\n    assert pkg_f.G == 1\n"),
                    # G cannot even be collected on BASE; it imports C's pkg_c
                    ("g", "pkg_g.py\n", "import pkg_c\nfrom pkg_g import MISSING\n\n\ndef test_g():\n"
                                        "    assert MISSING and pkg_c\n")):
                commit({f"tests/accept/{wp}/PATHS": paths, f"tests/accept/{wp}/test_{wp}.py": test},
                       f"tests-only {wp}")
            commit({"pkg_a.py": "VALUE = 1\n"}, "impl A")
            commit({"pkg_b.py": "import pkg_a\n\nDOUBLE = pkg_a.VALUE * 2\n"}, "impl B")
            commit({"pkg_c.py": "C = 3\n"}, "impl C")
            commit({"pkg_f.py": "import pkg_a\n\nF = 6\nG = pkg_a.VALUE\n"}, "impl F")
            commit({"pkg_g.py": "X = 1\n"}, "impl G")
            commit({"pkg_d.py": "D = 4\n"}, "impl D")
            # RV5: V is a declared verification WP over B's built pkg_b (tests-only
            # merge, no implementation commit); U has the same shape but is not
            # declared, so it is not built (L1 at most) and never a cross WP.
            vtest = "import pkg_b\n\n\ndef test_{w}():\n    assert pkg_b.DOUBLE == 2\n"
            commit({lanedlib.VERIFICATION_WPS_PATH: "# verification WPs\nV  # checks B\n"}, "declare V")
            commit({"tests/accept/v/PATHS": "pkg_b.py\n", "tests/accept/v/test_v.py": vtest.format(w="v")},
                   "verification V")
            base = commit({"tests/accept/u/PATHS": "pkg_b.py\n", "tests/accept/u/test_u.py": vtest.format(w="u")},
                          "tests-only U")

            def case(name: str, wps: str, files: dict[str, str], want_rc: int,
                     want: list[str], never: list[str]) -> None:
                lanedlib.git(root, "checkout", "-q", "-B", name, base)
                head = commit(files, name)
                with contextlib.redirect_stdout(io.StringIO()) as buf, \
                        contextlib.redirect_stderr(io.StringIO()):
                    rc = cmd_cross(root, wps.split(","), base, head)
                out = buf.getvalue()
                lines = [ln for ln in out.splitlines() if ln.startswith("CROSS ")]
                bad = [w for w in want if not any(ln.startswith(w) for ln in lines)]
                bad += [n for n in never if any(ln.startswith(f"CROSS {n} ") for ln in lines)]
                if rc != want_rc or bad:
                    failures.append(f"cross {name}: rc={rc} want {want_rc}; missing/unexpected {bad}: "
                                    f"{out.strip()[-2000:]}")

            # implementation PR for A breaks B (imports pkg_a through pkg_b) -> CROSS B FAIL;
            # D runs only for the PATHS overlap and passes; C (unrelated) and E (unbuilt) never run
            # ... and F, red on BASE by test_f_red, gains a failure (test_f_ok) -> CROSS F FAIL
            # ... and V, a verification WP whose tests import pkg_b (-> pkg_a), is
            # re-run and the break gives CROSS V FAIL (RV5); U is not declared -> never
            case("a-breaks-b", "A", {"pkg_a.py": "VALUE = 5\n", "shared_ad.py": "S = 1\n"}, 1,
                 ["CROSS B FAIL", "CROSS D PASS", "CROSS F FAIL (pytest: 1 regression", "CROSS V FAIL"],
                 ["A", "C", "E", "G", "U"])
            # the same PR without the break -> CROSS B PASS; F still red the same
            # way as on BASE -> CROSS F KNOWN, which does not fail the job
            case("a-keeps-b", "A", {"pkg_a.py": "VALUE = 1\nEXTRA = 2\n"}, 0,
                 ["CROSS B PASS", "CROSS F KNOWN (1 tests already red on base: ", "CROSS V PASS"],
                 ["A", "C", "D", "E", "G", "U"])
            # tests-correction PR for B: B is the main step, never a cross WP
            case("b-tests-correction", "B",
                 {"tests/accept/b/test_b_more.py": "import pkg_b\n\n\ndef test_more():\n"
                                                   "    assert pkg_b.DOUBLE\n"},
                 0, ["CROSS none"], ["A", "B", "C", "D", "E", "F", "G", "U", "V"])
            # a global input re-accepts every built WP except the PR's own (C, G)
            case("lockfile", "C,G", {"uv.lock": "x\n", "pkg_c.py": "C = 3\n# lock\n"}, 0,
                 ["CROSS A PASS", "CROSS B PASS", "CROSS D PASS", "CROSS F KNOWN", "CROSS V PASS"],
                 ["C", "E", "G", "U"])
            # G fails on HEAD and cannot be collected on BASE either -> FAIL (fails closed)
            case("c-touches-g", "C", {"pkg_c.py": "C = 3\n# touch\n"}, 1,
                 ["CROSS G FAIL"], ["A", "B", "C", "D", "E", "F", "U", "V"])
    finally:
        if saved is None:
            os.environ.pop("LANED_PYTEST_CMD", None)
        else:
            os.environ["LANED_PYTEST_CMD"] = saved
    return failures


def selftest_freshness(ident: tuple[str, ...]) -> list[str]:
    """The FRESHNESS rule on a real git repo (no pytest): PRs green on BASE0
    while main moves on. The #593 shape: PR1 (pkg_lib.py) merges, then PR2,
    W3's implementation (pkg_w3.py) green on the older base, must be refused
    because W3's tests import pkg_lib; after update-branch it is fresh."""
    failures: list[str] = []
    with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-fresh-") as tmp:
        root = Path(tmp) / "repo"
        root.mkdir()

        def commit(files: dict[str, str], msg: str) -> str:
            for rel, text in files.items():
                (root / rel).parent.mkdir(parents=True, exist_ok=True)
                (root / rel).write_text(text)
            lanedlib.git(root, "add", "-A")
            lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
            return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

        lanedlib.git(root, "init", "-q")
        base0 = commit({"README.md": "x\n", "pkg_a.py": "A = 1\n", "pkg_b.py": "import pkg_a\n\nB = pkg_a.A\n",
                        "pkg_c.py": "C = 1\n", "pkg_lib.py": "LIB = 1\n", "pkg_w3.py": "W3 = 0\n",
                        "tests/accept/w3/PATHS": "pkg_w3.py\n",
                        "tests/accept/w3/test_w3.py": "import pkg_lib\nimport pkg_w3\n\n\ndef test_w3():\n"
                                                      "    assert pkg_w3.W3 == pkg_lib.LIB\n"}, "seed")

        def branch(name: str, start: str, files: dict[str, str]) -> str:
            lanedlib.git(root, "checkout", "-q", "-B", name, start)
            return commit(files, name)

        def case(name: str, base: str, head: str, main: str, want_stale: bool, want: str = "") -> None:
            with contextlib.redirect_stdout(io.StringIO()) as buf:
                rc = cmd_freshness(root, base, head, main)
            out = buf.getvalue()
            stale = "STALE BASE: update-branch and re-run\n" in out
            if (rc != 0) != want_stale or stale != want_stale or (want and want not in out):
                failures.append(f"freshness {name}: rc={rc} stale={stale}, want stale={want_stale}"
                                f"{' with ' + repr(want) if want else ''}: {out.strip()[-1500:]}")

        pr_a = branch("pr-a", base0, {"pkg_a.py": "A = 1\nEXTRA = 2\n"})
        # main has not moved -> fresh
        case("main-unmoved", base0, pr_a, base0, False, "FRESH base")
        # main moved with an unrelated change -> fresh enough
        main_c = branch("main-c", base0, {"pkg_c.py": "C = 2\n"})
        case("main-unrelated", base0, pr_a, main_c, False, "FRESH enough")
        # main touched the same file -> stale
        main_a = branch("main-a", base0, {"pkg_a.py": "A = 3\n"})
        case("same-file", base0, pr_a, main_a, True, "both touch pkg_a.py")
        # the PR's module imports what main changed -> stale
        pr_b = branch("pr-b", base0, {"pkg_b.py": "import pkg_a\n\nB = pkg_a.A + 1\n"})
        case("pr-imports-main-change", base0, pr_b, main_a, True, "the PR's modules import pkg_a.py")
        # main's changed module imports what the PR changed -> stale
        main_b = branch("main-b", base0, {"pkg_b.py": "import pkg_a\n\nB = pkg_a.A * 2\n"})
        case("main-imports-pr-change", base0, pr_a, main_b, True, "main's changed modules import pkg_a.py")
        # #593: PR1 changes pkg_lib.py and merges; PR2 (W3's implementation) was
        # green on BASE0, and W3's tests import pkg_lib -> refused
        branch("pr1", base0, {"pkg_lib.py": "LIB = 2\n"})
        lanedlib.git(root, "checkout", "-q", "-B", "main", base0)
        lanedlib.git(root, "merge", "-q", "--squash", "pr1")
        main1 = commit({}, "pr1 (#1)")
        pr2 = branch("pr2", base0, {"pkg_w3.py": "W3 = 1\n"})
        case("second-pr-older-base", base0, pr2, main1, True, "tests/accept/w3/ depends on the PR")
        # after update-branch the run tests the PR merged into main's tip -> fresh
        lanedlib.git(root, "checkout", "-q", "-B", "pr2-updated", pr2)
        lanedlib.git(root, *ident, "merge", "-q", "--no-edit", "main")
        updated = lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()
        case("second-pr-updated", main1, updated, main1, False, "FRESH base")
    return failures


def _batch_test(n: int, wrong: bool = False) -> str:
    """tests/accept/b<n>/test_b<n>.py: a right-reason failure (missing module
    in its PATHS), or a wrong-reason one (missing module outside PATHS)."""
    mod = "laned_no_such_dep" if wrong else f"pkg_b{n}"
    return f"import {mod}\n\n\ndef test_b{n}():\n    assert {mod}.VALUE == {n}\n"


def selftest_batch(ident: tuple[str, ...]) -> list[str]:
    """The BATCH rule of --check-pr and the per-WP --verification runs the PR
    job makes for it, on a real git repo and real pytest. B1..B3 are new WPs
    (PATHS pkg_b<n>.py, not built); K is built on BASE (L2 commit)."""
    failures: list[str] = []
    saved = os.environ.get("LANED_PYTEST_CMD")
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-batch-") as tmp:
            root = Path(tmp) / "repo"
            root.mkdir()

            def commit(files: dict[str, str], msg: str) -> str:
                for rel, text in files.items():
                    (root / rel).parent.mkdir(parents=True, exist_ok=True)
                    (root / rel).write_text(text)
                lanedlib.git(root, "add", "-A")
                lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
                return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

            lanedlib.git(root, "init", "-q")
            commit({"README.md": "x\n", ".gitignore": "__pycache__/\n", "pkg_k.py": "VALUE = 0\n"}, "seed")
            commit({"tests/accept/k/PATHS": "pkg_k.py\n",
                    "tests/accept/k/test_k.py": "import pkg_k\n\n\ndef test_k():\n    assert pkg_k.VALUE == 1\n"},
                   "tests-only K")
            base = commit({"pkg_k.py": "VALUE = 1\n"}, "impl K")

            def b_files(*ns: int, wrong: int = 0) -> dict[str, str]:
                out: dict[str, str] = {}
                for n in ns:
                    out[f"tests/accept/b{n}/PATHS"] = f"pkg_b{n}.py\n"
                    out[f"tests/accept/b{n}/test_b{n}.py"] = _batch_test(n, wrong=n == wrong)
                return out

            def case(name: str, files: dict[str, str], labels: list[str],
                     want: str | dict[str, bool]) -> None:
                """``want``: a batch-<reason> refusal every label's check-pr
                must print, or {WP: verification run passes} per label."""
                lanedlib.git(root, "checkout", "-q", "-B", name, base)
                head = commit(files, name)
                for wp in labels:
                    with contextlib.redirect_stdout(io.StringIO()) as buf:
                        rc = cmd_check_pr(root, wp, base, head, labels)
                    out = buf.getvalue()
                    if isinstance(want, str):
                        if REVIEW_WP.match(wp):  # its own check-pr is the review rule: any refusal
                            if rc == 0:
                                failures.append(f"batch {name}: {wp} check-pr passed: {out.strip()}")
                            continue
                        if rc == 0 or f"FAIL rule1: {want}" not in out:
                            failures.append(f"batch {name}: {wp} check-pr rc={rc}, want FAIL rule1: {want}: "
                                            f"{out.strip()}")
                        continue
                    if rc != 0 or "MODE tests-only\n" not in out or f"BATCH {' '.join(labels)}\n" not in out:
                        failures.append(f"batch {name}: {wp} check-pr rc={rc}, want MODE tests-only: {out.strip()}")
                        continue
                    with contextlib.redirect_stdout(io.StringIO()) as buf, \
                            contextlib.redirect_stderr(io.StringIO()):
                        rc = cmd_verification(root, wp, base, head)
                    out = buf.getvalue()
                    tree = lanedlib.wp_tree_at(root, head, wp)
                    ok = rc == 0 and "LEDGER-MODE expect-fail\n" in out
                    if ok != want[wp] or f"TESTS-TREE {tree}\n" not in out:
                        failures.append(f"batch {name}: {wp} verification {'passed' if ok else 'failed'}, "
                                        f"want {'pass' if want[wp] else 'fail'} with TESTS-TREE {tree}: "
                                        f"{out.strip()[-1500:]}")

            three = ["B1", "B2", "B3"]
            # a 3-WP batch: every WP's own expect-fail run passes, each with its own tests tree
            case("three", b_files(1, 2, 3), three, {"B1": True, "B2": True, "B3": True})
            # one WP's wrong-reason failure: that WP's run fails (the PR job fails), the others pass
            case("one-wrong-reason", b_files(1, 2, 3, wrong=2), three, {"B1": True, "B2": False, "B3": True})
            # a batch including a WP already built on BASE (K, L2) -> refused for every label
            case("built-wp", {**b_files(1, 2), "tests/accept/k/test_k_more.py": SELFTEST_PASSING},
                 ["B1", "B2", "K"], "batch-built-wp")
            # a tests dir without its label -> refused
            case("unlabelled", b_files(1, 2, 3), ["B1", "B2"], "batch-unlabelled-tests")
            # a label without its tests dir -> refused
            case("label-without-tests", b_files(1, 2), three, "batch-label-without-tests")
            # a review label in a tests batch -> refused
            case("review-label", b_files(1, 2), ["B1", "B2", "RV9"], "batch-non-wp-label")
            # a tests/accept/ file outside every WP dir -> refused
            case("stray", {**b_files(1, 2), "tests/accept/conftest.py": "\n"}, ["B1", "B2"],
                 "batch-stray-tests")
            # code + tests in one batch diff: rule 1 as before
            lanedlib.git(root, "checkout", "-q", "-B", "code-plus-tests", base)
            head = commit({**b_files(1, 2), "pkg_b1.py": "VALUE = 1\n"}, "code-plus-tests")
            with contextlib.redirect_stdout(io.StringIO()) as buf:
                rc = cmd_check_pr(root, "B1", base, head, ["B1", "B2"])
            if rc == 0 or "FAIL rule1: tests/accept/ edited together with: pkg_b1.py" not in buf.getvalue():
                failures.append(f"batch code-plus-tests: rc={rc}: {buf.getvalue().strip()}")
            # one label, another WP's tests too: the single-WP rule is unchanged
            lanedlib.git(root, "checkout", "-q", "-B", "single-foreign", base)
            head = commit(b_files(1, 2), "single-foreign")
            for labels in (None, ["B1"]):
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_check_pr(root, "B1", base, head, labels)
                if rc == 0 or "touches another WP's tests" not in buf.getvalue():
                    failures.append(f"batch single-foreign {labels}: rc={rc}: {buf.getvalue().strip()}")
    finally:
        if saved is None:
            os.environ.pop("LANED_PYTEST_CMD", None)
        else:
            os.environ["LANED_PYTEST_CMD"] = saved
    return failures


SELFTEST_BATCH_IMPL_PLAN = """# selftest plan

| WP | What | Depends | Runs in | Accept |
|---|---|---|---|---|
| I1 | one | — | ci | `scripts/laned/accept I1` |
| I2 | two | — | ci | `scripts/laned/accept I2` |
| I3 | three | — | ci | `scripts/laned/accept I3` |
| I4 | four | — | ci | `scripts/laned/accept I4` |
| D1 | needs I1 | I1 | ci | `scripts/laned/accept D1` |
| D2 | needs D1 | D1 **(rev6)** | ci | `scripts/laned/accept D2` |
| O1 | overlaps I1 | — | ci | `scripts/laned/accept O1` |
| N1 | no tests yet | — | ci | `scripts/laned/accept N1` |

| WP | Stage | Runs in | Accept |
|---|---|---|---|
| X1 | S9 | ci | `scripts/laned/accept X1` |
"""


def selftest_batch_impl(ident: tuple[str, ...]) -> list[str]:
    """The BATCH IMPLEMENTATION rule of --check-pr (plan rev6.3 (b)), the
    per-WP Accept after it, the squash merge as each WP's L2 commit
    (built_on) and the tests-correction batch, on a real git repo."""
    failures: list[str] = []
    saved = os.environ.get("LANED_PYTEST_CMD")
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    # WP -> (PATHS, implementation files)
    wps = {"I1": ("pkg/i1.py\n", {"pkg/i1.py": "VALUE = 1\n"}),
           "I2": ("pkg/i2/\n", {"pkg/i2/__init__.py": "", "pkg/i2/mod.py": "VALUE = 1\n"}),
           "I3": ("pkg/i3_*.py\n", {"pkg/i3_core.py": "VALUE = 1\n"}),
           "I4": ("pkg/i4.py\n", {"pkg/i4.py": "VALUE = 1\n"}),
           "D1": ("pkg/d1.py\n", {"pkg/d1.py": "VALUE = 1\n"}),
           "D2": ("pkg/d2.py\n", {"pkg/d2.py": "VALUE = 1\n"}),
           "O1": ("pkg/\n", {"pkg/o1.py": "VALUE = 1\n"}),
           "X1": ("pkg/x1.py\n", {"pkg/x1.py": "VALUE = 1\n"})}
    mods = {"I1": "pkg.i1", "I2": "pkg.i2.mod", "I3": "pkg.i3_core", "I4": "pkg.i4",
            "D1": "pkg.d1", "D2": "pkg.d2", "O1": "pkg.o1", "X1": "pkg.x1"}

    def impl(*names: str) -> dict[str, str]:
        out: dict[str, str] = {}
        for n in names:
            out.update(wps[n][1])
        return out

    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-batchimpl-") as tmp:
            root = Path(tmp) / "repo"
            root.mkdir()

            def commit(files: dict[str, str], msg: str) -> str:
                for rel, text in files.items():
                    (root / rel).parent.mkdir(parents=True, exist_ok=True)
                    (root / rel).write_text(text)
                lanedlib.git(root, "add", "-A")
                lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
                return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

            lanedlib.git(root, "init", "-q")
            lanedlib.git(root, "checkout", "-q", "-b", "main")
            commit({lanedlib.PLAN_PATH: SELFTEST_BATCH_IMPL_PLAN, ".gitignore": "__pycache__/\n",
                    "README.md": "x\n", "pkg/__init__.py": ""}, "plan")
            for w, (paths, _) in wps.items():
                d = lanedlib.wp_dir(w)
                commit({f"tests/accept/{d}/PATHS": paths,
                        f"tests/accept/{d}/test_{d}.py": f"import {mods[w]}\n\n\ndef test_{d}():\n"
                                                         f"    assert {mods[w]}.VALUE == 1\n"}, f"tests {w}")
            base = lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

            def check(name: str, files: dict[str, str], labels: list[str] | None, wp: str,
                      start: str) -> tuple[int, str, str]:
                lanedlib.git(root, "checkout", "-q", "-B", name, start)
                head = commit(files, name)
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_check_pr(root, wp, start, head, labels)
                return rc, buf.getvalue(), head

            def want_batch(name: str, files: dict[str, str], labels: list[str], mode: str,
                           start: str) -> str:
                head = ""
                for wp in labels:
                    rc, out, head = check(f"{name}-{wp}", files, labels, wp, start)
                    lines = [ln for ln in out.splitlines() if ln.startswith(("BATCH ", "MODE "))]
                    if rc != 0 or lines != ["BATCH " + " ".join(labels), f"MODE {mode}"]:
                        failures.append(f"batch-impl {name}: {wp} rc={rc}, want BATCH + MODE {mode}: "
                                        f"{out.strip()}")
                return head

            def want_refused(name: str, files: dict[str, str], labels: list[str], want: str,
                             start: str = base) -> None:
                for wp in labels:
                    if REVIEW_WP.match(wp):
                        continue
                    rc, out, _ = check(f"{name}-{wp}", files, labels, wp, start)
                    if rc == 0 or want not in out or "MODE " in out:
                        failures.append(f"batch-impl {name}: {wp} rc={rc}, want {want}: {out.strip()}")

            want_batch("two", impl("I1", "I2"), ["I1", "I2"], "implementation", base)
            head3 = want_batch("three", impl("I1", "I2", "I3"), ["I1", "I2", "I3"], "implementation", base)
            want_refused("four", impl("I1", "I2", "I3", "I4"), ["I1", "I2", "I3", "I4"],
                         "FAIL rule1: batch-too-many")
            want_refused("overlap", impl("I1", "O1"), ["I1", "O1"], "FAIL rule1: batch-overlapping-paths")
            want_refused("dep", impl("I1", "D1"), ["I1", "D1"], "FAIL rule1: batch-dependency: D1 depends on I1")
            want_refused("dep-transitive", impl("I1", "D2"), ["D2", "I1"],
                         "FAIL rule1: batch-dependency: D2 depends on I1 (transitively)")
            want_refused("no-tests", {**impl("I1"), "pkg/n1.py": "VALUE = 1\n"}, ["I1", "N1"],
                         "FAIL rule1: batch-no-tests")
            want_refused("deps-unknown", impl("I1", "X1"), ["I1", "X1"], "FAIL rule1: batch-deps-unknown")
            want_refused("no-wp", {**impl("I1", "I2"), "README.md": "y\n"}, ["I1", "I2"],
                         "FAIL paths: batch-out-of-scope: outside every batch WP's PATHS: README.md")
            want_refused("tooling", {**impl("I1", "I2"), "scripts/laned/x.py": "X = 1\n"}, ["I1", "I2"],
                         "FAIL paths: batch-out-of-scope")
            want_refused("idle-label", impl("I1"), ["I1", "I2"], "FAIL rule1: batch-label-without-changes")
            want_refused("review-label", impl("I1"), ["I1", "RV9"], "FAIL rule1: batch-non-wp-label")
            # one label: unchanged (another WP's files are outside its PATHS)
            for labels in (None, ["I1"]):
                rc, out, _ = check("single", impl("I1", "I2"), labels, "I1", base)
                if rc == 0 or not out.startswith("FAIL paths: outside the WP's PATHS: pkg/i2/"):
                    failures.append(f"batch-impl single {labels}: rc={rc}: {out.strip()}")
            rc, out, _ = check("single-ok", impl("I1"), ["I1"], "I1", base)
            if rc != 0 or out != "MODE implementation\n":
                failures.append(f"batch-impl single-ok: rc={rc}: {out!r}")
            # each WP's own Accept passes on the batch head
            lanedlib.git(root, "checkout", "-q", head3)
            for wp in ("I1", "I2", "I3"):
                with contextlib.redirect_stdout(io.StringIO()) as buf, \
                        contextlib.redirect_stderr(io.StringIO()):
                    rc = cmd_accept(root, wp, None)
                if rc != 0:
                    failures.append(f"batch-impl accept {wp} failed: {buf.getvalue().strip()[-1500:]}")
            # the squash merge is each WP's L2 commit; a stray-file merge is not
            lanedlib.git(root, "checkout", "-q", "main")
            lanedlib.git(root, "merge", "-q", "--squash", head3)
            merged = commit({}, "feat: I1 I2 I3 (#2)")
            built = [w for w in ("I1", "I2", "I3", "I4") if built_on(root, merged, w)]
            if built != ["I1", "I2", "I3"]:
                failures.append(f"batch-impl squash: built {built}, want I1 I2 I3")
            stray = commit({"pkg/d1.py": "VALUE = 1\n", "pkg/x1.py": "VALUE = 1\n", "README.md": "z\n"}, "stray")
            if built_on(root, stray, "D1") or built_on(root, stray, "X1"):
                failures.append("batch-impl: a merge with a file in no WP's PATHS counted as L2")
            lanedlib.git(root, "reset", "-q", "--hard", merged)
            # tests-corrections batch: all built (<= 3) -> MODE tests-correction per WP
            more = {f"tests/accept/{lanedlib.wp_dir(w)}/test_more_{lanedlib.wp_dir(w)}.py": SELFTEST_PASSING
                    for w in ("I1", "I2")}
            head = want_batch("corrections", more, ["I1", "I2"], "tests-correction", merged)
            lanedlib.git(root, "checkout", "-q", head)
            for wp in ("I1", "I2"):
                with contextlib.redirect_stdout(io.StringIO()) as buf, \
                        contextlib.redirect_stderr(io.StringIO()):
                    rc = cmd_tests_correction(root, wp, merged, head)
                if rc != 0:
                    failures.append(f"batch-impl tests-correction {wp} failed: {buf.getvalue().strip()[-1500:]}")
            want_refused("mixed", {"tests/accept/i1/test_more_i1.py": SELFTEST_PASSING,
                                   "tests/accept/d1/test_more_d1.py": SELFTEST_PASSING}, ["I1", "D1"],
                         "FAIL rule1: batch-built-wp", merged)
            lanedlib.git(root, "checkout", "-q", "main")
            four_base = commit(impl("I4"), "feat: I4 (#3)")
            want_refused("four-corrections",
                         {f"tests/accept/{lanedlib.wp_dir(w)}/test_more.py": SELFTEST_PASSING
                          for w in ("I1", "I2", "I3", "I4")},
                         ["I1", "I2", "I3", "I4"], "FAIL rule1: batch-too-many", four_base)
    finally:
        if saved is None:
            os.environ.pop("LANED_PYTEST_CMD", None)
        else:
            os.environ["LANED_PYTEST_CMD"] = saved
    return failures


SELFTEST_COUPLED_PLAN = """# selftest plan

| WP | What | Depends | Runs in | Accept |
|---|---|---|---|---|
| C1 | producer | — | ci | `scripts/laned/accept C1` |
| C2 | draw | C1 | ci | `scripts/laned/accept C2` |
| C3 | report | — | ci | `scripts/laned/accept C3` |
| C4 | replay | C3 | ci | `scripts/laned/accept C4` |
| E1 | elsewhere | — | ci | `scripts/laned/accept E1` |
"""


def selftest_coupled(ident: tuple[str, ...]) -> list[str]:
    """The COUPLED rule of --check-pr (scripts/laned/coupled_batches at BASE),
    each member's Accept on the coupled head, the squash merge as each
    member's L2 commit (built_on), and every refusal the rule keeps, on a
    real git repo."""
    failures: list[str] = []
    saved = os.environ.get("LANED_PYTEST_CMD")
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    # C1, C2 and C4 share pkg/core.py (overlapping PATHS); C2 depends on C1
    # and C4 on C3; four WPs exceed BATCH_IMPL_MAX.
    wps = {"C1": ("pkg/core.py\npkg/c1.py\n", "pkg.c1"),
           "C2": ("pkg/core.py\npkg/c2.py\n", "pkg.c2"),
           "C3": ("pkg/c3.py\n", "pkg.c3"),
           "C4": ("pkg/core.py\npkg/c4.py\n", "pkg.c4"),
           "E1": ("pkg/e1.py\n", "pkg.e1")}
    code = {f"pkg/{w.lower()}.py": "from pkg.core import VALUE  # noqa: F401\n" for w in wps}
    code["pkg/core.py"] = "VALUE = 1\n"
    members = ["C1", "C2", "C3", "C4"]
    declared = "# selftest\nC1 C2 C3 C4  # the coupled set\nE1\n"
    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-coupled-") as tmp:
            root = Path(tmp) / "repo"
            root.mkdir()

            def commit(files: dict[str, str], msg: str) -> str:
                for rel, text in files.items():
                    (root / rel).parent.mkdir(parents=True, exist_ok=True)
                    (root / rel).write_text(text)
                lanedlib.git(root, "add", "-A")
                lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
                return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

            lanedlib.git(root, "init", "-q")
            lanedlib.git(root, "checkout", "-q", "-b", "main")
            commit({lanedlib.PLAN_PATH: SELFTEST_COUPLED_PLAN, ".gitignore": "__pycache__/\n",
                    "README.md": "x\n", "pkg/__init__.py": ""}, "plan")
            for w, (paths, mod) in wps.items():
                d = lanedlib.wp_dir(w)
                commit({f"tests/accept/{d}/PATHS": paths,
                        f"tests/accept/{d}/test_{d}.py": f"import {mod}\n\n\ndef test_{d}():\n"
                                                         f"    assert {mod}.VALUE == 1\n"}, f"tests {w}")
            undeclared = lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()
            base = commit({lanedlib.COUPLED_BATCHES_PATH: declared}, "W0c: declare C1-C4 coupled")

            def impl(*names: str) -> dict[str, str]:
                out = {"pkg/core.py": code["pkg/core.py"]}
                out.update({f"pkg/{n.lower()}.py": code[f"pkg/{n.lower()}.py"] for n in names})
                return out

            def check(name: str, files: dict[str, str], labels: list[str], wp: str,
                      start: str) -> tuple[int, str, str]:
                lanedlib.git(root, "checkout", "-q", "-B", name, start)
                head = commit(files, name)
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_check_pr(root, wp, start, head, labels)
                return rc, buf.getvalue(), head

            def want_refused(name: str, files: dict[str, str], labels: list[str], want: str,
                             start: str = base) -> None:
                for wp in labels:
                    rc, out, _ = check(f"{name}-{wp}", files, labels, wp, start)
                    if rc == 0 or want not in out or "MODE " in out or "COUPLED " in out:
                        failures.append(f"coupled {name}: {wp} rc={rc}, want {want}: {out.strip()}")

            # the exact declared set: size, dependency and overlap are allowed
            head = ""
            order = ["C3", "C1", "C4", "C2"]          # label order is free
            for wp in order:
                rc, out, head = check(f"coupled-{wp}", impl(*members), order, wp, base)
                lines = [ln for ln in out.splitlines() if ln.startswith(("COUPLED ", "BATCH ", "MODE "))]
                want = ["COUPLED " + " ".join(order), "BATCH " + " ".join(order), "MODE implementation"]
                scopes = sorted(ln for ln in out.splitlines() if ln.startswith("SCOPE "))
                if rc != 0 or lines != want or scopes != sorted(
                        ["SCOPE C1 2 file(s)", "SCOPE C2 2 file(s)", "SCOPE C3 1 file(s)",
                         "SCOPE C4 2 file(s)"]):
                    failures.append(f"coupled exact-set: {wp} rc={rc}: {out.strip()}")
            # every member's own Accept passes on the coupled head
            lanedlib.git(root, "checkout", "-q", head)
            for wp in members:
                with contextlib.redirect_stdout(io.StringIO()) as buf, \
                        contextlib.redirect_stderr(io.StringIO()):
                    rc = cmd_accept(root, wp, None)
                if rc != 0:
                    failures.append(f"coupled accept {wp} failed: {buf.getvalue().strip()[-1500:]}")
            # the rule keeps every other refusal
            want_refused("subset", impl("C1", "C2"), ["C1", "C2"], "FAIL rule1: batch-dependency")
            want_refused("subset-overlap", impl("C1", "C4"), ["C1", "C4"],
                         "FAIL rule1: batch-overlapping-paths")
            want_refused("superset", {**impl(*members), "pkg/e1.py": code["pkg/e1.py"]},
                         [*members, "E1"], "FAIL rule1: batch-too-many")
            want_refused("undeclared", impl(*members), members, "FAIL rule1: batch-too-many", undeclared)
            want_refused("out-of-scope", {**impl(*members), "README.md": "y\n"}, members,
                         "FAIL paths: batch-out-of-scope: outside every coupled WP's PATHS: README.md")
            want_refused("tooling", {**impl(*members), "scripts/laned/x.py": "X = 1\n"}, members,
                         "FAIL paths: batch-out-of-scope")
            want_refused("idle-member", impl("C1", "C2", "C4"), members,
                         "FAIL rule1: batch-label-without-changes: label(s) none of whose PATHS "
                         "the diff touches: laned:C3")
            want_refused("with-tests", {**impl(*members), "tests/accept/c1/test_more.py": SELFTEST_PASSING},
                         members, "FAIL rule1: tests/accept/ edited together with")
            # a PR cannot declare its own set: the file is read at BASE
            want_refused("self-declared", {**impl(*members), lanedlib.COUPLED_BATCHES_PATH: declared},
                         members, "FAIL rule1: batch-too-many", undeclared)
            # the squash merge is each member's L2 commit; a partial one is not
            lanedlib.git(root, "checkout", "-q", "main")
            lanedlib.git(root, "merge", "-q", "--squash", head)
            merged = commit({}, "feat: C1 C2 C3 C4 (#9)")
            built = [w for w in (*members, "E1") if built_on(root, merged, w)]
            if built != members:
                failures.append(f"coupled squash: built {built}, want {members}")
            lanedlib.git(root, "checkout", "-q", "-B", "partial", base)
            partial = commit({"pkg/core.py": "VALUE = 1\n", "pkg/c2.py": code["pkg/c2.py"],
                              "pkg/c4.py": code["pkg/c4.py"]}, "partial")
            if any(built_on(root, partial, w) for w in ("C1", "C3")):
                failures.append("coupled: a merge missing members counted as their L2")
            if lanedlib.parse_coupled_batches(declared) != [("C1", "C2", "C3", "C4")]:
                failures.append(f"coupled parse: {lanedlib.parse_coupled_batches(declared)}")
            if lanedlib.coupled_set_of(["C4", "C3", "C2", "C1"], [("C1", "C2", "C3", "C4")]) is None \
                    or lanedlib.coupled_set_of(["C1", "C2"], [("C1", "C2", "C3", "C4")]) is not None:
                failures.append("coupled_set_of: only the exact set is coupled")
    finally:
        if saved is None:
            os.environ.pop("LANED_PYTEST_CMD", None)
        else:
            os.environ["LANED_PYTEST_CMD"] = saved
    return failures


def cmd_selftest() -> int:
    """Offline check of the RV<n> review mode of --check-pr and of the
    tests-only / tests-correction MODE rules."""
    failures: list[str] = []
    ident = ("-c", "user.name=t", "-c", "user.email=t@t", "-c", "commit.gpgsign=false")
    with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-") as tmp:
        root = Path(tmp) / "repo"
        root.mkdir()

        def put(rel: str, text: str) -> None:
            (root / rel).parent.mkdir(parents=True, exist_ok=True)
            (root / rel).write_text(text)

        def commit(msg: str) -> str:
            lanedlib.git(root, "add", "-A")
            lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
            return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

        lanedlib.git(root, "init", "-q")
        put("README.md", "x\n")
        put("evidence/rv1.md", "Covers: W0c\n")
        base = commit("base")

        def case(name: str, files: dict[str, str | None], wp: str, want_ok: bool) -> None:
            lanedlib.git(root, "checkout", "-q", "-B", name, base)
            for rel, text in files.items():
                if text is None:
                    (root / rel).unlink()
                else:
                    put(rel, text)
            head = commit(name)
            with contextlib.redirect_stdout(io.StringIO()) as buf:
                rc = cmd_check_pr(root, wp, base, head)
            ok = rc == 0 and "MODE review" in buf.getvalue()
            if ok != want_ok:
                failures.append(f"{name}: {wp} check-pr {'passed' if ok else 'failed'}: {buf.getvalue().strip()}")

        case("add", {"evidence/rv2.md": "Covers: W1\n"}, "RV2", True)
        case("modify", {"evidence/rv1.md": "Covers: W0c, W0\n"}, "RV1", True)
        case("plus-other", {"evidence/rv2.md": "r\n", "README.md": "y\n"}, "RV2", False)
        case("wrong-review", {"evidence/rv2.md": "r\n"}, "RV1", False)
        case("plus-tests", {"evidence/rv2.md": "r\n", "tests/accept/w1/test_x.py": "x = 1\n"}, "RV2", False)
        case("delete", {"evidence/rv1.md": None}, "RV1", False)
        case("other-file-only", {"docs/notes.md": "n\n"}, "RV3", False)
    failures += selftest_tests_correction(ident)
    failures += selftest_verification(ident)
    failures += selftest_evidence(ident)
    failures += selftest_w3a_nolock_evidence()
    failures += selftest_wb19_partial_evidence()
    failures += selftest_cross(ident)
    failures += selftest_freshness(ident)
    failures += selftest_batch(ident)
    failures += selftest_batch_impl(ident)
    failures += selftest_coupled(ident)
    for f in failures:
        print(f"accept selftest: FAIL {f}", file=sys.stderr)
    if failures:
        return 1
    print("accept selftest: ok")
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["selftest"]:
        return cmd_selftest()
    ap = argparse.ArgumentParser(prog="accept", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("wp", nargs="?")
    ap.add_argument("--root", default=".")
    ap.add_argument("--evidence")
    ap.add_argument("--expect-fail", action="store_true",
                    help="MODE tests-only: the whole test dir must fail for a right reason")
    ap.add_argument("--verification", action="store_true",
                    help="the MODE tests-only run (needs --base/--head): MODE verification when BASE has "
                         "no L2 commit, every non-test PATHS entry exists on BASE and the full Accept "
                         "passes; otherwise --expect-fail")
    ap.add_argument("--tests-correction", action="store_true",
                    help="MODE tests-correction (needs --base/--head): unchanged test files pass, "
                         "changed ones pass or fail for a right reason")
    ap.add_argument("--check-pr", action="store_true",
                    help="rule 1 + PATHS; prints MODE implementation|tests-only|tests-correction|evidence|review")
    ap.add_argument("--cross", action="store_true",
                    help="(needs --base/--head) accept every other WP at >= L2 on BASE whose tests "
                         "depend on the PR's changes; WP may list the PR's WPs, comma-separated")
    ap.add_argument("--freshness", action="store_true",
                    help="(needs --base/--head/--main) STALE BASE when main moved past the tested base "
                         "with changes the PR's paths touch or import")
    ap.add_argument("--pr-wps", metavar="WP[,WP...]",
                    help="--check-pr: every laned:<WP> label of the PR (BATCH rule for tests-only and "
                         "tests-correction PRs, BATCH IMPLEMENTATION rule for implementation PRs)")
    ap.add_argument("--base")
    ap.add_argument("--head")
    ap.add_argument("--main", metavar="REF", help="--freshness: main's current tip (origin/main)")
    ap.add_argument("--gate", metavar="STAGE")
    args = ap.parse_args(argv)
    root = Path(args.root).resolve()
    if args.gate:
        return cmd_gate(root, args.gate)
    if args.freshness:
        if not (args.base and args.head and args.main):
            ap.error("--freshness needs --base, --head and --main")
        return cmd_freshness(root, args.base, args.head, args.main)
    if args.cross:
        if not (args.wp and args.base and args.head):
            ap.error("--cross needs the PR's WP(s), --base and --head")
        return cmd_cross(root, [w for w in re.split(r"[,\s]+", args.wp) if w], args.base, args.head)
    if not args.wp:
        ap.error("a WP id is required (or --gate STAGE)")
    if args.check_pr:
        if not (args.base and args.head):
            ap.error("--check-pr needs --base and --head")
        pr_wps = [w for w in re.split(r"[,\s]+", args.pr_wps or "") if w]
        return cmd_check_pr(root, args.wp, args.base, args.head, pr_wps)
    if args.verification:
        if not (args.base and args.head):
            ap.error("--verification needs --base and --head")
        return cmd_verification(root, args.wp, args.base, args.head)
    if args.tests_correction:
        if not (args.base and args.head):
            ap.error("--tests-correction needs --base and --head")
        return cmd_tests_correction(root, args.wp, args.base, args.head)
    if args.expect_fail:
        return cmd_expect_fail(root, args.wp)
    return cmd_accept(root, args.wp, args.evidence)


if __name__ == "__main__":
    sys.exit(main())
