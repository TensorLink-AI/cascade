def paths_at(root: Path, ref: str, wp: str) -> list[str] | None:
    rel = f"tests/accept/{lanedlib.wp_dir(wp)}/PATHS"
    proc = lanedlib.git(root, "show", f"{ref}:{rel}", check=False)
    if proc.returncode == 0:
        return lanedlib.parse_paths(proc.stdout)
    return read_paths(root, wp)


REVIEW_WP = re.compile(r"^RV(\d+)$")


def cmd_check_pr_review(root: Path, wp: str, n: str, base: str, head: str) -> int:
    """A review PR (label laned:RV<n>) adds or edits exactly evidence/rv<n>.md."""
    want = f"evidence/rv{n}.md"
    out = lanedlib.git(root, "diff", "--no-renames", "--name-status", f"{base}...{head}").stdout
    changes = [tuple(line.split("\t", 1)) for line in out.splitlines() if line.strip()]
    if not changes:
        return fail("review", "the PR changes nothing")
    bad = [f"{s} {p}" for s, p in changes if p != want or s not in ("A", "M")]
    if bad:
        return fail("review", f"a {wp} PR may only add or modify {want}; it also has: " + " ".join(bad))
    print("MODE review")
    return 0


def plan_at(root: Path, ref: str) -> str | None:
    """The plan at ``ref`` (the PR cannot edit it: PROTECTED), else the working tree's."""
    proc = lanedlib.git(root, "show", f"{ref}:{lanedlib.PLAN_PATH}", check=False)
    if proc.returncode == 0:
        return proc.stdout
    p = root / lanedlib.PLAN_PATH
    return p.read_text(encoding="utf-8") if p.is_file() else None


def declared_evidence(root: Path, ref: str, wp: str) -> list[str]:
    """The evidence files named by ``--evidence`` in the WP's §3.0 Accept cell at ``ref``."""
    text = plan_at(root, ref)
    return lanedlib.accept_evidence_files(text, wp) if text else []


def cmd_check_pr_evidence(root: Path, wp: str, base: str, head: str,
                          diff: list[str]) -> int | None:
    """MODE evidence (module docstring), or None when the PR is not an evidence PR.

    An evidence PR adds or modifies only evidence files named in the WP's
    Accept cell (plan at BASE). Touching one of them together with anything
    else, deleting one, or an evidence/-only diff naming a file the Accept cell
    does not declare (and the WP's PATHS do not cover) fails ``FAIL evidence``."""
    declared = declared_evidence(root, base, wp)
    out = lanedlib.git(root, "diff", "--no-renames", "--name-status", f"{base}...{head}").stdout
    changes = [tuple(line.split("\t", 1)) for line in out.splitlines() if "\t" in line]
    touched = [p for _, p in changes if p in declared]
    if touched:
        bad = [f"{s} {p}" for s, p in changes if p not in declared or s not in ("A", "M")]
        if bad:
            return fail("evidence", f"an evidence PR for {wp} may only add or modify "
                        + " ".join(declared) + "; it also has: " + " ".join(bad))
        print("MODE evidence")
        for p in touched:
            print(f"EVIDENCE {p}")
        return 0
    if diff and all(p.startswith("evidence/") for p in diff):
        paths = paths_at(root, base, wp) or paths_at(root, head, wp) or []
        if not all(lanedlib.path_matches(p, paths) for p in diff):
            named = " ".join(declared) if declared else "none"
            return fail("evidence", f"not an evidence file named in {wp}'s Accept cell "
                        f"(declared: {named}): " + " ".join(sorted(diff)))
    return None


def cmd_check_pr_batch(root: Path, pr_wps: list[str], base: str,
                       tests: list[str]) -> int:
    """BATCH rule (module docstring): a tests-only diff for the label set
    ``pr_wps`` (more than one WP). Each WP's tests dir is touched only under
    its own label, every label has its tests dir in the diff, and no batched
    WP is already built on BASE (that PR is a tests-correction: one WP per
    PR). Fails closed with ``FAIL rule1: batch-<reason>: ...``."""
    def refuse(reason: str, detail: str) -> int:
        return fail("rule1", f"batch-{reason}: {detail}")

    non_wp = [w for w in pr_wps if REVIEW_WP.match(w)]
    if non_wp:
        return refuse("non-wp-label", "a batch tests-only PR carries only laned:<WP> labels of the WPs "
                      "whose tests it adds; it also has: " + " ".join(f"laned:{w}" for w in non_wp))
    by_dir: dict[str, str] = {}
    for w in pr_wps:
        d = lanedlib.wp_dir(w)
        if d in by_dir:
            return refuse("duplicate-label", f"laned:{by_dir[d]} and laned:{w} name the same "
                          f"tests/accept/{d}/")
        by_dir[d] = w
    touched: dict[str, list[str]] = {}
    stray: list[str] = []
    for p in tests:
        parts = p.split("/")
        if len(parts) < 4:  # tests/accept/<file>: not inside a WP's tests dir
            stray.append(p)
        else:
            touched.setdefault(parts[2], []).append(p)
    if stray:
        return refuse("stray-tests", "paths under tests/accept/ outside every WP's tests dir: "
                      + " ".join(sorted(stray)))
    unlabelled = sorted(d for d in touched if d not in by_dir)
    if unlabelled:
        return refuse("unlabelled-tests", "tests dir(s) without their laned:<WP> label: "
                      + " ".join(f"tests/accept/{d}/" for d in unlabelled))
    missing = sorted(w for d, w in by_dir.items() if d not in touched)
    if missing:
        return refuse("label-without-tests", "label(s) whose tests/accept/<wp>/ the diff does not touch: "
                      + " ".join(f"laned:{w}" for w in missing))
    built = [w for w in pr_wps if built_on(root, base, w)]
    if built and len(built) == len(pr_wps):
        # plan rev6.3 (b): corrections for up to BATCH_IMPL_MAX built WPs,
        # each run in tests-correction mode on its own
        if len(pr_wps) > lanedlib.BATCH_IMPL_MAX:
            return refuse("too-many", f"{len(pr_wps)} WPs ({' '.join(pr_wps)}); a tests-correction PR "
                          f"batches at most {lanedlib.BATCH_IMPL_MAX}")
        print("BATCH " + " ".join(pr_wps))
        print("MODE tests-correction")
        return 0
    if built:
        unbuilt = [w for w in pr_wps if w not in built]
        return refuse("built-wp", f"{' '.join(built)} already built on {base} (L2 commit) but "
                      f"{' '.join(unbuilt)} not: a batch is all tests-only (new WPs) or all "
                      "tests-corrections (built WPs), never both")
    print("BATCH " + " ".join(pr_wps))
    print("MODE tests-only")
    return 0


def _literal_prefix(entry: str) -> str:
    k = min((entry.find(c) for c in lanedlib.GLOB_CHARS if c in entry), default=len(entry))
    return entry[:k]


def entries_overlap(a: str, b: str) -> bool:
    """Can one path match both PATHS entries? Conservative for globs (fnmatch
    ``*`` crosses ``/``): two globs overlap when one literal prefix extends
    the other, a glob and a plain entry when either matches the other or the
    glob's literal prefix lies inside the plain dir/ entry."""
    ga = any(c in a for c in lanedlib.GLOB_CHARS)
    gb = any(c in b for c in lanedlib.GLOB_CHARS)
    if not ga and not gb:
        return (lanedlib.path_matches(a.rstrip("/"), [b]) or lanedlib.path_matches(b.rstrip("/"), [a])
                or (a.endswith("/") and b.startswith(a)) or (b.endswith("/") and a.startswith(b)))
    if ga and gb:
        pa, pb = _literal_prefix(a), _literal_prefix(b)
        return pa.startswith(pb) or pb.startswith(pa)
    glob, plain = (a, b) if ga else (b, a)
    pre = _literal_prefix(glob)
    if lanedlib.path_matches(plain.rstrip("/"), [glob]):
        return True
    if plain.endswith("/"):
        return pre.startswith(plain) or plain.startswith(pre)
    return False


def _coupled_scope(root: Path, pr_wps: list[str], sets: dict[str, list[str]],
                   diff: list[str], refuse) -> int:
    """Scope of a declared coupled batch (COUPLED rule): every changed file in
    at least one member's PATHS (a file in several is owned by each), no
    PROTECTED file and no scripts/laned/ file unless W0c owns it, and every
    member owns a changed file."""
    outside: list[str] = []
    owned: dict[str, list[str]] = {w: [] for w in pr_wps}
    for p in diff:
        owners = [w for w in pr_wps if lanedlib.path_matches(p, sets[w])]
        if p in PROTECTED or (p.startswith("scripts/laned/") and TOOLING_WP not in owners) or not owners:
            outside.append(p)
            continue
        for w in owners:
            owned[w].append(p)
    if outside:
        return refuse("out-of-scope", "outside every coupled WP's PATHS: " + " ".join(sorted(outside)),
                      "paths")
    idle = [w for w in pr_wps if not owned[w]]
    if idle:
        return refuse("label-without-changes", "label(s) none of whose PATHS the diff touches: "
                      + " ".join(f"laned:{w}" for w in idle))
    print("COUPLED " + " ".join(pr_wps))
    print("BATCH " + " ".join(pr_wps))
    for w in pr_wps:
        print(f"SCOPE {w} {len(owned[w])} file(s)")
    print("MODE implementation")
    return 0


def cmd_check_pr_impl_batch(root: Path, pr_wps: list[str], base: str, head: str,
                            diff: list[str]) -> int:
    """BATCH IMPLEMENTATION rule (module docstring; plan rev6.3 (b)): one
    implementation PR for up to BATCH_IMPL_MAX WPs. Fails closed with
    ``FAIL rule1: batch-<reason>: ...`` (or ``FAIL paths: batch-<reason>``
    for a file in no, or more than one, batch WP's PATHS)."""
    def refuse(reason: str, detail: str, step: str = "rule1") -> int:
        return fail(step, f"batch-{reason}: {detail}")

    # COUPLED rule: the exact set of a declared coupled batch (read at BASE)
    # skips the size, dependency and disjoint-PATHS checks; nothing else.
    coupled = lanedlib.coupled_set_of(pr_wps, lanedlib.coupled_batches_at(root, base))
    if coupled is None and len(pr_wps) > lanedlib.BATCH_IMPL_MAX:
        return refuse("too-many", f"{len(pr_wps)} WPs ({' '.join(pr_wps)}); an implementation PR "
                      f"batches at most {lanedlib.BATCH_IMPL_MAX}")
    non_wp = [w for w in pr_wps if REVIEW_WP.match(w)]
    if non_wp:
        return refuse("non-wp-label", "a batch implementation PR carries only laned:<WP> labels; it also has: "
                      + " ".join(f"laned:{w}" for w in non_wp))
    seen: dict[str, str] = {}
    for w in pr_wps:
        d = lanedlib.wp_dir(w)
        if d in seen:
            return refuse("duplicate-label", f"laned:{seen[d]} and laned:{w} name the same tests/accept/{d}/")
        seen[d] = w
    # (3) each WP's tests are already on main (BASE): PATHS and a test file
    sets: dict[str, list[str]] = {}
    no_tests: list[str] = []
    for w in pr_wps:
        d = lanedlib.wp_dir(w)
        proc = lanedlib.git(root, "show", f"{base}:tests/accept/{d}/PATHS", check=False)
        listed = lanedlib.git(root, "ls-tree", "-r", "--name-only", base, "--",
                              f"tests/accept/{d}/", check=False).stdout.split()
        if proc.returncode != 0 or not any(is_test_file(p) for p in listed):
            no_tests.append(w)
            continue
        sets[w] = lanedlib.parse_paths(proc.stdout)
    if no_tests:
        return refuse("no-tests", f"{' '.join(no_tests)} has no tests/accept/<wp>/ (PATHS and a test file) "
                      f"on {base}: its tests PR merges first")
    if coupled is not None:
        return _coupled_scope(root, pr_wps, sets, diff, refuse)
    # (2) no WP of the batch depends on another (plan §3.0 Depends at BASE, transitive)
    plan = plan_at(root, base)
    deps = lanedlib.plan_wp_depends(plan) if plan else {}
    unknown = [w for w in pr_wps if deps.get(w) is None]
    if unknown:
        return refuse("deps-unknown", f"cannot tell the dependencies of {' '.join(unknown)} from the plan at "
                      f"{base} (no §3.0 WP row with a Depends column); batch them in separate PRs")
    ids = list(deps)

    def direct(w: str) -> set[str]:
        cell = deps.get(w) or ""
        return {x for x in ids if x != w and lanedlib.has_token(cell, x)}

    for a in pr_wps:
        reach: set[str] = set()
        todo = list(direct(a))
        while todo:
            x = todo.pop()
            if x in reach:
                continue
            reach.add(x)
            todo += list(direct(x) - reach)
        hit = [b for b in pr_wps if b != a and b in reach]
        if hit:
            how = "" if hit[0] in direct(a) else " (transitively)"
            return refuse("dependency", f"{a} depends on {hit[0]}{how} (plan §3.0 Depends): "
                          "implement them in separate PRs, the dependency first")
    # (1) PATHS sets disjoint (entry-wise, and over the files at BASE and HEAD)
    files = set(lanedlib.git(root, "ls-tree", "-r", "--name-only", base).stdout.split())
    files |= set(lanedlib.git(root, "ls-tree", "-r", "--name-only", head).stdout.split())
    for i, a in enumerate(pr_wps):
        for b in pr_wps[i + 1:]:
            pairs = [f"{x} ~ {y}" for x in sets[a] for y in sets[b] if entries_overlap(x, y)]
            both = sorted(f for f in files if lanedlib.path_matches(f, sets[a])
                          and lanedlib.path_matches(f, sets[b]))
            if pairs or both:
                return refuse("overlapping-paths", f"the PATHS of {a} and {b} overlap: "
                              + " ".join(pairs or both))
    # scope: every changed file falls in exactly one batch WP's PATHS
    outside: list[str] = []
    ambiguous: list[str] = []
    owned: dict[str, list[str]] = {w: [] for w in pr_wps}
    for p in diff:
        owners = [w for w in pr_wps if lanedlib.path_matches(p, sets[w])]
        if p in PROTECTED or (p.startswith("scripts/laned/") and owners != [TOOLING_WP]) or not owners:
            outside.append(p)
        elif len(owners) > 1:
            ambiguous.append(f"{p} ({' '.join(owners)})")
        else:
            owned[owners[0]].append(p)
    if outside:
        return refuse("out-of-scope", "outside every batch WP's PATHS: " + " ".join(sorted(outside)), "paths")
    if ambiguous:
        return refuse("ambiguous", "in more than one batch WP's PATHS: " + " ".join(sorted(ambiguous)), "paths")
    idle = [w for w in pr_wps if not owned[w]]
    if idle:
        return refuse("label-without-changes", "label(s) none of whose PATHS the diff touches: "
                      + " ".join(f"laned:{w}" for w in idle))
    print("BATCH " + " ".join(pr_wps))
    for w in pr_wps:
        print(f"SCOPE {w} {len(owned[w])} file(s)")
    print("MODE implementation")
    return 0


def cmd_check_pr(root: Path, wp: str, base: str, head: str,
                 pr_wps: list[str] | None = None) -> int:
    m = REVIEW_WP.match(wp)
    if m:
        return cmd_check_pr_review(root, wp, m.group(1), base, head)
    diff = lanedlib.git(root, "diff", "--name-only", f"{base}...{head}").stdout.split()
    if not diff:
        return fail("paths", "the PR changes nothing")
    rc = cmd_check_pr_evidence(root, wp, base, head, diff)
    if rc is not None:
        return rc
    tests = [p for p in diff if p.startswith("tests/accept/")]
    others = [p for p in diff if not p.startswith("tests/accept/")]
    if tests and others:
        return fail("rule1", "tests/accept/ edited together with: " + " ".join(others))
    labels = list(dict.fromkeys([*(pr_wps or []), wp]))
    if tests and len(labels) > 1:
        return cmd_check_pr_batch(root, labels, base, tests)
    if tests:
        own = f"tests/accept/{lanedlib.wp_dir(wp)}/"
        foreign = [p for p in tests if not p.startswith(own)]
        if foreign:
            return fail("rule1", f"tests-only PR for {wp} touches another WP's tests: " + " ".join(foreign))
        # MODE rules (module docstring): a WP already built on BASE gets a
        # tests-correction run, an unbuilt one the classic expect-fail run.
        print("MODE tests-correction" if built_on(root, base, wp) else "MODE tests-only")
        return 0
    if len(labels) > 1:
        return cmd_check_pr_impl_batch(root, labels, base, head, diff)
    paths = paths_at(root, base, wp) or paths_at(root, head, wp)
    if not paths:
        return fail("paths", f"no tests/accept/{lanedlib.wp_dir(wp)}/PATHS")
    outside = [p for p in diff if not lanedlib.path_matches(p, paths)]
    if wp != TOOLING_WP:
        outside += [p for p in diff if p.startswith("scripts/laned/") and p not in outside]
    outside += [p for p in diff if p in PROTECTED and p not in outside]
    if outside:
        return fail("paths", "outside the WP's PATHS: " + " ".join(sorted(outside)))
    print("MODE implementation")
    return 0


# ---------------------------------------------------------------------------
# tests-correction (a tests-only PR for a WP already built on BASE)
# ---------------------------------------------------------------------------

def built_on(root: Path, ref: str, wp: str) -> bool:
    """True when ``ref`` carries the WP's implementation: its first-parent
    line has the L2 commit (the status board's rule, lanedlib.impl_commit_index)
    for the PATHS file at ``ref``. No PATHS at ``ref`` means a new WP."""
    rel = f"tests/accept/{lanedlib.wp_dir(wp)}/PATHS"
    proc = lanedlib.git(root, "show", f"{ref}:{rel}", check=False)
    if proc.returncode != 0:
        return False
    history = lanedlib.first_parent_history(root, ref)
    sets = lanedlib.paths_sets_at(root, ref)
    others = lanedlib.other_paths(sets, wp)
    coupled = lanedlib.coupled_paths(lanedlib.coupled_batches_at(root, ref), sets, wp)
    return lanedlib.impl_commit_index(history, wp, lanedlib.parse_paths(proc.stdout), others,
                                      coupled) is not None


def is_test_file(rel: str) -> bool:
    name = rel.rsplit("/", 1)[-1]
    return name.endswith(".py") and (name.startswith("test_") or name.endswith("_test.py"))


def wp_test_files(root: Path, wp: str) -> list[str]:
    d = test_dir(root, wp)
    return sorted(p.relative_to(root).as_posix() for p in d.rglob("*.py")
                  if is_test_file(p.name) and "__pycache__" not in p.parts)


def _module_files(base: str, dotted: str) -> list[str]:
    """Candidate files for module ``a.b`` under dir ``base``: every prefix as
    ``.py`` or a package ``__init__.py`` (importing ``a.b`` runs ``a`` too)."""
    parts = [p for p in dotted.split(".") if p]
    out: list[str] = []
    for i in range(1, len(parts) + 1):
        stem = posixpath.normpath(posixpath.join(base or ".", *parts[:i]))
        out += [stem + ".py", stem + "/__init__.py"]
    return out


def _module_refs(rel: str, text: str, own_dir: str,
                 extra_bases: tuple[str, ...] = ()) -> tuple[list[str], set[str]]:
    """(candidate module files ``rel`` imports, its string constants) by AST."""
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return [], set()
    here = posixpath.dirname(rel)
    # absolute imports resolve against the repo root (package mode), the
    # module's own dir (pytest rootdir-less prepend) and the WP dir
    bases = ("", here, own_dir.rstrip("/"), *extra_bases)
    cands: list[str] = []
    strings: set[str] = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                for b in bases:
                    cands += _module_files(b, alias.name)
        elif isinstance(node, ast.ImportFrom):
            mod = node.module or ""
            if node.level:
                base = here
                for _ in range(node.level - 1):
                    base = posixpath.dirname(base)
                roots: tuple[str, ...] = (base,)
                cands.append(posixpath.normpath(posixpath.join(base or ".", "__init__.py")))
            else:
                roots = bases
            for b in roots:
                if mod:
                    cands += _module_files(b, mod)
                for alias in node.names:
                    cands += _module_files(b, f"{mod}.{alias.name}" if mod else alias.name)
        elif isinstance(node, ast.Constant) and isinstance(node.value, str):
            strings.add(node.value)
    return cands, strings


def _data_referenced(f: str, own_dir: str, strings: set[str]) -> bool:
    """Is the (non-.py) WP-dir file ``f`` named by one of the string constants?
    A constant matches the file's basename, its path relative to the WP dir or
    the repo, or a directory containing it (``"fixtures"``)."""
    rel = f[len(own_dir):]
    base = posixpath.basename(f)
    for s in strings:
        s = s.strip().strip("/")
        if not s or s == "." or "\n" in s:
            continue
        if s in (base, rel, f) or rel.startswith(s + "/") or f.startswith(s + "/") \
                or rel.endswith("/" + s):
            return True
    return False


def module_closure(root: Path, test_rel: str, own_dir: str,
                      changed: set[str]) -> tuple[set[str], set[str]]:
    """Static closure of one test module inside the WP dir ``own_dir``:
    (module files it depends on, string constants in them). Ancestor
    ``conftest.py`` / ``__init__.py`` files inside the WP dir count too."""
    seen: set[str] = set()
    strings: set[str] = set()
    todo = [test_rel]
    d = posixpath.dirname(test_rel)
    while d.startswith(own_dir.rstrip("/")):
        todo += [f"{d}/conftest.py", f"{d}/__init__.py"]
        d = posixpath.dirname(d)
    while todo:
        rel = todo.pop()
        if rel in seen or not rel.startswith(own_dir):
            continue
        path = root / rel
        if not path.is_file() and rel not in changed:
            continue
        seen.add(rel)
        if not path.is_file():
            continue
        cands, consts = _module_refs(rel, path.read_text(encoding="utf-8", errors="replace"), own_dir)
        strings |= consts
        todo += [c for c in cands if c not in seen]
    return seen, strings


def changed_test_files(root: Path, wp: str, diff: list[str]) -> tuple[list[str], dict[str, list[str]]]:
    """Test files the PR changes: edited/added directly, or one whose static
    closure inside tests/accept/<wp>/ (imported helpers, conftest, package
    __init__, fixture files it names) has a changed file. Returns the list and
    ``{test: [changed dependency, ...]}`` for the indirect ones."""
    own = f"tests/accept/{lanedlib.wp_dir(wp)}/"
    changed = {p for p in diff if p.startswith(own)}
    data = sorted(p for p in changed if not p.endswith(".py"))
    out: list[str] = []
    why: dict[str, list[str]] = {}
    for t in wp_test_files(root, wp):
        if t in changed:
            out.append(t)
            continue
        mods, strings = module_closure(root, t, own, changed)
        hits = sorted(mods & changed) + [f for f in data if _data_referenced(f, own, strings)]
        if hits:
            out.append(t)
            why[t] = hits
    return out, why


def cmd_tests_correction(root: Path, wp: str, base: str, head: str) -> int:
    """MODE tests-correction (module docstring): unchanged test files must
    pass; changed test files may fail, but only for a right reason."""
    step = "tests-correction"
    if not test_dir(root, wp).is_dir():
        return fail(step, f"no tests at tests/accept/{lanedlib.wp_dir(wp)}/")
    paths = read_paths(root, wp)
    if paths is None:
        return fail(step, "no PATHS file")
    if not built_on(root, base, wp):
        return fail(step, f"{wp} has no implementation on {base}; a tests-only PR runs --expect-fail")
    if step_invariant10(root, wp):
        return 1
    diff = lanedlib.git(root, "diff", "--name-only", f"{base}...{head}").stdout.split()
    all_tests = wp_test_files(root, wp)
    changed, indirect = changed_test_files(root, wp, diff)
    unchanged = [p for p in all_tests if p not in changed]
    for t, hits in sorted(indirect.items()):
        print(f"changed via dependency {t}: " + " ".join(hits))
    print(f"{step}: {len(changed)} changed test file(s) ({len(indirect)} via a changed helper, "
          f"conftest or fixture), {len(unchanged)} unchanged")
    if unchanged:
        proc = run_pytest(root, wp, [], env=evidence_env(root, None), targets=unchanged)
        sys.stdout.write(proc.stdout[-20000:])
        sys.stderr.write(proc.stderr[-5000:])
        if proc.returncode not in (0, 5):  # 5: the files collect no test
            return fail(step, f"a test the PR does not change fails (pytest exit {proc.returncode})")
        print("ok unchanged tests pass")
    right = 0
    if changed:
        res = classify_run(root, wp, paths, targets=changed)
        if isinstance(res, str):
            return fail(step, res)
        collected, passed, right, wrong = res
        print(f"{step}: changed tests {collected} collected, {passed} passed, "
              f"{right} right-reason, {wrong} wrong-reason")
        if wrong:
            return fail(step, f"{wrong} failure(s) for a wrong reason")
    if right:
        print(f"MODE tests-correction PASS ({right} changed test(s) fail for a right reason, "
              "pending an implementation PR)")
    else:
        print("MODE tests-correction PASS")
    print(f"PASS {wp} tests-correction")
    return 0


# ---------------------------------------------------------------------------
# cross (other built WPs whose tests depend on what the PR changes)
# ---------------------------------------------------------------------------

# A change to one of these can break any WP's tests: every built WP runs.
CROSS_GLOBAL = frozenset({"pyproject.toml", "uv.lock", "conftest.py", "tests/conftest.py",
                          "tests/__init__.py", "tests/accept/__init__.py", "pytest.ini",
                          "setup.cfg", "tox.ini"})
# absolute imports in a test or repo module also resolve against these
# (pytest's rootdir-less prepend puts tests/accept or tests first on sys.path)
CROSS_BASES = ("tests/accept", "tests")


def wp_ids_at(root: Path, ref: str) -> dict[str, str]:
    """``{tests/accept dir name: WP id}`` from the §3.0 tables of the plan at ``ref``."""
    text = plan_at(root, ref)
    out: dict[str, str] = {}
    for wp in lanedlib.plan_wp_ids(text) if text else []:
        out.setdefault(lanedlib.wp_dir(wp), wp)
    return out


def built_wps_at(root: Path, ref: str) -> list[tuple[str, list[str]]]:
    """``[(WP, PATHS at ref)]`` for every WP at L2 on ``ref`` by the status
    board's L2 rule: an implementation commit on the first-parent line
    (lanedlib.impl_commit_index), or, for a declared verification WP
    (scripts/laned/verification_wps at ``ref``), every non-test PATHS entry
    present at ``ref`` (RV5: its L2 came from the verification merge, which
    has no implementation commit). The board's ledger preconditions (a green
    expect-fail or verification run) are not re-checked here: without the
    ledger, include the WP."""
    out = lanedlib.git(root, "ls-tree", "--name-only", f"{ref}:tests/accept", check=False).stdout.split()
    ids = wp_ids_at(root, ref)
    history = lanedlib.first_parent_history(root, ref)
    verification = lanedlib.verification_wps_at(root, ref)
    sets = lanedlib.paths_sets_at(root, ref)
    coupled = lanedlib.coupled_batches_at(root, ref)
    built: list[tuple[str, list[str]]] = []
    for d in sorted(out):
        proc = lanedlib.git(root, "show", f"{ref}:tests/accept/{d}/PATHS", check=False)
        if proc.returncode != 0:
            continue
        wp = ids.get(d, d)
        paths = lanedlib.parse_paths(proc.stdout)
        if lanedlib.impl_commit_index(history, wp, paths, lanedlib.other_paths(sets, d),
                                      lanedlib.coupled_paths(coupled, sets, wp)) is not None or (
                wp in verification and not lanedlib.missing_paths_at(root, ref, paths)):
            built.append((wp, paths))
    return built


# (rel path, text) -> _module_refs: one AST parse per file content per run
_REFS_CACHE: dict[tuple[str, str], tuple[list[str], set[str]]] = {}


def import_closure(root: Path, start: list[str]) -> tuple[set[str], set[str]]:
    """Static import closure (AST, transitive, any repo file) of ``start``:
    (repo-relative module files reached, string constants of the ``start``
    files). Package ``__init__.py`` files of every imported module count."""
    seen: set[str] = set()
    strings: set[str] = set()
    firsts = set(start)
    todo = list(start)
    while todo:
        rel = posixpath.normpath(todo.pop())
        if rel in seen or rel.startswith("..") or not rel.endswith(".py"):
            continue
        path = root / rel
        if not path.is_file():
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        key = (rel, text)
        if key not in _REFS_CACHE:
            _REFS_CACHE[key] = _module_refs(rel, text, "", CROSS_BASES)
        seen.add(rel)
        cands, consts = _REFS_CACHE[key]
        if rel in firsts:
            strings |= consts
        todo += [c for c in cands if c not in seen]
    return seen, strings


def _string_names(s: str, changed: str) -> bool:
    """Does the test-dir string constant ``s`` name the changed path?"""
    s = s.strip()
    if not s or "\n" in s or len(s) > 300:
        return False
    s = s.strip("/")
    if not s or s == ".":
        return False
    if s == changed or changed.startswith(s + "/") and "/" in s:
        return True
    if "/" in s and changed.endswith("/" + s):
        return True
    # a bare file name (chain.toml) for a non-module file
    return not changed.endswith(".py") and "." in s and s == posixpath.basename(changed)


def cross_reasons(root: Path, wp: str, paths: list[str], diff: list[str]) -> list[str]:
    """Why ``wp``'s tests depend on the changed paths (empty: they don't)."""
    d = f"tests/accept/{lanedlib.wp_dir(wp)}/"
    why: list[str] = []
    glob = sorted(p for p in diff if p in CROSS_GLOBAL)
    if glob:
        why.append("global input " + " ".join(glob))
    own = sorted(p for p in diff if p.startswith(d))
    if own:
        why.append("its tests " + " ".join(own))
    overlap = sorted(p for p in diff if lanedlib.path_matches(p, paths))
    if overlap:
        why.append("PATHS overlap " + " ".join(overlap))
    tdir = root / d
    start = sorted(p.relative_to(root).as_posix() for p in tdir.rglob("*.py")
                   if "__pycache__" not in p.parts) if tdir.is_dir() else []
    mods, strings = import_closure(root, start)
    imported = sorted(p for p in diff if p in mods and not p.startswith(d))
    if imported:
        why.append("imports " + " ".join(imported))
    named = sorted(p for p in diff if p not in mods and not p.startswith(d)
                   and any(_string_names(s, p) for s in strings))
    if named:
        why.append("names " + " ".join(named))
    return why


def cross_select(root: Path, base: str, head: str,
                 pr_wps: list[str]) -> list[tuple[str, list[str], list[str]]]:
    """``[(WP, PATHS, reasons)]``: every WP other than the PR's own that is
    built on BASE and whose tests depend on the PR's changed paths."""
    diff = lanedlib.git(root, "diff", "--name-only", f"{base}...{head}").stdout.split()
    own = {lanedlib.wp_dir(w) for w in pr_wps}
    out = []
    for wp, paths in built_wps_at(root, base):
        if lanedlib.wp_dir(wp) in own:
            continue  # the PR's own WP: its main step already ran it
        why = cross_reasons(root, wp, paths, diff)
        if why:
            out.append((wp, paths, why))
    return out


def _collision_groups(root: Path, wps: list[str]) -> list[list[str]]:
    """Split WPs so one pytest run never imports two same-named top-level
    modules (test dirs without ``__init__.py`` import by basename)."""
    groups: list[tuple[list[str], set[str]]] = []
    for wp in wps:
        d = test_dir(root, wp)
        names = set() if (d / "__init__.py").is_file() else {
            p.name for p in d.rglob("*.py") if "__pycache__" not in p.parts}
        for members, used in groups:
            if not names & used:
                members.append(wp)
                used |= names
                break
        else:
            groups.append(([wp], set(names)))
    return [m for m, _ in groups]


def _owner(case: ET.Element, prefixes: dict[str, str]) -> str | None:
    for field in (case.get("classname") or "", case.get("name") or ""):
        for wp, pre in prefixes.items():
            if field == pre or field.startswith(pre + "."):
                return wp
    return None


class CrossRun:
    """One WP's share of a shared pytest run. ``why`` is "" when green.
    ``failed`` holds the failing junit test ids; ``comparable`` is False when
    the outcome is not just attributed test failures (no report, unattributed
    failures, nothing collected, a collection error, a bare pytest exit)."""

    def __init__(self, why: str = "", failed: frozenset[str] = frozenset(), comparable: bool = False):
        self.why, self.failed, self.comparable = why, failed, comparable


def _case_id(case: ET.Element) -> str:
    return f"{case.get('classname', '')}::{case.get('name', '')}"


def cross_pytest(root: Path, wps: list[str]) -> dict[str, CrossRun]:
    """One pytest run per collision group over the WPs' test dirs at ``root``.
    Fails closed: a failure that cannot be attributed to one WP fails every
    WP of its run."""
    res: dict[str, CrossRun] = {}
    for group in _collision_groups(root, wps):
        prefixes = {wp: f"tests.accept.{lanedlib.wp_dir(wp)}" for wp in group}
        with tempfile.TemporaryDirectory(prefix="laned-cross-") as tmp:
            junit = Path(tmp) / "junit.xml"
            proc = run_pytest(root, group[0], [f"--rootdir={root}", f"--junitxml={junit}",
                                               "--continue-on-collection-errors"],
                              env=evidence_env(root, None),
                              targets=[f"tests/accept/{lanedlib.wp_dir(w)}/" for w in group])
            sys.stdout.write(proc.stdout[-20000:])
            sys.stderr.write(proc.stderr[-5000:])
            cases = list(ET.parse(junit).iter("testcase")) if junit.is_file() else None
        if cases is None:
            for wp in group:
                res[wp] = CrossRun(f"pytest wrote no report (exit {proc.returncode})")
            continue
        collected = {wp: 0 for wp in group}
        failed: dict[str, set[str]] = {wp: set() for wp in group}
        collect_err = {wp: False for wp in group}
        stray = 0
        for case in cases:
            bad = [child for child in case if child.tag in ("failure", "error")]
            wp = _owner(case, prefixes)
            if wp is None:
                stray += bool(bad)
                continue
            collected[wp] += 1
            if bad:
                failed[wp].add(_case_id(case))
                collect_err[wp] |= any("collection failure" in (c.get("message") or "") for c in bad)
        any_failed = any(failed.values())
        for wp in group:
            ids = frozenset(failed[wp])
            if stray:
                res[wp] = CrossRun(f"{stray} unattributed failure(s) in the shared run", ids)
            elif ids:
                res[wp] = CrossRun(f"{len(ids)} of {collected[wp]} test(s) failed"
                                   + (" (collection error)" if collect_err[wp] else ""),
                                   ids, comparable=not collect_err[wp])
            elif not collected[wp]:
                res[wp] = CrossRun("no tests collected")
            elif proc.returncode != 0 and not any_failed:
                res[wp] = CrossRun(f"pytest exit {proc.returncode}")
            else:
                res[wp] = CrossRun(comparable=True)
    return res


def cross_base_runs(root: Path, base: str, wps: list[str]) -> dict[str, CrossRun]:
    """The same shared pytest runs for ``wps`` over a temporary detached
    worktree of BASE (removed afterwards)."""
    with tempfile.TemporaryDirectory(prefix="laned-cross-base-") as tmp:
        wt = Path(tmp) / "base"
        proc = lanedlib.git(root, "worktree", "add", "--detach", "-q", str(wt), base, check=False)
        if proc.returncode != 0:
            return {wp: CrossRun(f"no BASE worktree: {proc.stderr.strip()[:200]}") for wp in wps}
        try:
            print(f"+ re-running {' '.join(wps)} at BASE {base}", flush=True)
            missing = [wp for wp in wps if not test_dir(wt, wp).is_dir()]
            out = {wp: CrossRun("no test dir at BASE") for wp in missing}
            out.update(cross_pytest(wt, [wp for wp in wps if wp not in missing]))
            return out
        finally:
            lanedlib.git(root, "worktree", "remove", "--force", str(wt), check=False)
            lanedlib.git(root, "worktree", "prune", check=False)


def _ids(ids: frozenset[str] | set[str], n: int = 8) -> str:
    s = sorted(ids)
    return " ".join(s[:n]) + (f" ... (+{len(s) - n})" if len(s) > n else "")


def cross_against_base(head_run: CrossRun, base_run: CrossRun) -> tuple[str, str]:
    """(KNOWN|FAIL, detail) for a WP whose HEAD run failed: KNOWN only when
    both runs are plain test failures and every HEAD failure fails on BASE."""
    if not head_run.comparable:
        return "FAIL", f"pytest: {head_run.why}"
    if not base_run.comparable:
        return "FAIL", f"pytest: {head_run.why}; BASE run unusable for comparison ({base_run.why})"
    new = head_run.failed - base_run.failed
    if new:
        return "FAIL", f"pytest: {len(new)} regression(s), pass on BASE: {_ids(new)}"
    return "KNOWN", f"{len(head_run.failed)} tests already red on base: {_ids(head_run.failed)}"


def cmd_cross(root: Path, pr_wps: list[str], base: str, head: str) -> int:
    """For every other WP at >= L2 on BASE whose tests depend on the PR's
    changes (module docstring): invariant 10, its pytest (shared runs) and
    stub_scan over its PATHS; no e2e (the main step ran it). A WP whose
    pytest fails is re-run at BASE: failures that are all red on BASE too
    are KNOWN. Prints ``CROSS <WP> PASS|KNOWN|FAIL``; exit 1 when any FAIL."""
    selected = cross_select(root, base, head, pr_wps)
    if not selected:
        print("CROSS none (no other built WP depends on the changed paths)")
        return 0
    for wp, _, why in selected:
        print(f"cross {wp}: " + "; ".join(why))
    verdict: dict[str, tuple[str, str]] = {}  # WP -> (PASS|KNOWN|FAIL, detail)
    runnable = []
    for wp, _, _ in selected:
        if not test_dir(root, wp).is_dir():
            verdict[wp] = ("FAIL", f"no tests at tests/accept/{lanedlib.wp_dir(wp)}/")
        elif unpaired_tests(root, wp):
            verdict[wp] = ("FAIL", "invariant10: unpaired unarmed test(s)")
        else:
            runnable.append(wp)
    head_runs = cross_pytest(root, runnable)
    red = [wp for wp in runnable if head_runs[wp].why]
    base_runs = cross_base_runs(root, base, red) if red else {}
    for wp in runnable:
        run = head_runs[wp]
        verdict[wp] = cross_against_base(run, base_runs[wp]) if run.why else ("PASS", "")
    for wp, paths, _ in selected:
        if verdict[wp][0] == "FAIL":
            continue
        lines, _ = stub_scan.scan(root, paths)
        for line in lines:
            print(line)
        if lines:
            verdict[wp] = ("FAIL", f"stub_scan: {len(lines)} finding(s)")
    failed = 0
    for wp, _, _ in selected:
        word, why = verdict[wp]
        failed += word == "FAIL"
        print(f"CROSS {wp} {word}" + (f" ({why})" if why else ""))
    return 1 if failed else 0


# ---------------------------------------------------------------------------
# freshness (a PR green on a base that main has since moved past)
# ---------------------------------------------------------------------------

def _rev(root: Path, ref: str) -> str | None:
    proc = lanedlib.git(root, "rev-parse", "-q", "--verify", f"{ref}^{{commit}}", check=False)
    return proc.stdout.strip() if proc.returncode == 0 else None


def _py_closure_hits(root: Path, start: list[str], targets: list[str]) -> list[str]:
    """``targets`` reached by the static import closure of the .py files in ``start``."""
    py = [p for p in start if p.endswith(".py")]
    if not py:
        return []
    mods, _ = import_closure(root, py)
    return sorted(t for t in targets if t in mods and t not in py)


def stale_reasons(root: Path, pr_diff: list[str], main_diff: list[str]) -> list[str]:
    """Why the PR's changes and main's changes since the tested base interact
    in the tree at ``root`` (empty: they don't). The cross dependency analysis:
    a path both touched; a changed module of one side importing (statically,
    transitively) a changed path of the other; or a WP whose tests depend
    (cross_reasons) on both diffs."""
    why: list[str] = []
    both = sorted(set(pr_diff) & set(main_diff))
    if both:
        why.append("both touch " + " ".join(both))
    hits = _py_closure_hits(root, pr_diff, main_diff)
    if hits:
        why.append("the PR's modules import " + " ".join(hits))
    hits = _py_closure_hits(root, main_diff, pr_diff)
    if hits:
        why.append("main's changed modules import " + " ".join(hits))
    dirs = sorted(p.name for p in (root / "tests" / "accept").iterdir()
                  if (p / "PATHS").is_file()) if (root / "tests" / "accept").is_dir() else []
    for d in dirs:
        paths = lanedlib.parse_paths((root / "tests" / "accept" / d / "PATHS").read_text())
        on_pr = cross_reasons(root, d, paths, pr_diff)
        if not on_pr:
            continue
        on_main = cross_reasons(root, d, paths, main_diff)
        if on_main:
            why.append(f"tests/accept/{d}/ depends on the PR ({'; '.join(on_pr)}) "
                       f"and on main ({'; '.join(on_main)})")
    return why


def cmd_freshness(root: Path, base: str, head: str, main_ref: str) -> int:
    """The PR job's last step (RV5): the run tested HEAD against BASE (the
    merge commit's first parent, i.e. github.event.pull_request.base.sha's
    tree; HEAD must not itself contain main's newer commits, or they count
    as the PR's changes). When MAIN (origin/main fetched at job time) is BASE, the result is
    fresh. Otherwise the PR is STALE when its changes (BASE...HEAD) interact
    with main's commits since the merge-base of BASE and MAIN (stale_reasons,
    in the PR's tree and in MAIN's tree); a stale PR must update-branch and
    re-run before it merges. Unrelated main commits do not make it stale."""
    b, m = _rev(root, base), _rev(root, main_ref)
    if b is None or m is None:
        print(f"STALE BASE: update-branch and re-run (cannot resolve {base if b is None else main_ref})")
        return 1
    if b == m:
        print(f"FRESH base {b[:12]} is {main_ref}")
        return 0
    mb = lanedlib.git(root, "merge-base", b, m, check=False).stdout.strip()
    if not mb:
        print(f"STALE BASE: update-branch and re-run (no merge-base of {base} and {main_ref})")
        return 1
    pr_diff = lanedlib.git(root, "diff", "--name-only", f"{b}...{head}").stdout.split()
    main_diff = lanedlib.git(root, "diff", "--name-only", f"{mb}..{m}").stdout.split()
    n = lanedlib.git(root, "rev-list", "--count", f"{mb}..{m}").stdout.strip()
    print(f"freshness: tested base {b[:12]}, {main_ref} {m[:12]} is {n} commit(s) past the merge-base "
          f"{mb[:12]}; main touched {len(main_diff)} path(s), the PR {len(pr_diff)}")
    why = stale_reasons(root, pr_diff, main_diff)
    with tempfile.TemporaryDirectory(prefix="laned-fresh-") as tmp:
        wt = Path(tmp) / "main"
        proc = lanedlib.git(root, "worktree", "add", "--detach", "-q", str(wt), m, check=False)
        if proc.returncode != 0:
            print(f"STALE BASE: update-branch and re-run (no worktree of {main_ref}: {proc.stderr.strip()[:200]})")
            return 1
        try:
            why += [f"at {main_ref}: {w}" for w in stale_reasons(wt, pr_diff, main_diff)]
        finally:
            lanedlib.git(root, "worktree", "remove", "--force", str(wt), check=False)
            lanedlib.git(root, "worktree", "prune", check=False)
    if why:
        for w in dict.fromkeys(why):
            print(f"stale: {w if len(w) <= 400 else w[:400] + ' ...'}")
        print("STALE BASE: update-branch and re-run")
        return 1
    print(f"FRESH enough: no change on {main_ref} since {mb[:12]} touches or is imported by the PR's paths")
    return 0


