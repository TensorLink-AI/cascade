#!/usr/bin/env python3
"""Lane D Accept (plan §3 conventions, §3.1, invariant 10, §17.2).

    accept <WP> [--evidence FILE] [--root R]
        invariant10 -> pytest tests/accept/<wp>/ -> stub_scan over PATHS
        -> make laned-e2e (when the Makefile defines it) -> evidence
        With --evidence, pytest and e2e see LANED_EVIDENCE=<abs FILE>: the
        WP's own tests verify the evidence content (plan §3, §17.1 L4).
    accept <WP> --expect-fail [--root R]
        tests-only PRs for an unbuilt WP: tests collected and failing for a
        right reason only
    accept <WP> --tests-correction --base REF --head REF [--root R]
        tests-only PRs for a WP already built on BASE (see MODE rules below)
    accept <WP> --check-pr --base REF --head REF [--root R]
        rule 1 and the WP's PATHS over `git diff --name-only BASE...HEAD`;
        prints the MODE the PR job runs next (rules below);
        for a review WP RV<n>: MODE review iff the diff is exactly an add or
        modify of evidence/rv<n>.md (no tests run)
    accept selftest
        offline check of the review, tests-correction and evidence modes
    accept --gate <STAGE> [--root R]
        evidence/gates/<stage>.json: right stage, every check passed

MODE rules of --check-pr (the PR job runs the named mode next):
    MODE implementation   the diff has no tests/accept/ path and stays inside
                          the WP's PATHS -> full Accept
    MODE tests-only       the diff touches only tests/accept/<wp>/ and BASE has
                          no implementation of the WP (no L2 commit on BASE's
                          first-parent line: a commit after the one adding
                          PATHS that changes non-test files, all inside PATHS)
                          -> --expect-fail over the WP's whole test dir
    MODE tests-correction the diff touches only tests/accept/<wp>/ and BASE
                          already has the WP's implementation (L2 commit found)
                          -> --tests-correction: every test file the PR does
                          NOT change must pass against BASE's implementation;
                          the test files it changes run in expect-fail
                          classification: each failure must be for a right
                          reason (it is pending a follow-up implementation
                          PR), and all of them passing is fine. Any
                          wrong-reason failure, or any failure in an
                          unchanged test file, fails the PR.
                          A test file counts as changed when the PR adds or
                          edits it, or any file in its static closure inside
                          tests/accept/<wp>/: modules it imports (relative,
                          or absolute resolving into the WP dir; transitive),
                          ancestor conftest.py / __init__.py in the WP dir,
                          and non-.py files under the WP dir named by a string
                          constant in that closure (basename, WP-dir-relative
                          path, or a containing directory such as "fixtures").
    MODE evidence         the diff only adds or modifies evidence files named
                          by `--evidence <file>` in the WP's §3.0 Accept cell
                          (plan at BASE); check-pr prints `EVIDENCE <file>`
                          per file -> `accept <WP> --evidence <file>` for each,
                          recorded in the ledger as mode `evidence` with the
                          file's blob sha (the push to main then re-runs it as
                          push/accept --evidence, which is what L4 reads).
                          A declared evidence file together with any other
                          path, a deletion, or an evidence/-only diff naming a
                          file the Accept cell does not declare (and PATHS do
                          not cover) -> FAIL evidence.
    MODE review           RV<n> label, the diff is exactly evidence/rv<n>.md

The pytest command is `uv run --frozen pytest` unless LANED_PYTEST_CMD is set
(shlex-split). It always runs with cwd = --root. Exit 0 means pass.
"""

from __future__ import annotations

import argparse
import ast
import contextlib
import io
import os
import posixpath
import re
import shlex
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))  # `python -P` drops the script dir
import lanedlib  # noqa: E402
import stub_scan  # noqa: E402

UNARMED = "unchanged_when_unarmed"
ARMED = "armed_nonempty_lane_d_effect"
DEF_RE = re.compile(r"^\s*(?:async\s+)?def\s+(test\w*)\s*\(", re.M)
PROTECTED = ("docs/plans/LANE_D_PLAN.md", "docs/plans/STATUS.md", "status/laned_build.json")
TOOLING_WP = "W0c"


def fail(step: str, detail: str = "") -> int:
    print(f"FAIL {step}" + (f": {detail}" if detail else ""))
    return 1


def pytest_cmd() -> list[str]:
    env = os.environ.get("LANED_PYTEST_CMD")
    return shlex.split(env) if env else ["uv", "run", "--frozen", "pytest"]


def test_dir(root: Path, wp: str) -> Path:
    return root / "tests" / "accept" / lanedlib.wp_dir(wp)


def read_paths(root: Path, wp: str) -> list[str] | None:
    pf = test_dir(root, wp) / "PATHS"
    return lanedlib.parse_paths(pf.read_text()) if pf.is_file() else None


# ---------------------------------------------------------------------------
# invariant 10
# ---------------------------------------------------------------------------

def unpaired_tests(root: Path, wp: str) -> list[str]:
    names: set[str] = set()
    for f in sorted(test_dir(root, wp).rglob("test_*.py")):
        names.update(DEF_RE.findall(f.read_text(encoding="utf-8", errors="replace")))
    return sorted(n for n in names if UNARMED in n and n.replace(UNARMED, ARMED) not in names)


def step_invariant10(root: Path, wp: str) -> int:
    missing = unpaired_tests(root, wp)
    if missing:
        for name in missing:
            print(f"unpaired {name} (needs {name.replace(UNARMED, ARMED)})")
        return fail("invariant10", f"{len(missing)} unpaired unarmed test(s)")
    print("ok invariant10")
    return 0


