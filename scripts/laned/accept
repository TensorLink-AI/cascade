def cmd_gate(root: Path, stage: str) -> int:
    rel = lanedlib.gate_path(stage)
    path = root / rel
    text = path.read_text(encoding="utf-8") if path.is_file() else None
    ok, why = lanedlib.check_gate(text, stage)
    if not ok:
        return fail("gate", f"{rel}: {why}")
    print(f"PASS gate {stage}")
    return 0


SELFTEST_PASSING = "def test_ok():\n    assert 1 + 1 == 2\n"
SELFTEST_IMPL_PASS = "import pkg_w9\n\n\ndef test_value():\n    assert pkg_w9.VALUE == 9\n"
SELFTEST_IMPL_FAIL = "import pkg_w9\n\n\ndef test_corrected():\n    assert pkg_w9.VALUE == 10\n"


def selftest_tests_correction(ident: tuple[str, ...]) -> list[str]:
    """The MODE rules for tests-only PRs, on real git repos and real pytest
    (sys.executable -m pytest; LANED_PYTEST_CMD is overridden for the run)."""
    failures: list[str] = []
    saved = os.environ.get("LANED_PYTEST_CMD")
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-tc-") as tmp:
            n = 0

            def repo(built: bool):
                nonlocal n
                n += 1
                root = Path(tmp) / f"repo{n}"
                root.mkdir()

                def put_commit(files: dict[str, str], msg: str) -> str:
                    for rel, text in files.items():
                        (root / rel).parent.mkdir(parents=True, exist_ok=True)
                        (root / rel).write_text(text)
                    lanedlib.git(root, "add", "-A")
                    lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
                    return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

                lanedlib.git(root, "init", "-q")
                put_commit({"README.md": "x\n", "pkg_w9.py": "VALUE = 1\n"}, "seed")
                base = put_commit({"tests/accept/w9/PATHS": "pkg_w9.py\n",
                                   "tests/accept/w9/w9_helper.py": "EXPECTED = 9\n",
                                   "tests/accept/w9/test_w9_value.py":
                                       "import w9_helper\nimport pkg_w9\n\n\ndef test_value():\n"
                                       "    assert pkg_w9.VALUE == w9_helper.EXPECTED\n"},
                                  "tests-only")
                if built:
                    base = put_commit({"pkg_w9.py": "VALUE = 9\n"}, "implementation")
                return root, base, put_commit

            def case(name: str, built: bool, files: dict[str, str], want_mode: str, want_ok: bool) -> None:
                root, base, put_commit = repo(built)
                head = put_commit(files, name)
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_check_pr(root, "W9", base, head)
                out = buf.getvalue()
                if rc != 0 or f"MODE {want_mode}\n" not in out:
                    failures.append(f"{name}: check-pr rc={rc}, want MODE {want_mode}: {out.strip()}")
                    return
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    if want_mode == "tests-only":
                        rc = cmd_expect_fail(root, "W9")
                    else:
                        rc = cmd_tests_correction(root, "W9", base, head)
                out = buf.getvalue()
                ok = rc == 0 and (want_mode == "tests-only" or "MODE tests-correction PASS" in out)
                if ok != want_ok:
                    failures.append(f"{name}: {want_mode} {'passed' if ok else 'failed'}, "
                                    f"want {'pass' if want_ok else 'fail'}: {out.strip()[-2000:]}")

            # new WP, tests-only PR -> classic expect-fail (unchanged)
            case("new-wp-tests-only", False, {"tests/accept/w9/test_w9_more.py": SELFTEST_IMPL_FAIL},
                 "tests-only", True)
            # built WP + new passing tests -> pass
            case("built-new-passing", True, {"tests/accept/w9/test_w9_more.py": SELFTEST_PASSING},
                 "tests-correction", True)
            # built WP + new tests failing for a right reason -> pass (pending impl fix)
            case("built-new-failing-right", True, {"tests/accept/w9/test_w9_more.py": SELFTEST_IMPL_FAIL},
                 "tests-correction", True)
            # built WP + a corrected (edited) existing test failing for a right reason -> pass
            case("built-edited-failing-right", True,
                 {"tests/accept/w9/test_w9_value.py": SELFTEST_IMPL_FAIL}, "tests-correction", True)
            # built WP + an existing (unchanged) test now failing -> FAIL
            case("built-existing-now-failing", True,
                 {"tests/accept/w9/w9_helper.py": "EXPECTED = 10\n",
                  "tests/accept/w9/test_w9_more.py": SELFTEST_IMPL_PASS}, "tests-correction", False)
            # built WP + a changed test failing for a wrong reason -> FAIL
            case("built-new-failing-wrong", True,
                 {"tests/accept/w9/test_w9_more.py": "import laned_no_such_dep\n\n\ndef test_x():\n"
                                                     "    assert laned_no_such_dep\n"},
                 "tests-correction", False)
    finally:
        if saved is None:
            os.environ.pop("LANED_PYTEST_CMD", None)
        else:
            os.environ["LANED_PYTEST_CMD"] = saved
    return failures


def cmd_selftest() -> int:
    """Offline check of the RV<n> review mode of --check-pr and of the
    tests-only / tests-correction MODE rules."""
    failures: list[str] = []
    ident = ("-c", "user.name=t", "-c", "user.email=t@t", "-c", "commit.gpgsign=false")
    with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-") as tmp:
        root = Path(tmp) / "repo"
        root.mkdir()

        def put(rel: str, text: str) -> None:
            (root / rel).parent.mkdir(parents=True, exist_ok=True)
            (root / rel).write_text(text)

        def commit(msg: str) -> str:
            lanedlib.git(root, "add", "-A")
            lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
            return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

        lanedlib.git(root, "init", "-q")
        put("README.md", "x\n")
        put("evidence/rv1.md", "Covers: W0c\n")
        base = commit("base")

        def case(name: str, files: dict[str, str | None], wp: str, want_ok: bool) -> None:
            lanedlib.git(root, "checkout", "-q", "-B", name, base)
            for rel, text in files.items():
                if text is None:
                    (root / rel).unlink()
                else:
                    put(rel, text)
            head = commit(name)
            with contextlib.redirect_stdout(io.StringIO()) as buf:
                rc = cmd_check_pr(root, wp, base, head)
            ok = rc == 0 and "MODE review" in buf.getvalue()
            if ok != want_ok:
                failures.append(f"{name}: {wp} check-pr {'passed' if ok else 'failed'}: {buf.getvalue().strip()}")

        case("add", {"evidence/rv2.md": "Covers: W1\n"}, "RV2", True)
        case("modify", {"evidence/rv1.md": "Covers: W0c, W0\n"}, "RV1", True)
        case("plus-other", {"evidence/rv2.md": "r\n", "README.md": "y\n"}, "RV2", False)
        case("wrong-review", {"evidence/rv2.md": "r\n"}, "RV1", False)
        case("plus-tests", {"evidence/rv2.md": "r\n", "tests/accept/w1/test_x.py": "x = 1\n"}, "RV2", False)
        case("delete", {"evidence/rv1.md": None}, "RV1", False)
        case("other-file-only", {"docs/notes.md": "n\n"}, "RV3", False)
    failures += selftest_tests_correction(ident)
    for f in failures:
        print(f"accept selftest: FAIL {f}", file=sys.stderr)
    if failures:
        return 1
    print("accept selftest: ok")
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["selftest"]:
        return cmd_selftest()
    ap = argparse.ArgumentParser(prog="accept", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("wp", nargs="?")
    ap.add_argument("--root", default=".")
    ap.add_argument("--evidence")
    ap.add_argument("--expect-fail", action="store_true",
                    help="MODE tests-only: the whole test dir must fail for a right reason")
    ap.add_argument("--tests-correction", action="store_true",
                    help="MODE tests-correction (needs --base/--head): unchanged test files pass, "
                         "changed ones pass or fail for a right reason")
    ap.add_argument("--check-pr", action="store_true",
                    help="rule 1 + PATHS; prints MODE implementation|tests-only|tests-correction|review")
    ap.add_argument("--base")
    ap.add_argument("--head")
    ap.add_argument("--gate", metavar="STAGE")
    args = ap.parse_args(argv)
    root = Path(args.root).resolve()
    if args.gate:
        return cmd_gate(root, args.gate)
    if not args.wp:
        ap.error("a WP id is required (or --gate STAGE)")
    if args.check_pr:
        if not (args.base and args.head):
            ap.error("--check-pr needs --base and --head")
        return cmd_check_pr(root, args.wp, args.base, args.head)
    if args.tests_correction:
        if not (args.base and args.head):
            ap.error("--tests-correction needs --base and --head")
        return cmd_tests_correction(root, args.wp, args.base, args.head)
    if args.expect_fail:
        return cmd_expect_fail(root, args.wp)
    return cmd_accept(root, args.wp, args.evidence)


if __name__ == "__main__":
    sys.exit(main())
