def cmd_gate(root: Path, stage: str) -> int:
    rel = lanedlib.gate_path(stage)
    path = root / rel
    text = path.read_text(encoding="utf-8") if path.is_file() else None
    ok, why = lanedlib.check_gate(text, stage)
    if not ok:
        return fail("gate", f"{rel}: {why}")
    print(f"PASS gate {stage}")
    return 0


SELFTEST_PASSING = "def test_ok():\n    assert 1 + 1 == 2\n"
SELFTEST_IMPL_PASS = "import pkg_w9\n\n\ndef test_value():\n    assert pkg_w9.VALUE == 9\n"
SELFTEST_IMPL_FAIL = "import pkg_w9\n\n\ndef test_corrected():\n    assert pkg_w9.VALUE == 10\n"
# The WP's test dir at the tests-only commit, per layout. "flat" (no
# __init__.py): absolute helper import, a fixture data file, and a helper
# loaded only dynamically. "pkg": relative imports through helpers.py.
SELFTEST_LAYOUTS: dict[str, dict[str, str]] = {
    "flat": {
        "tests/accept/w9/w9_helper.py": "EXPECTED = 9\n",
        "tests/accept/w9/test_w9_value.py":
            "import w9_helper\nimport pkg_w9\n\n\ndef test_value():\n"
            "    assert pkg_w9.VALUE == w9_helper.EXPECTED\n",
        "tests/accept/w9/fixtures/expected.txt": "9\n",
        "tests/accept/w9/test_w9_data.py":
            "from pathlib import Path\n\nimport pkg_w9\n\n\ndef test_data():\n"
            "    want = int((Path(__file__).parent / \"fixtures\" / \"expected.txt\").read_text())\n"
            "    assert pkg_w9.VALUE == want\n",
        "tests/accept/w9/w9_dyn.py": "FLAG = True\n",
        "tests/accept/w9/test_w9_dyn.py":
            "import importlib\n\n\ndef test_dyn():\n"
            "    assert importlib.import_module(\"w9_\" + \"dyn\").FLAG\n",
    },
    "pkg": {
        "tests/accept/w9/__init__.py": "",
        "tests/accept/w9/_base.py": "EXPECTED = 9\n",
        "tests/accept/w9/helpers.py": "from ._base import EXPECTED\n\n__all__ = [\"EXPECTED\"]\n",
        "tests/accept/w9/test_w9_value.py":
            "import pkg_w9\n\nfrom .helpers import EXPECTED\n\n\ndef test_value():\n"
            "    assert pkg_w9.VALUE == EXPECTED\n",
        "tests/accept/w9/test_w9_other.py": SELFTEST_PASSING,
    },
}


def selftest_tests_correction(ident: tuple[str, ...]) -> list[str]:
    """The MODE rules for tests-only PRs, on real git repos and real pytest
    (sys.executable -m pytest; LANED_PYTEST_CMD is overridden for the run)."""
    failures: list[str] = []
    saved = os.environ.get("LANED_PYTEST_CMD")
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-tc-") as tmp:
            n = 0

            def repo(built: bool, layout: str):
                nonlocal n
                n += 1
                root = Path(tmp) / f"repo{n}"
                root.mkdir()

                def put_commit(files: dict[str, str], msg: str) -> str:
                    for rel, text in files.items():
                        (root / rel).parent.mkdir(parents=True, exist_ok=True)
                        (root / rel).write_text(text)
                    lanedlib.git(root, "add", "-A")
                    lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
                    return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

                lanedlib.git(root, "init", "-q")
                put_commit({"README.md": "x\n", "pkg_w9.py": "VALUE = 1\n"}, "seed")
                base = put_commit({"tests/accept/w9/PATHS": "pkg_w9.py\n", **SELFTEST_LAYOUTS[layout]},
                                  "tests-only")
                if built:
                    base = put_commit({"pkg_w9.py": "VALUE = 9\n"}, "implementation")
                return root, base, put_commit

            def case(name: str, built: bool, files: dict[str, str], want_mode: str, want_ok: bool,
                     layout: str = "flat") -> None:
                root, base, put_commit = repo(built, layout)
                head = put_commit(files, name)
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_check_pr(root, "W9", base, head)
                out = buf.getvalue()
                if rc != 0 or f"MODE {want_mode}\n" not in out:
                    failures.append(f"{name}: check-pr rc={rc}, want MODE {want_mode}: {out.strip()}")
                    return
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    if want_mode == "tests-only":
                        # the workflow's tests-only run; here it must stay expect-fail
                        rc = cmd_verification(root, "W9", base, head)
                    else:
                        rc = cmd_tests_correction(root, "W9", base, head)
                out = buf.getvalue()
                ok = rc == 0 and (("LEDGER-MODE expect-fail\n" in out and "MODE verification\n" not in out)
                                  if want_mode == "tests-only" else "MODE tests-correction PASS" in out)
                if ok != want_ok:
                    failures.append(f"{name}: {want_mode} {'passed' if ok else 'failed'}, "
                                    f"want {'pass' if want_ok else 'fail'}: {out.strip()[-2000:]}")

            # new WP, tests-only PR -> classic expect-fail (unchanged)
            case("new-wp-tests-only", False, {"tests/accept/w9/test_w9_more.py": SELFTEST_IMPL_FAIL},
                 "tests-only", True)
            # built WP + new passing tests -> pass
            case("built-new-passing", True, {"tests/accept/w9/test_w9_more.py": SELFTEST_PASSING},
                 "tests-correction", True)
            # built WP + new tests failing for a right reason -> pass (pending impl fix)
            case("built-new-failing-right", True, {"tests/accept/w9/test_w9_more.py": SELFTEST_IMPL_FAIL},
                 "tests-correction", True)
            # built WP + a corrected (edited) existing test failing for a right reason -> pass
            case("built-edited-failing-right", True,
                 {"tests/accept/w9/test_w9_value.py": SELFTEST_IMPL_FAIL}, "tests-correction", True)
            # built WP + a changed helper widens the fixture of an unedited test
            # that imports it (the R5 helpers.py shape): that test counts as
            # changed, fails for a right reason -> pass (pending the impl fix)
            case("built-helper-widens-unedited-test", True,
                 {"tests/accept/w9/w9_helper.py": "EXPECTED = 10\n",
                  "tests/accept/w9/test_w9_more.py": SELFTEST_IMPL_PASS}, "tests-correction", True)
            # the same through a package: `from .helpers import` -> helpers.py
            # -> `from ._base import` (transitive) -> pass
            case("built-pkg-transitive-helper", True, {"tests/accept/w9/_base.py": "EXPECTED = 10\n"},
                 "tests-correction", True, layout="pkg")
            # ... and a fixture data file an unedited test reads -> pass
            case("built-fixture-file-widens-unedited-test", True,
                 {"tests/accept/w9/fixtures/expected.txt": "10\n"}, "tests-correction", True)
            # built WP + a helper change reaching an unedited test only through a
            # dynamic import (outside the static closure): that test stays
            # "unchanged", it now fails -> FAIL
            case("built-unchanged-test-now-failing", True, {"tests/accept/w9/w9_dyn.py": "FLAG = False\n"},
                 "tests-correction", False)
            # a pkg helper change with a wrong-reason failure in the dependent test -> FAIL
            case("built-pkg-helper-wrong-reason", True,
                 {"tests/accept/w9/_base.py": "import laned_no_such_dep\nEXPECTED = 9\n"},
                 "tests-correction", False, layout="pkg")
            # built WP + a changed test failing for a wrong reason -> FAIL
            case("built-new-failing-wrong", True,
                 {"tests/accept/w9/test_w9_more.py": "import laned_no_such_dep\n\n\ndef test_x():\n"
                                                     "    assert laned_no_such_dep\n"},
                 "tests-correction", False)
    finally:
        if saved is None:
            os.environ.pop("LANED_PYTEST_CMD", None)
        else:
            os.environ["LANED_PYTEST_CMD"] = saved
    return failures


SELFTEST_VERIFY_PASS = "import pkg_w9\n\n\ndef test_built_value():\n    assert pkg_w9.VALUE == 9\n"


def selftest_verification(ident: tuple[str, ...]) -> list[str]:
    """MODE verification of the tests-only run: a repo where another WP already
    built ``pkg_w9.py`` (VALUE = 9) and a PR adds tests/accept/w9/ only."""
    failures: list[str] = []
    saved = os.environ.get("LANED_PYTEST_CMD")
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-vf-") as tmp:
            n = 0

            def case(name: str, base_files: dict[str, str], pr_files: dict[str, str],
                     want_rc: int, want_verification: bool, listed: bool = True) -> None:
                nonlocal n
                n += 1
                root = Path(tmp) / f"repo{n}"
                root.mkdir()

                def put_commit(files: dict[str, str], msg: str) -> str:
                    for rel, text in files.items():
                        (root / rel).parent.mkdir(parents=True, exist_ok=True)
                        (root / rel).write_text(text)
                    lanedlib.git(root, "add", "-A")
                    lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
                    return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

                lanedlib.git(root, "init", "-q")
                # W9 is a declared verification WP on BASE unless ``listed`` is False
                decl = {lanedlib.VERIFICATION_WPS_PATH: "# verification WPs\nW9  # checks pkg_w9\n"} if listed \
                    else {lanedlib.VERIFICATION_WPS_PATH: "# verification WPs\nW8\n"}
                base = put_commit({".gitignore": "__pycache__/\n", "pkg_w9.py": "VALUE = 9\n", **decl,
                                   **base_files}, "built by another WP")
                head = put_commit(pr_files, name)
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_check_pr(root, "W9", base, head)
                out = buf.getvalue()
                if rc != 0 or "MODE tests-only\n" not in out:
                    failures.append(f"verification {name}: check-pr rc={rc}, want MODE tests-only: {out.strip()}")
                    return
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_verification(root, "W9", base, head)
                out = buf.getvalue()
                got_v = "MODE verification\n" in out and "LEDGER-MODE verification\n" in out
                if rc != want_rc or got_v != want_verification:
                    failures.append(f"verification {name}: rc={rc} verification={got_v}, want rc={want_rc} "
                                    f"verification={want_verification}: {out.strip()[-2000:]}")
                    return
                if not want_verification and rc == 0 and "LEDGER-MODE expect-fail\n" not in out:
                    failures.append(f"verification {name}: fallback not recorded as expect-fail: {out.strip()}")
                if not listed and ("not a declared verification WP" not in out
                                   or (rc != 0 and "FAIL expect-fail" not in out)):
                    failures.append(f"verification {name}: an unlisted WP did not run expect-fail: {out.strip()}")
                if want_verification:
                    tree = lanedlib.wp_tree_at(root, head, "W9")
                    if f"TESTS-TREE {tree}\n" not in out:
                        failures.append(f"verification {name}: TESTS-TREE {tree} not printed: {out.strip()}")

            paths = {"tests/accept/w9/PATHS": "pkg_w9.py\n"}
            # every PATHS file exists on BASE and every test passes -> MODE verification
            case("verify-pass", {}, {**paths, "tests/accept/w9/test_w9.py": SELFTEST_VERIFY_PASS}, 0, True)
            # one test fails for a right reason -> expect-fail semantics (passes, not verification)
            case("verify-one-failing", {},
                 {**paths, "tests/accept/w9/test_w9.py": SELFTEST_VERIFY_PASS,
                  "tests/accept/w9/test_w9_more.py": SELFTEST_IMPL_FAIL}, 0, False)
            # a failure for a wrong reason in the fallback -> FAIL
            case("verify-wrong-reason", {},
                 {**paths, "tests/accept/w9/test_w9.py": "import laned_no_such_dep\n\n\ndef test_x():\n"
                                                         "    assert laned_no_such_dep\n"}, 1, False)
            # a PATHS file missing on BASE -> never verification, even with all
            # tests passing (expect-fail then fails: nothing fails for a right reason)
            case("verify-missing-paths-file", {},
                 {"tests/accept/w9/PATHS": "pkg_w9.py\npkg_w9_new.py\n",
                  "tests/accept/w9/test_w9.py": SELFTEST_VERIFY_PASS}, 1, False)
            # a missing dir/ or glob entry counts as missing too
            case("verify-missing-dir-entry", {},
                 {"tests/accept/w9/PATHS": "pkg_w9.py\npkg_w9_data/\npkg_w9_*.json\n",
                  "tests/accept/w9/test_w9.py": SELFTEST_VERIFY_PASS}, 1, False)
            # present dir/ and glob entries -> verification
            case("verify-dir-and-glob-present", {"pkg_w9_data/t.json": "{}\n", "pkg_w9_a.json": "{}\n"},
                 {"tests/accept/w9/PATHS": "pkg_w9.py\npkg_w9_data/\npkg_w9_*.json\n",
                  "tests/accept/w9/test_w9.py": SELFTEST_VERIFY_PASS}, 0, True)
            # RV5: W9 not listed in scripts/laned/verification_wps on BASE (another
            # WP is), every test passes on BASE -> never verification: expect-fail
            # semantics, which FAIL (no test fails for a right reason)
            case("verify-unlisted-wp", {}, {**paths, "tests/accept/w9/test_w9.py": SELFTEST_VERIFY_PASS},
                 1, False, listed=False)
            # (a tests-only PR cannot list itself: rule 1 refuses tests/accept/
            # with scripts/laned/, and the list is read at BASE anyway)
            # tests pass but stub_scan over PATHS fails -> not verification, FAIL
            case("verify-stub-scan", {"pkg_w9.py": "VALUE = 9  # " + "TO" + "DO\n"},
                 {**paths, "tests/accept/w9/test_w9.py": SELFTEST_VERIFY_PASS}, 1, False)
            # the classic tests-only flow for a new module (unchanged): right-reason
            # ModuleNotFoundError -> expect-fail passes
            case("classic-new-module", {},
                 {"tests/accept/w9/PATHS": "pkg_w9_new.py\n",
                  "tests/accept/w9/test_w9.py": "import pkg_w9_new\n\n\ndef test_new():\n"
                                                "    assert pkg_w9_new.VALUE == 1\n"}, 0, False)
    finally:
        if saved is None:
            os.environ.pop("LANED_PYTEST_CMD", None)
        else:
            os.environ["LANED_PYTEST_CMD"] = saved
    return failures


SELFTEST_PLAN = """# plan

| WP | What | Depends | Runs in | Accept |
|---|---|---|---|---|
| X1 | External probe | — | owner | `scripts/laned/accept X1 --evidence evidence/x1.json` (probe ok) |
| X2 | Harness | — | ci (fixtures) + testnet | `scripts/laned/accept X2` and, for T9, `--evidence evidence/t9.json` |
"""
# X1's own evidence verifier (LANED_EVIDENCE): a request id beyond {wp, passed}.
SELFTEST_X1_TEST = (
    "import json\nimport os\n\n\ndef test_x1_evidence():\n"
    "    path = os.environ.get(\"LANED_EVIDENCE\")\n"
    "    if path:\n"
    "        assert json.load(open(path)).get(\"request_id\")\n"
)


def selftest_evidence(ident: tuple[str, ...]) -> list[str]:
    """MODE evidence of --check-pr, then `accept <WP> --evidence <file>`, on a
    real git repo with a plan whose Accept cells declare the evidence files."""
    failures: list[str] = []
    saved = os.environ.get("LANED_PYTEST_CMD")
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    good = '{"wp": "X1", "passed": true, "request_id": "req-1"}\n'
    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-ev-") as tmp:
            root = Path(tmp) / "repo"
            root.mkdir()

            def put(rel: str, text: str) -> None:
                (root / rel).parent.mkdir(parents=True, exist_ok=True)
                (root / rel).write_text(text)

            def commit(msg: str) -> str:
                lanedlib.git(root, "add", "-A")
                lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
                return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

            lanedlib.git(root, "init", "-q")
            for rel, text in {"README.md": "x\n", ".gitignore": "__pycache__/\n", lanedlib.PLAN_PATH: SELFTEST_PLAN,
                              "pkg_x1.py": "VALUE = 1\n", "tests/accept/x1/PATHS": "pkg_x1.py\n",
                              "tests/accept/x1/test_x1.py": SELFTEST_X1_TEST,
                              "tests/accept/x2/PATHS": "pkg_x2.py\n",
                              "tests/accept/x2/test_x2.py": SELFTEST_PASSING,
                              "evidence/t9.json": '{"wp": "X2", "passed": false}\n'}.items():
                put(rel, text)
            base = commit("base")

            def case(name: str, files: dict[str, str | None], wp: str, want_ok: bool,
                     accept_ok: bool | None = None) -> None:
                lanedlib.git(root, "checkout", "-q", "-B", name, base)
                for rel, text in files.items():
                    if text is None:
                        (root / rel).unlink()
                    else:
                        put(rel, text)
                head = commit(name)
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_check_pr(root, wp, base, head)
                out = buf.getvalue()
                ok = rc == 0 and "MODE evidence\n" in out
                if ok != want_ok:
                    failures.append(f"evidence {name}: {wp} check-pr {'passed' if ok else 'failed'}: {out.strip()}")
                    return
                if not ok:
                    if "FAIL evidence" not in out:
                        failures.append(f"evidence {name}: refusal is not FAIL evidence: {out.strip()}")
                    return
                files_out = [ln.split(" ", 1)[1] for ln in out.splitlines() if ln.startswith("EVIDENCE ")]
                want_files = sorted(p for p, t in files.items() if t is not None)
                if sorted(files_out) != want_files:
                    failures.append(f"evidence {name}: EVIDENCE lines {files_out}, want {want_files}")
                if accept_ok is None:
                    return
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rcs = [cmd_accept(root, wp, f) for f in files_out]
                a_ok = all(r == 0 for r in rcs)
                if a_ok != accept_ok:
                    failures.append(f"evidence {name}: accept --evidence {'passed' if a_ok else 'failed'}, "
                                    f"want {'pass' if accept_ok else 'fail'}: {buf.getvalue().strip()[-2000:]}")

            # the declared file, added: MODE evidence, accept --evidence passes
            case("add", {"evidence/x1.json": good}, "X1", True, accept_ok=True)
            # declared, but the WP's own verifier rejects the content -> accept fails
            case("add-bare", {"evidence/x1.json": '{"wp": "X1", "passed": true}\n'}, "X1", True,
                 accept_ok=False)
            # a declared file of a WP whose Accept cell has more text around it
            case("modify-second-form", {"evidence/t9.json": '{"wp": "X2", "passed": true}\n'}, "X2", True,
                 accept_ok=True)
            # evidence + anything else -> FAIL evidence
            case("plus-other", {"evidence/x1.json": good, "README.md": "y\n"}, "X1", False)
            case("plus-tests", {"evidence/x1.json": good, "tests/accept/x1/test_more.py": "x = 1\n"},
                 "X1", False)
            case("plus-impl", {"evidence/x1.json": good, "pkg_x1.py": "VALUE = 2\n"}, "X1", False)
            # an evidence file the WP's Accept cell does not name -> FAIL evidence
            case("undeclared", {"evidence/x1_extra.json": good}, "X1", False)
            case("other-wps-file", {"evidence/x1.json": good}, "X2", False)
            # deleting a declared file is not an evidence PR
            case("delete", {"evidence/t9.json": None}, "X2", False)
    finally:
        if saved is None:
            os.environ.pop("LANED_PYTEST_CMD", None)
        else:
            os.environ["LANED_PYTEST_CMD"] = saved
    return failures


def selftest_w3a_nolock_evidence() -> list[str]:
    """check_json_evidence: a no-lock W3a run is judged by its verified path
    verdict; a lock-enabled W3a run and every other WP still need passed: true."""
    failures: list[str] = []
    nolock = {"lock_enabled": False, "asserted_by": "owner_flag"}
    locked = {"lock_enabled": True, "asserted_by": "probe"}

    def ev(wp: str, passed: bool, lock: dict | None, verified: bool | None, path_passed: bool | None) -> str:
        data: dict = {"wp": wp, "passed": passed}
        if lock is not None:
            data["bucket_lock"] = lock
        if verified is not None:
            live: dict = {"verified": verified}
            if path_passed is not None:
                live["path_verdict"] = {"path": "presigned_multipart", "passed": path_passed}
            data["verified_live"] = live
        return json.dumps(data)

    cases = [
        ("w3a-nolock-path-passed", ev("W3a", False, nolock, True, True), "W3a", True),
        ("w3a-nolock-path-failed", ev("W3a", False, nolock, True, False), "W3a", False),
        ("w3a-nolock-path-missing", ev("W3a", False, nolock, True, None), "W3a", False),
        ("w3a-nolock-not-verified", ev("W3a", False, nolock, False, True), "W3a", False),
        ("w3a-nolock-no-live", ev("W3a", False, nolock, None, None), "W3a", False),
        ("w3a-locked-passed-false", ev("W3a", False, locked, True, True), "W3a", False),
        ("w3a-locked-passed-true", ev("W3a", True, locked, True, True), "W3a", True),
        ("w3a-no-lock-key", ev("W3a", False, None, True, True), "W3a", False),
        ("other-wp-nolock-shape", ev("W3b", False, nolock, True, True), "W3b", False),
        ("other-wp-passed-false", ev("X1", False, None, None, None), "X1", False),
        ("other-wp-passed-true", ev("X1", True, None, None, None), "X1", True),
    ]
    for name, text, wp, want in cases:
        ok, why = lanedlib.check_json_evidence(text, wp)
        if ok != want:
            failures.append(f"w3a-evidence {name}: {'accepted' if ok else 'refused'} ({why}), "
                            f"want {'accept' if want else 'refuse'}")
    return failures


def selftest_wb19_partial_evidence() -> list[str]:
    """check_json_evidence (rev6.16): WB19 evidence with passed: false is
    accepted only when coverage is its sole failing check, the coverage detail
    names the missing SKUs (none of them measured) and body_sha256 matches."""
    import copy
    import hashlib

    failures: list[str] = []

    def seal(d: dict) -> dict:
        d = {k: v for k, v in d.items() if k != "body_sha256"}
        d["body_sha256"] = hashlib.sha256(json.dumps(
            d, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()).hexdigest()
        return d

    base = seal({
        "schema": "laned_wb19/1", "wp": "WB19", "passed": False,
        "checks": [{"name": "coverage", "passed": False,
                    "detail": "missing expert runs: ['8xH100', '4xH200']"},
                   {"name": "full_leg", "passed": True, "detail": "skipped"},
                   {"name": "memory", "passed": True, "detail": "fits"}],
        "runs": [], "table": {"rows": {"8xH200": {"steps_per_s": 0.05},
                                       "8xRTX4090": {"steps_per_s": 0.13}}},
        "lane_a_full_leg": None, "oa8_sha256": None})

    def variant(edit, *, reseal: bool = True) -> str:
        d = copy.deepcopy(base)
        edit(d)
        return json.dumps(seal(d) if reseal else d)

    def check(i: int, **kw):
        def f(d):
            d["checks"][i].update(kw)
        return f

    cases = [
        ("partial-coverage-only", json.dumps(base), "WB19", True),
        ("partial-memory-also-fails", variant(check(2, passed=False)), "WB19", False),
        ("partial-full-leg-fails", variant(check(1, passed=False)), "WB19", False),
        ("partial-only-memory-fails", variant(lambda d: (d["checks"][0].update(
            passed=True), d["checks"][2].update(passed=False))), "WB19", False),
        ("partial-no-missing-named", variant(check(0, detail="missing expert runs: []")),
         "WB19", False),
        ("partial-detail-unparseable", variant(check(0, detail="some are missing")),
         "WB19", False),
        ("partial-names-a-measured-sku", variant(check(
            0, detail="missing expert runs: ['8xH200', '8xH100']")), "WB19", False),
        ("partial-no-rows", variant(lambda d: d["table"].update(rows={})), "WB19", False),
        ("partial-checks-malformed", variant(lambda d: d.update(checks="coverage")),
         "WB19", False),
        ("partial-hand-edited", variant(lambda d: d["table"]["rows"]["8xH200"].update(
            steps_per_s=9.9), reseal=False), "WB19", False),
        ("partial-no-sha", variant(lambda d: d.pop("body_sha256"), reseal=False),
         "WB19", False),
        ("wb19-passed-true", json.dumps({"wp": "WB19", "passed": True}), "WB19", True),
        ("other-wp-partial-shape", json.dumps({**base, "wp": "WB22"}), "WB22", False),
    ]
    for name, text, wp, want in cases:
        ok, why = lanedlib.check_json_evidence(text, wp)
        if ok != want:
            failures.append(f"wb19-evidence {name}: {'accepted' if ok else 'refused'} ({why}), "
                            f"want {'accept' if want else 'refuse'}")
    return failures


SELFTEST_CROSS_PLAN = """# plan

| WP | What | Depends | Runs in | Accept |
|---|---|---|---|---|
| A | core | — | ci | `scripts/laned/accept A` |
| B | uses A | A | ci | `scripts/laned/accept B` |
| C | unrelated | — | ci | `scripts/laned/accept C` |
| D | shares a file with A | — | ci | `scripts/laned/accept D` |
| E | unbuilt, imports A | — | ci | `scripts/laned/accept E` |
| F | red on base, uses A | A | ci | `scripts/laned/accept F` |
| G | uncollectable on base, imports C | C | ci | `scripts/laned/accept G` |
| V | verification of B (listed) | B | ci | `scripts/laned/accept V` |
| U | verification-shaped, not listed | B | ci | `scripts/laned/accept U` |
"""


def selftest_cross(ident: tuple[str, ...]) -> list[str]:
    """The CROSS rule on a real git repo and real pytest: A, B, C, D, F, G
    built, E tests-only; B's tests import pkg_b, which imports A's pkg_a; D's
    PATHS also cover A's shared_ad.py; C and E must never run for an A PR.
    F is red on BASE (KNOWN unless the PR adds a failure); G cannot be
    collected on BASE (always FAIL when selected)."""
    failures: list[str] = []
    saved = os.environ.get("LANED_PYTEST_CMD")
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-cross-") as tmp:
            root = Path(tmp) / "repo"
            root.mkdir()

            def commit(files: dict[str, str], msg: str) -> str:
                for rel, text in files.items():
                    (root / rel).parent.mkdir(parents=True, exist_ok=True)
                    (root / rel).write_text(text)
                lanedlib.git(root, "add", "-A")
                lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
                return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

            lanedlib.git(root, "init", "-q")
            commit({"README.md": "x\n", ".gitignore": "__pycache__/\n", lanedlib.PLAN_PATH: SELFTEST_CROSS_PLAN,
                    "pkg_a.py": "VALUE = 0\n", "pkg_b.py": "DOUBLE = 0\n", "pkg_c.py": "C = 0\n",
                    "pkg_d.py": "D = 0\n", "shared_ad.py": "S = 0\n"}, "seed")
            for wp, paths, test in (
                    ("a", "pkg_a.py\nshared_ad.py\n", "import pkg_a\n\n\ndef test_a():\n    assert pkg_a.VALUE > 0\n"),
                    ("b", "pkg_b.py\n", "import pkg_b\n\n\ndef test_b():\n    assert pkg_b.DOUBLE == 2\n"),
                    ("c", "pkg_c.py\n", "import pkg_c\n\n\ndef test_c():\n    assert pkg_c.C == 3\n"),
                    ("d", "pkg_d.py\nshared_ad.py\n", "import pkg_d\n\n\ndef test_d():\n    assert pkg_d.D == 4\n"),
                    ("e", "pkg_e.py\n", "import pkg_a\nimport pkg_e\n\n\ndef test_e():\n    assert pkg_e.E\n"),
                    # F is red on BASE (test_f_red); test_f_ok reads A's VALUE through pkg_f
                    ("f", "pkg_f.py\n", "import pkg_f\n\n\ndef test_f_red():\n    assert pkg_f.F == 99\n\n\n"
                                        "def test_f_ok():\n    assert pkg_f.G == 1\n"),
                    # G cannot even be collected on BASE; it imports C's pkg_c
                    ("g", "pkg_g.py\n", "import pkg_c\nfrom pkg_g import MISSING\n\n\ndef test_g():\n"
                                        "    assert MISSING and pkg_c\n")):
                commit({f"tests/accept/{wp}/PATHS": paths, f"tests/accept/{wp}/test_{wp}.py": test},
                       f"tests-only {wp}")
            commit({"pkg_a.py": "VALUE = 1\n"}, "impl A")
            commit({"pkg_b.py": "import pkg_a\n\nDOUBLE = pkg_a.VALUE * 2\n"}, "impl B")
            commit({"pkg_c.py": "C = 3\n"}, "impl C")
            commit({"pkg_f.py": "import pkg_a\n\nF = 6\nG = pkg_a.VALUE\n"}, "impl F")
            commit({"pkg_g.py": "X = 1\n"}, "impl G")
            commit({"pkg_d.py": "D = 4\n"}, "impl D")
            # RV5: V is a declared verification WP over B's built pkg_b (tests-only
            # merge, no implementation commit); U has the same shape but is not
            # declared, so it is not built (L1 at most) and never a cross WP.
            vtest = "import pkg_b\n\n\ndef test_{w}():\n    assert pkg_b.DOUBLE == 2\n"
            commit({lanedlib.VERIFICATION_WPS_PATH: "# verification WPs\nV  # checks B\n"}, "declare V")
            commit({"tests/accept/v/PATHS": "pkg_b.py\n", "tests/accept/v/test_v.py": vtest.format(w="v")},
                   "verification V")
            base = commit({"tests/accept/u/PATHS": "pkg_b.py\n", "tests/accept/u/test_u.py": vtest.format(w="u")},
                          "tests-only U")

            def case(name: str, wps: str, files: dict[str, str], want_rc: int,
                     want: list[str], never: list[str]) -> None:
                lanedlib.git(root, "checkout", "-q", "-B", name, base)
                head = commit(files, name)
                with contextlib.redirect_stdout(io.StringIO()) as buf, \
                        contextlib.redirect_stderr(io.StringIO()):
                    rc = cmd_cross(root, wps.split(","), base, head)
                out = buf.getvalue()
                lines = [ln for ln in out.splitlines() if ln.startswith("CROSS ")]
                bad = [w for w in want if not any(ln.startswith(w) for ln in lines)]
                bad += [n for n in never if any(ln.startswith(f"CROSS {n} ") for ln in lines)]
                if rc != want_rc or bad:
                    failures.append(f"cross {name}: rc={rc} want {want_rc}; missing/unexpected {bad}: "
                                    f"{out.strip()[-2000:]}")

            # implementation PR for A breaks B (imports pkg_a through pkg_b) -> CROSS B FAIL;
            # D runs only for the PATHS overlap and passes; C (unrelated) and E (unbuilt) never run
            # ... and F, red on BASE by test_f_red, gains a failure (test_f_ok) -> CROSS F FAIL
            # ... and V, a verification WP whose tests import pkg_b (-> pkg_a), is
            # re-run and the break gives CROSS V FAIL (RV5); U is not declared -> never
            case("a-breaks-b", "A", {"pkg_a.py": "VALUE = 5\n", "shared_ad.py": "S = 1\n"}, 1,
                 ["CROSS B FAIL", "CROSS D PASS", "CROSS F FAIL (pytest: 1 regression", "CROSS V FAIL"],
                 ["A", "C", "E", "G", "U"])
            # the same PR without the break -> CROSS B PASS; F still red the same
            # way as on BASE -> CROSS F KNOWN, which does not fail the job
            case("a-keeps-b", "A", {"pkg_a.py": "VALUE = 1\nEXTRA = 2\n"}, 0,
                 ["CROSS B PASS", "CROSS F KNOWN (1 tests already red on base: ", "CROSS V PASS"],
                 ["A", "C", "D", "E", "G", "U"])
            # tests-correction PR for B: B is the main step, never a cross WP
            case("b-tests-correction", "B",
                 {"tests/accept/b/test_b_more.py": "import pkg_b\n\n\ndef test_more():\n"
                                                   "    assert pkg_b.DOUBLE\n"},
                 0, ["CROSS none"], ["A", "B", "C", "D", "E", "F", "G", "U", "V"])
            # a global input re-accepts every built WP except the PR's own (C, G)
            case("lockfile", "C,G", {"uv.lock": "x\n", "pkg_c.py": "C = 3\n# lock\n"}, 0,
                 ["CROSS A PASS", "CROSS B PASS", "CROSS D PASS", "CROSS F KNOWN", "CROSS V PASS"],
                 ["C", "E", "G", "U"])
            # G fails on HEAD and cannot be collected on BASE either -> FAIL (fails closed)
            case("c-touches-g", "C", {"pkg_c.py": "C = 3\n# touch\n"}, 1,
                 ["CROSS G FAIL"], ["A", "B", "C", "D", "E", "F", "U", "V"])
    finally:
        if saved is None:
            os.environ.pop("LANED_PYTEST_CMD", None)
        else:
            os.environ["LANED_PYTEST_CMD"] = saved
    return failures


def selftest_freshness(ident: tuple[str, ...]) -> list[str]:
    """The FRESHNESS rule on a real git repo (no pytest): PRs green on BASE0
    while main moves on. The #593 shape: PR1 (pkg_lib.py) merges, then PR2,
    W3's implementation (pkg_w3.py) green on the older base, must be refused
    because W3's tests import pkg_lib; after update-branch it is fresh."""
    failures: list[str] = []
    with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-fresh-") as tmp:
        root = Path(tmp) / "repo"
        root.mkdir()

        def commit(files: dict[str, str], msg: str) -> str:
            for rel, text in files.items():
                (root / rel).parent.mkdir(parents=True, exist_ok=True)
                (root / rel).write_text(text)
            lanedlib.git(root, "add", "-A")
            lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
            return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

        lanedlib.git(root, "init", "-q")
        base0 = commit({"README.md": "x\n", "pkg_a.py": "A = 1\n", "pkg_b.py": "import pkg_a\n\nB = pkg_a.A\n",
                        "pkg_c.py": "C = 1\n", "pkg_lib.py": "LIB = 1\n", "pkg_w3.py": "W3 = 0\n",
                        "tests/accept/w3/PATHS": "pkg_w3.py\n",
                        "tests/accept/w3/test_w3.py": "import pkg_lib\nimport pkg_w3\n\n\ndef test_w3():\n"
                                                      "    assert pkg_w3.W3 == pkg_lib.LIB\n"}, "seed")

        def branch(name: str, start: str, files: dict[str, str]) -> str:
            lanedlib.git(root, "checkout", "-q", "-B", name, start)
            return commit(files, name)

        def case(name: str, base: str, head: str, main: str, want_stale: bool, want: str = "") -> None:
            with contextlib.redirect_stdout(io.StringIO()) as buf:
                rc = cmd_freshness(root, base, head, main)
            out = buf.getvalue()
            stale = "STALE BASE: update-branch and re-run\n" in out
            if (rc != 0) != want_stale or stale != want_stale or (want and want not in out):
                failures.append(f"freshness {name}: rc={rc} stale={stale}, want stale={want_stale}"
                                f"{' with ' + repr(want) if want else ''}: {out.strip()[-1500:]}")
            # --warn-only (the pull_request job since the merge queue): the
            # same analysis, but a stale base is a WARNING and never fails
            with contextlib.redirect_stdout(io.StringIO()) as buf:
                rc_w = cmd_freshness(root, base, head, main, warn_only=True)
            out_w = buf.getvalue()
            warned = STALE_WARN in out_w
            if rc_w != 0 or warned != want_stale or STALE_LINE in out_w or (want and want not in out_w):
                failures.append(f"freshness --warn-only {name}: rc={rc_w} warned={warned}, "
                                f"want warned={want_stale} and rc 0: {out_w.strip()[-1500:]}")

        pr_a = branch("pr-a", base0, {"pkg_a.py": "A = 1\nEXTRA = 2\n"})
        # main has not moved -> fresh
        case("main-unmoved", base0, pr_a, base0, False, "FRESH base")
        # main moved with an unrelated change -> fresh enough
        main_c = branch("main-c", base0, {"pkg_c.py": "C = 2\n"})
        case("main-unrelated", base0, pr_a, main_c, False, "FRESH enough")
        # main touched the same file -> stale
        main_a = branch("main-a", base0, {"pkg_a.py": "A = 3\n"})
        case("same-file", base0, pr_a, main_a, True, "both touch pkg_a.py")
        # the PR's module imports what main changed -> stale
        pr_b = branch("pr-b", base0, {"pkg_b.py": "import pkg_a\n\nB = pkg_a.A + 1\n"})
        case("pr-imports-main-change", base0, pr_b, main_a, True, "the PR's modules import pkg_a.py")
        # main's changed module imports what the PR changed -> stale
        main_b = branch("main-b", base0, {"pkg_b.py": "import pkg_a\n\nB = pkg_a.A * 2\n"})
        case("main-imports-pr-change", base0, pr_a, main_b, True, "main's changed modules import pkg_a.py")
        # #593: PR1 changes pkg_lib.py and merges; PR2 (W3's implementation) was
        # green on BASE0, and W3's tests import pkg_lib -> refused
        branch("pr1", base0, {"pkg_lib.py": "LIB = 2\n"})
        lanedlib.git(root, "checkout", "-q", "-B", "main", base0)
        lanedlib.git(root, "merge", "-q", "--squash", "pr1")
        main1 = commit({}, "pr1 (#1)")
        pr2 = branch("pr2", base0, {"pkg_w3.py": "W3 = 1\n"})
        case("second-pr-older-base", base0, pr2, main1, True, "tests/accept/w3/ depends on the PR")
        # after update-branch the run tests the PR merged into main's tip -> fresh
        lanedlib.git(root, "checkout", "-q", "-B", "pr2-updated", pr2)
        lanedlib.git(root, *ident, "merge", "-q", "--no-edit", "main")
        updated = lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()
        case("second-pr-updated", main1, updated, main1, False, "FRESH base")
    return failures


def selftest_merge_group(ident: tuple[str, ...]) -> list[str]:
    """The MERGE-GROUP rule on a real git repo (sys.executable -m pytest):
    a queued W3 implementation green on an older base must FAIL on the
    combined ref when a PR queued ahead of it (or merged since its base)
    broke it; it passes alone; a PR missing from the labels file, a commit
    naming no PR and a check-pr refusal fail closed; a tests-only PR runs
    --verification (here --expect-fail) on the combined ref."""
    failures: list[str] = []
    saved = {k: os.environ.get(k) for k in ("LANED_PYTEST_CMD", "LANED_LEDGER", "LANED_PR_LABELS")}
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    os.environ.pop("LANED_PR_LABELS", None)
    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-group-") as tmp:
            root = Path(tmp) / "repo"
            root.mkdir()
            os.environ["LANED_LEDGER"] = str(Path(tmp) / "no-ledger.json")

            def commit(files: dict[str, str], msg: str) -> str:
                for rel, text in files.items():
                    (root / rel).parent.mkdir(parents=True, exist_ok=True)
                    (root / rel).write_text(text)
                lanedlib.git(root, "add", "-A")
                lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
                return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

            lanedlib.git(root, "init", "-q")
            base0 = commit({"README.md": "x\n", ".gitignore": "__pycache__/\n", "pkg_lib.py": "LIB = 1\n",
                            "pkg_w3.py": "W3 = 0\n",
                            "pkg_w4.py": "W4 = 0\n",
                            "tests/accept/w3/PATHS": "pkg_w3.py\n",
                            "tests/accept/w3/test_w3.py": "import pkg_lib\nimport pkg_w3\n\n\n"
                                                          "def test_w3():\n    assert pkg_w3.W3 == pkg_lib.LIB\n",
                            "tests/accept/w4/PATHS": "pkg_w4.py\n"}, "seed")

            def queue(start: str, prs: list[tuple[dict[str, str], str]]) -> str:
                lanedlib.git(root, "checkout", "-q", "--detach", start)
                head = start
                for files, msg in prs:
                    head = commit(files, msg)
                return head

            def case(name: str, head: str, labels: dict[int, list[str]], want_ok: bool,
                     want: tuple[str, ...] = ()) -> None:
                lanedlib.git(root, "checkout", "-q", "--detach", head)
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_merge_group(root, base0, head, labels)
                out = buf.getvalue()
                missing = [w for w in want if w not in out]
                if (rc == 0) != want_ok or ("GROUP PASS" in out) != want_ok or missing:
                    failures.append(f"merge-group {name}: rc={rc}, want ok={want_ok}"
                                    f"{', missing ' + repr(missing) if missing else ''}: {out.strip()[-2000:]}")

            impl = ({"pkg_w3.py": "W3 = 1\n"}, "w3 impl (#7)")
            # W3's implementation alone: its own Accept runs on the combined ref
            alone = queue(base0, [impl])
            case("own-wp-passes", alone, {7: ["laned:W3"]}, True,
                 ("GROUP-OWN W3", "GROUP W3 accept PASS (#7)", "PASS W3"))
            # #6 queued ahead changes pkg_lib (W3 was green on base0 only): the
            # CROSS over the group excludes W3, so only its own run catches it
            broken = queue(base0, [({"pkg_lib.py": "LIB = 2\n"}, "lib bump (#6)"), impl])
            case("own-wp-broken-by-group", broken, {6: [], 7: ["laned:W3"]}, False,
                 ("GROUP #6: no laned:<WP> label", "GROUP W3 accept FAIL (#7)"))
            # a stale-base PR the queue rebased onto a main that broke it
            main1 = queue(base0, [({"pkg_lib.py": "LIB = 3\n"}, "lib on main (#5)")])
            stale = queue(main1, [impl])
            lanedlib.git(root, "checkout", "-q", "--detach", stale)
            with contextlib.redirect_stdout(io.StringIO()) as buf:
                rc = cmd_merge_group(root, main1, stale, {7: ["laned:W3"]})
            if rc == 0 or "GROUP W3 accept FAIL (#7)" not in buf.getvalue():
                failures.append(f"merge-group stale-base-broken: rc={rc}: {buf.getvalue().strip()[-2000:]}")
            # fail closed: labels unknown, no PR number, check-pr refusal
            case("labels-missing", alone, {}, False, ("GROUP FAIL: no labels for #7",))
            nopr = queue(base0, [({"pkg_w3.py": "W3 = 1\n"}, "direct push")])
            case("no-pr-number", nopr, {}, False, ("names no PR",))
            outside = queue(base0, [({"pkg_w3.py": "W3 = 1\n", "README.md": "y\n"}, "w3 + readme (#8)")])
            case("check-pr-refused", outside, {8: ["laned:W3"]}, False, ("GROUP W3 check-pr FAIL (#8)",))
            # tests-only PR for unbuilt W4: --verification -> --expect-fail on the combined ref
            tests_w4 = queue(base0, [({"tests/accept/w4/test_w4.py": "import pkg_w4\n\n\ndef test_w4():\n"
                                                                     "    assert pkg_w4.W4 == 1\n"}, "w4 tests (#9)")])
            case("tests-only", tests_w4, {9: ["laned:W4"]}, True,
                 ("GROUP W4 tests-only PASS (#9)", "LEDGER-MODE expect-fail"))
            # one WP on two queued PRs runs its full Accept once
            twice = queue(base0, [({"pkg_w3.py": "W3 = 5\n"}, "w3 a (#10)"), impl])
            case("dedupe", twice, {10: ["laned:W3"], 7: ["laned:W3"]}, True,
                 ("GROUP W3 accept already run on this ref (#7)",))
    finally:
        for k, v in saved.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v
    return failures


def _batch_test(n: int, wrong: bool = False) -> str:
    """tests/accept/b<n>/test_b<n>.py: a right-reason failure (missing module
    in its PATHS), or a wrong-reason one (missing module outside PATHS)."""
    mod = "laned_no_such_dep" if wrong else f"pkg_b{n}"
    return f"import {mod}\n\n\ndef test_b{n}():\n    assert {mod}.VALUE == {n}\n"


def selftest_batch(ident: tuple[str, ...]) -> list[str]:
    """The BATCH rule of --check-pr and the per-WP --verification runs the PR
    job makes for it, on a real git repo and real pytest. B1..B3 are new WPs
    (PATHS pkg_b<n>.py, not built); K is built on BASE (L2 commit)."""
    failures: list[str] = []
    saved = os.environ.get("LANED_PYTEST_CMD")
    os.environ["LANED_PYTEST_CMD"] = shlex.join([sys.executable, "-m", "pytest", "-p", "no:cacheprovider"])
    try:
        with tempfile.TemporaryDirectory(prefix="laned-accept-selftest-batch-") as tmp:
            root = Path(tmp) / "repo"
            root.mkdir()

            def commit(files: dict[str, str], msg: str) -> str:
                for rel, text in files.items():
                    (root / rel).parent.mkdir(parents=True, exist_ok=True)
                    (root / rel).write_text(text)
                lanedlib.git(root, "add", "-A")
                lanedlib.git(root, *ident, "commit", "-q", "-m", msg)
                return lanedlib.git(root, "rev-parse", "HEAD").stdout.strip()

            lanedlib.git(root, "init", "-q")
            commit({"README.md": "x\n", ".gitignore": "__pycache__/\n", "pkg_k.py": "VALUE = 0\n"}, "seed")
            commit({"tests/accept/k/PATHS": "pkg_k.py\n",
                    "tests/accept/k/test_k.py": "import pkg_k\n\n\ndef test_k():\n    assert pkg_k.VALUE == 1\n"},
                   "tests-only K")
            base = commit({"pkg_k.py": "VALUE = 1\n"}, "impl K")

            def b_files(*ns: int, wrong: int = 0) -> dict[str, str]:
                out: dict[str, str] = {}
                for n in ns:
                    out[f"tests/accept/b{n}/PATHS"] = f"pkg_b{n}.py\n"
                    out[f"tests/accept/b{n}/test_b{n}.py"] = _batch_test(n, wrong=n == wrong)
                return out

            def case(name: str, files: dict[str, str], labels: list[str],
                     want: str | dict[str, bool]) -> None:
                """``want``: a batch-<reason> refusal every label's check-pr
                must print, or {WP: verification run passes} per label."""
                lanedlib.git(root, "checkout", "-q", "-B", name, base)
                head = commit(files, name)
                for wp in labels:
                    with contextlib.redirect_stdout(io.StringIO()) as buf:
                        rc = cmd_check_pr(root, wp, base, head, labels)
                    out = buf.getvalue()
                    if isinstance(want, str):
                        if REVIEW_WP.match(wp):  # its own check-pr is the review rule: any refusal
                            if rc == 0:
                                failures.append(f"batch {name}: {wp} check-pr passed: {out.strip()}")
                            continue
                        if rc == 0 or f"FAIL rule1: {want}" not in out:
                            failures.append(f"batch {name}: {wp} check-pr rc={rc}, want FAIL rule1: {want}: "
                                            f"{out.strip()}")
                        continue
                    if rc != 0 or "MODE tests-only\n" not in out or f"BATCH {' '.join(labels)}\n" not in out:
                        failures.append(f"batch {name}: {wp} check-pr rc={rc}, want MODE tests-only: {out.strip()}")
                        continue
                    with contextlib.redirect_stdout(io.StringIO()) as buf, \
                            contextlib.redirect_stderr(io.StringIO()):
                        rc = cmd_verification(root, wp, base, head)
                    out = buf.getvalue()
                    tree = lanedlib.wp_tree_at(root, head, wp)
                    ok = rc == 0 and "LEDGER-MODE expect-fail\n" in out
                    if ok != want[wp] or f"TESTS-TREE {tree}\n" not in out:
                        failures.append(f"batch {name}: {wp} verification {'passed' if ok else 'failed'}, "
                                        f"want {'pass' if want[wp] else 'fail'} with TESTS-TREE {tree}: "
                                        f"{out.strip()[-1500:]}")

            three = ["B1", "B2", "B3"]
            # a 3-WP batch: every WP's own expect-fail run passes, each with its own tests tree
            case("three", b_files(1, 2, 3), three, {"B1": True, "B2": True, "B3": True})
            # one WP's wrong-reason failure: that WP's run fails (the PR job fails), the others pass
            case("one-wrong-reason", b_files(1, 2, 3, wrong=2), three, {"B1": True, "B2": False, "B3": True})
            # rev6.17: a batch mixing a WP built on BASE (K, L2) with new ones
            # passes; each label gets its own MODE
            lanedlib.git(root, "checkout", "-q", "-B", "built-wp", base)
            head = commit({**b_files(1, 2), "tests/accept/k/test_k_more.py": SELFTEST_PASSING}, "built-wp")
            for wp, mode in (("B1", "tests-only"), ("B2", "tests-only"), ("K", "tests-correction")):
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_check_pr(root, wp, base, head, ["B1", "B2", "K"])
                out = buf.getvalue()
                if rc != 0 or f"MODE {mode}\n" not in out or "WPMODE K tests-correction\n" not in out:
                    failures.append(f"batch built-wp: {wp} rc={rc}, want MODE {mode}: {out.strip()}")
            # a tests dir without its label -> refused
            case("unlabelled", b_files(1, 2, 3), ["B1", "B2"], "batch-unlabelled-tests")
            # a label without its tests dir -> refused
            case("label-without-tests", b_files(1, 2), three, "batch-label-without-tests")
            # a review label in a tests batch -> refused
            case("review-label", b_files(1, 2), ["B1", "B2", "RV9"], "batch-non-wp-label")
            # a tests/accept/ file outside every WP dir -> refused
            case("stray", {**b_files(1, 2), "tests/accept/conftest.py": "\n"}, ["B1", "B2"],
                 "batch-stray-tests")
            # code + tests in one batch diff: rev6.17 FEATURE rule (MODE combined)
            lanedlib.git(root, "checkout", "-q", "-B", "code-plus-tests", base)
            head = commit({**b_files(1, 2), "pkg_b1.py": "VALUE = 1\n"}, "code-plus-tests")
            with contextlib.redirect_stdout(io.StringIO()) as buf:
                rc = cmd_check_pr(root, "B1", base, head, ["B1", "B2"])
            if rc != 0 or "MODE combined\n" not in buf.getvalue():
                failures.append(f"batch code-plus-tests: rc={rc}: {buf.getvalue().strip()}")
            # one label, another WP's tests too: the single-WP rule is unchanged
            lanedlib.git(root, "checkout", "-q", "-B", "single-foreign", base)
            head = commit(b_files(1, 2), "single-foreign")
            for labels in (None, ["B1"]):
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    rc = cmd_check_pr(root, "B1", base, head, labels)
                if rc == 0 or "touches another WP's tests" not in buf.getvalue():
                    failures.append(f"batch single-foreign {labels}: rc={rc}: {buf.getvalue().strip()}")
    finally:
        if saved is None:
            os.environ.pop("LANED_PYTEST_CMD", None)
        else:
            os.environ["LANED_PYTEST_CMD"] = saved
    return failures


SELFTEST_BATCH_IMPL_PLAN = """# selftest plan

